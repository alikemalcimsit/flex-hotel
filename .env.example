# Uzak PostgreSQL sunucusu (README'deki kurulum adımlarına bak)
# connection_limit: dolu bir otelde eşzamanlı istek çok olur; havuz varsayılanı
# (CPU çekirdeği x 2 + 1) yetmezse burayı artırın.
DATABASE_URL=postgresql://KULLANICI:SIFRE@SUNUCU_IP:5432/hotelos?connection_limit=20

# Aktif otel kodu. GEÇİCİ: gerçek otel bağlamı modül 2'de JWT'den,
# çoklu otel ise modül 63'te üst bardaki seçiciden gelecek.
HOTEL_CODE=DEMO

# JWT anahtarları (rastgele uzun metin)
JWT_SECRET=degistir-bunu-uzun-rastgele-metin
JWT_REFRESH_SECRET=degistir-bunu-da-uzun-rastgele-metin

# Backend portu
PORT=3000

# Frontend'in backend'e ulaşacağı adres
VITE_API_URL=http://localhost:3000
