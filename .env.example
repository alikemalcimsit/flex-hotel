# Uzak PostgreSQL sunucusu (README'deki kurulum adımlarına bak)
# connection_limit: dolu bir otelde eşzamanlı istek çok olur; havuz varsayılanı
# (CPU çekirdeği x 2 + 1) yetmezse burayı artırın.
DATABASE_URL=postgresql://KULLANICI:SIFRE@SUNUCU_IP:5432/hotelos?connection_limit=20

# Aktif otel kodu. GEÇİCİ: gerçek otel bağlamı modül 2'de JWT'den,
# çoklu otel ise modül 63'te üst bardaki seçiciden gelecek.
HOTEL_CODE=DEMO

# Ortam. Sunucuda mutlaka "production": bu durumda JWT_SECRET yoksa, 32
# karakterden kısaysa ya da aşağıdaki örnek değer bırakılmışsa backend AÇILMAZ.
NODE_ENV=development

# JWT anahtarları (en az 32 karakter, rastgele). Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=degistir-bunu-uzun-rastgele-metin
JWT_REFRESH_SECRET=degistir-bunu-da-uzun-rastgele-metin

# Backend portu ve dinlenecek adres. Varsayılan 127.0.0.1: API yalnızca aynı
# makinedeki ters vekil (nginx) üzerinden dışarı açılır. Doğrudan dışarıya
# açmak gerekiyorsa (önerilmez) 0.0.0.0 yazın.
PORT=3000
HOST=127.0.0.1

# Tarayıcıdan API'ye istek atabilecek adresler (virgülle). Panel ile API aynı
# alan adındaysa (ör. hotel.flexai.tr ve hotel.flexai.tr/api) boş bırakın.
# Geliştirmede boşsa http://localhost:5173 kendiliğinden izinlidir.
CORS_ORIGINS=

# Ters vekile (nginx) güvenilecek adresler. Varsayılan "loopback": aynı
# makinedeki nginx'in X-Forwarded-For başlığı okunur, istemcinin gerçek IP'si
# hız sınırında kullanılır. nginx'te şu satır olmalı:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# Vekil başka makinedeyse adresini/ağını yazın (ör. 10.0.0.0/8); vekil yoksa false.
TRUST_PROXY=loopback

# Dakikada IP + personel başına en fazla istek.
RATE_LIMIT_MAX=600

# Kayıtlı parolaları (SMTP, SMS API) şifreleyen anahtar: 32 bayt, base64.
# Yoksa bildirim kanallarına parola kaydedilemez. Bir kez üretin ve saklayın;
# değişirse kayıtlı parolalar okunamaz, panelden yeniden girilmesi gerekir.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_SECRET_KEY=

# AI asistanı (modül 8): WhatsApp / web chat'te misafirle konuşup rezervasyon
# alan ajanların model anahtarı. Boşsa ajanlar hiç başlamaz; konuşmalar
# personelde açılır. Anahtar panele girilmez — yalnızca burada durur. Model,
# fiyat ve günlük bütçe panelden (Ayarlar → AI asistanı) girilir.
# Eklendikten / değiştikten sonra sunucu yeniden başlatılır.
OPENAI_API_KEY=
# İsteğe bağlı: model çağrısının zaman aşımı (ms, varsayılan 30000) ve
# OpenAI uyumlu başka bir uç (vekil / Azure uyumlu ağ geçidi).
OPENAI_TIMEOUT_MS=
OPENAI_BASE_URL=

# Yüklenen dosyaların (kayıp eşya fotoğrafları, modül 21) klasörü. Sunucuda
# uygulama klasörünün DIŞINDA bir yol verin (ör. /home/public_html/storage) ve
# yedeğe ekleyin; klasör uygulamanın kullanıcısına yazılabilir olmalı. Boşsa
# hotel/backend/storage (git'e girmez). Dosyalar statik sunulmaz; yalnızca
# yetkili personel API üzerinden okur.
FILE_STORAGE_DIR=

# Gelir raporları ve raporlama MCP sunucusu (modül 23) için ayrı veritabanı
# adresi (isteğe bağlı). Yalnızca SELECT yetkili bir kullanıcı önerilir; boşsa
# DATABASE_URL kullanılır. Her iki durumda da rapor sorguları salt okunur
# işlemde ve süre sınırıyla çalışır.
#   CREATE ROLE hotelos_rapor LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE hotelos TO hotelos_rapor;
#   GRANT USAGE ON SCHEMA public TO hotelos_rapor;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO hotelos_rapor;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO hotelos_rapor;
REPORTING_DATABASE_URL=

# WhatsApp webhook'u (modül 8) Meta'dan internete açık adrese gelir:
# https://<alan-adı>/webhooks/whatsapp/<kanal-kimliği>. nginx bu yolu
# backend'e geçirmeli; web chat balonu /webchat/widget.js ve /socket.io/ ister.

# Frontend'in backend'e ulaşacağı adres
VITE_API_URL=http://localhost:3000
