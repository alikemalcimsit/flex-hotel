{
  "name": "hotelos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared/*",
    "shared/*/*",
    "hotel/*",
    "hotel/*/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @hotelos/hotel-backend",
    "dev:frontend": "npm run dev -w @hotelos/hotel-frontend",
    "build": "npm run build -w @hotelos/hotel-frontend",
    "db:generate": "npm run db:generate -w @hotelos/hotel-backend",
    "db:migrate": "npm run db:migrate -w @hotelos/hotel-backend",
    "db:seed": "npm run db:seed -w @hotelos/hotel-backend",
    "db:studio": "npm run db:studio -w @hotelos/hotel-backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
