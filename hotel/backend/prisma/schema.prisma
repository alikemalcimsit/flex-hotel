generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── ENUM'LAR ─────────────

enum UserRole {
  ADMIN
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  ACCOUNTING
  FNB
}

/// Doluluk — yalnızca giriş/çıkış akışı değiştirir, elle atanmaz.
enum RoomOccupancy {
  VACANT
  OCCUPIED
}

/// Kat hizmeti durumu — dolulukten bağımsız (dolu oda da kirli olabilir).
enum HousekeepingStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
}

/// Tarihli arıza kaydının etkisi.
/// OUT_OF_ORDER: envanterden düşer (satılamaz). OUT_OF_SERVICE: satışta kalır ama atanmaz.
enum RoomBlockType {
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  // KULLANILMIYOR (eski). Bekleme listesinin ilk tasarımında talep rezervasyon
  // satırı olarak tutuluyordu; bekleme listesi artık ayrı tablo (WaitlistEntry).
  // PostgreSQL enum değeri silinemediği için burada duruyor; eski satırlar
  // 20260923090000_waitlisted_to_entries migration'ında taşındı. Yeni kod yazmaz.
  WAITLISTED
}

enum ReservationSource {
  UI
  WEBCHAT
  WHATSAPP
  EMAIL
  WIDGET
  OTA
  AGENCY
  PHONE
}

enum BoardType {
  RO
  BB
  HB
  FB
  AI
  UAI
}

enum FolioStatus {
  OPEN
  CLOSED
  TRANSFERRED
}

enum FolioItemType {
  ROOM
  FNB
  MINIBAR
  LAUNDRY
  SPA
  TAX
  DISCOUNT
  OTHER
}

/// Folyo kaleminin kaynağı (modül 15). Tekrar işlemeye karşı `FolioItem.sourceKey` ile birlikte.
enum FolioItemSource {
  MANUAL
  ROOM_NIGHT
  EARLY_CHECK_IN
  LATE_CHECK_OUT
  CANCELLATION
  NO_SHOW
  FNB_ORDER
  MINIBAR
  LAUNDRY
  REVERSAL
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  VIRTUAL_POS
  AGENCY
  VOUCHER
}

/// Ödeme satırının türü (modül 17): tahsilat (artı), iade (eksi), iptal kaydı (asıl satırın tersi).
enum PaymentKind {
  PAYMENT
  REFUND
  REVERSAL
}

/// Onay bekleyen satır bakiyeye girmez; reddedilen ya da süresi dolan hiç işlenmez.
enum PaymentStatus {
  PENDING
  POSTED
  DECLINED
}

/// Ödeme nereden geldi: resepsiyon, gelmeden önce ön ödeme, girişte alınan teminat.
enum PaymentSource {
  DESK
  ADVANCE
  CHECK_IN_DEPOSIT
}

enum HousekeepingType {
  CHECKOUT_CLEAN
  STAYOVER
  DEEP_CLEAN
  INSPECTION
  /// Misafir isteğinden doğan görev (havlu, yastık — modül 7 → 14).
  GUEST_REQUEST
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  GRANTED
  DENIED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  WEBCHAT
  PUSH
}

/// Misafir bildiriminin yolculuğu (modül 9). Bkz. contracts `NOTIFICATION_STATUSES`.
enum NotificationStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

/// Bildirimin kaynağı: şablonlu olaylar ve kanal testi.
enum NotificationSource {
  RESERVATION_CONFIRMED
  ROOM_ASSIGNED
  CHECKED_IN
  CHECKED_OUT
  CHANNEL_TEST
  CHECKIN_INVITE
}

/// Şablonu olan olaylar.
enum NotificationTrigger {
  RESERVATION_CONFIRMED
  ROOM_ASSIGNED
  CHECKED_IN
  CHECKED_OUT
  CHECKIN_INVITE
}

/// Personel uyarısı türleri (üst bardaki zil).
enum StaffAlertKind {
  GUEST_MESSAGE
  URGENT_REQUEST
  OVERDUE_REQUEST
  MANUAL_TASK
  NOTIFICATION_FAILED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  WAITLIST_AVAILABLE
  /// Bakiyesi kapanmadan çıkış yapıldı (modül 6): tahsilatı takip edecek yönetime.
  CHECKOUT_OPEN_BALANCE
  /// Folyoda personelin bakması gereken durum (modül 15): çıkıştan sonra bakiye
  /// kaldı, onaylanan iptal uygulanamadı.
  FOLIO_ATTENTION
  /// AI konuşmayı personele devretti (şikâyet, misafir personel istedi, ajan hatası) — modül 8.
  AI_HANDOFF
  /// Günlük AI bütçesi doldu; yeni konuşmalar personele düşüyor — modül 8.
  AI_BUDGET
  /// Kanal rezervasyonu dikkat istiyor: kapasite aşıldı ya da elle işlenmeli — modül 33.
  CHANNEL_BOOKING
  /// Kanala gönderim art arda başarısız (anahtar, bağlantı) — modül 33.
  CHANNEL_SYNC
  /// Acente prim kademesine ulaştı, dönem sonu hak edişi hesaplandı ya da kararı çıktı — modül 35.
  AGENCY_BONUS
  /// Etkinlik: opsiyon düştü / 1. opsiyon oldu, depozito gecikti, gerçekleşti olarak kapatılmalı — modül 37.
  BANQUET
  /// Restoran POS: kasa farkı, uzun açık kalan vardiya / adisyon, odaya yazılamayan adisyon — modül 39.
  POS
  /// Fatura / e-belge: gönderilemedi, GİB reddetti — modül 16 / 49.
  INVOICE
  /// Online check-in incelemesi bekliyor (modül 53): resepsiyona.
  ONLINE_CHECKIN
  /// Yeni / acil arıza bileti teknik servise (modül 20).
  MAINTENANCE
}

/// Rezervasyon fiyatının kaynağı (modül 4): sistem hesabı ya da yetkili
/// personelin elle girdiği toplam (gerekçesiyle).
enum ReservationPriceMode {
  CALCULATED
  MANUAL
}

/// Kapasite aşımında (overbooking) ne yapılacağı (modül 4, otel ayarı).
enum OverbookingPolicy {
  REJECT
  APPROVAL
}

/// Bekleme listesi kaydının yolculuğu (modül 4).
/// Erken giriş / geç çıkış ücretinin hesaplanışı (modül 6).
/// FIXED: sabit tutar. PERCENT_OF_NIGHT: ilgili gecenin fiyatının yüzdesi.
enum StayFeeMode {
  NONE
  FIXED
  PERCENT_OF_NIGHT
}

/// Girişte kimliği zorunlu olanlar: yalnız rezervasyon sahibi ya da bütün yetişkinler.
enum IdentityPolicy {
  PRIMARY_GUEST
  ALL_ADULTS
}

/// Misafirin kimlik belgesi (Kimlik Bildirim Sistemi'ne giden bilgi).
enum IdDocumentType {
  NATIONAL_ID
  PASSPORT
  OTHER
}

/// Girişte alınan teminat. Tahsilat değil: nakit teminatın kasaya girişi ve
/// kart provizyonunun kapanışı ödeme modülünde (17).
enum DepositMethod {
  NONE
  CASH
  CARD_PREAUTH
  TRANSFER
}

/// Minibar ürün kategorisi (modül 19).
enum MinibarCategory {
  DRINK
  ALCOHOL
  SNACK
  OTHER
}

/// Minibar tüketimi kime yazıldı: odadaki misafir, odadan yakın zamanda ayrılan
/// misafir (geç kalem) ya da kimse (kayıp, gerekçeli).
enum MinibarChargeTarget {
  IN_HOUSE
  LATE
  NONE
}

/// Çamaşırhane hizmeti.
enum LaundryService {
  WASH
  DRY_CLEAN
  PRESS
}

/// Çamaşır siparişinin durumu: alındı → yıkamada → hazır → teslim (ücret folyoya); ya da iptal.
enum LaundryStatus {
  RECEIVED
  IN_PROCESS
  READY
  DELIVERED
  CANCELLED
}

/// Kayıp eşya (modül 21).
enum LostItemCategory {
  ELECTRONICS
  JEWELRY
  DOCUMENTS
  CLOTHING
  ACCESSORY
  TOY
  OTHER
}

/// Bütçe sürümü (modül 27): taslak düzenlenir; onaylı kilitlidir; revize onaylanınca eskisi saklanır.
/// Acente durumu (modül 29): pasif acentede yeni rezervasyon açılmaz; açılmışlar etkilenmez.
enum AgencyStatus {
  ACTIVE
  PASSIVE
}

/// Kontrat durumu (modül 29): taslak (satışa kapalı) → satışta → sonlandırıldı.
enum ContractStatus {
  DRAFT
  ACTIVE
  ENDED
}

/// Promosyon durumu (modül 31): taslak (uygulanmaz) → yayında ⇄ durduruldu.
enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// İndirim tipi (modül 31): gece yüzdesi, konaklama başına tutar, "X gece kal Y gece öde".
enum PromotionDiscountType {
  PERCENT
  AMOUNT
  FREE_NIGHTS
}

/// Banket / etkinlik (modül 37): salonun oturma düzeni (kapasite düzene göre).
enum VenueLayout {
  THEATER
  CLASSROOM
  U_SHAPE
  BOARDROOM
  BANQUET
  CABARET
  COCKTAIL
}

enum VenueStatus {
  ACTIVE
  PASSIVE
}

enum EventClientType {
  COMPANY
  PERSON
}

enum EventType {
  WEDDING
  ENGAGEMENT
  MEETING
  CONFERENCE
  GALA
  BIRTHDAY
  COCKTAIL
  OTHER
}

/// Talep → opsiyonlu → kesin → gerçekleşti; kesin iptal edilebilir, talep / opsiyon kaybedilebilir.
enum EventStatus {
  INQUIRY
  TENTATIVE
  DEFINITE
  COMPLETED
  CANCELLED
  LOST
}

/// Salon tutma: opsiyon (sıralı, çakışabilir) ya da kesin (çakışamaz — EXCLUDE).
enum EventHoldStatus {
  TENTATIVE
  DEFINITE
}

enum EventItemCategory {
  VENUE
  FNB
  BEVERAGE
  EQUIPMENT
  SERVICE
  OTHER
}

enum EventItemUnit {
  PERSON
  PIECE
  HOUR
  DAY
  PACKAGE
}

/// Mutfak birimi (modül 43): kütle (kg / g), hacim (L / ml), adet, porsiyon (yalnız yemek reçetesinin verimi).
enum KitchenUnit {
  KG
  G
  L
  ML
  PIECE
  PORTION
}

/// Malzeme grubu: satın alma listesi bu gruplarla bölünür (kasap, manav, kuru gıda…).
enum StockItemGroup {
  MEAT
  POULTRY
  SEAFOOD
  DAIRY
  PRODUCE
  DRY_GOODS
  PANTRY
  BAKERY
  BEVERAGE
  FROZEN
  OTHER
}

/// Reçete: yemek (porsiyon verir) ya da ara ürün (sos, fond, hamur — kg / L / adet).
enum RecipeKind {
  DISH
  PREP
}

/// Menü kursu: hepsi servis edilir (meze, büfe) ya da misafir birini seçer (et / balık / vejetaryen).
enum MenuCourseMode {
  ALL
  CHOICE
}

/// Satın alma talebi (modül 43'te kuruldu; onay / sipariş durumlarını 45 ekler).
enum PurchaseRequestStatus {
  OPEN
  IN_PROGRESS
  ORDERED
  CANCELLED
}

/// Talebin kaynağı (elle talep ve stoktan öneriyi 45 ekler).
enum PurchaseRequestSource {
  BANQUET
  MANUAL
  STOCK
}

/// Teklif turu: teklif toplanıyor → bütün satırlar siparişe döndü; iptal.
enum PurchaseRoundStatus {
  OPEN
  AWARDED
  CANCELLED
}

/// Satın alma siparişi durumu.
enum PurchaseOrderStatus {
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  REJECTED
  CANCELLED
}

/// Stok hareketi türü (44 çıkış, transfer, fire, sayım ekler).
enum StockMovementKind {
  RECEIPT
}

enum EventDocumentKind {
  OFFER
  CONTRACT
  PROFORMA
}

enum EventDocumentStatus {
  ISSUED
  ACCEPTED
  DECLINED
  SIGNED
  SUPERSEDED
}

/// Acente prim kuralının ölçütü (modül 35): hedefin ve kademe eşiklerinin birimi.
enum AgencyBonusMetric {
  NIGHTS
  REVENUE
}

/// Ulaşılan kademenin oranı neye uygulanır: dönemin bütün cirosuna ya da yalnızca kademe dilimine.
enum AgencyBonusMode {
  WHOLE
  EXCESS
}

enum AgencyBonusRuleStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

/// Hak ediş: hesaplandı → onay bekliyor → onaylandı → ödendi (ret / süre dolumu "hesaplandı"ya döner).
enum AgencyBonusStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum BudgetStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

/// AI sapma yorumunun durumu (modül 27).
enum BudgetCommentaryStatus {
  PENDING
  READY
  FAILED
}

enum LostItemStatus {
  STORED
  MATCHED
  RETURNED
  DISPOSED
}

enum LostItemReturnMethod {
  IN_PERSON
  SHIPPED
}

enum LostItemShippingPayer {
  GUEST
  HOTEL
}

enum LostItemDisposal {
  DONATED
  DESTROYED
  POLICE
  RECORD_ERROR
}

enum LostItemContactChannel {
  PHONE
  WHATSAPP
  SMS
  EMAIL
  IN_PERSON
  NOTE
}

enum WaitlistStatus {
  WAITING
  AVAILABLE
  CONVERTED
  CANCELLED
  EXPIRED
}

enum StaffAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MessageDirection {
  IN
  OUT
}

/// Konuşmanın iş durumu: açık (ilgilenilecek) ya da kapalı (çözüldü).
enum ConversationStatus {
  OPEN
  CLOSED
}

/// Konuşmaya kim cevap veriyor: AI asistanı (modül 8) ya da personel.
/// "Manuele al" = MANUAL; asistan bu konuşmaya karışmaz.
enum ConversationMode {
  AI
  MANUAL
}

/// Mesajı kim yazdı. AI cevapları ekranda ayrıca etiketlenir.
enum MessageAuthor {
  GUEST
  STAFF
  AI
  SYSTEM
}

/// Mesajın kanaldaki yolculuğu. Gelen mesaj RECEIVED doğar; giden mesaj
/// PENDING doğar ve kanal (modül 8) gönderince SENT/DELIVERED/READ ya da FAILED olur.
enum MessageDelivery {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Misafir isteğinin türü — kimin işi olduğunu ve varsayılan önceliği belirler.
enum GuestRequestCategory {
  HOUSEKEEPING
  AMENITY
  MAINTENANCE
  ROOM_SERVICE
  WAKE_UP
  TRANSPORT
  INFORMATION
  COMPLAINT
  OTHER
}

enum GuestRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GuestRequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// İsteğin nereden geldiği (rapor ve SLA analizi için).
enum GuestRequestSource {
  CONVERSATION
  PHONE
  FRONT_DESK
  STAFF
  AI
  PORTAL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ───────────── SİSTEM ─────────────

model Hotel {
  id                            String            @id @default(uuid())
  name                          String
  code                          String            @unique
  timezone                      String            @default("Europe/Istanbul")
  currency                      String            @default("TRY")
  /// Ülke kodu yazılmamış telefonların yorumlandığı kod (Türkiye: 90). Misafiri
  /// WhatsApp numarasından bulurken kullanılır (modül 7).
  phoneCountryCode              String            @default("90")
  address                       String?
  phone                         String?
  email                         String?
  logoUrl                       String?
  checkInTime                   String            @default("14:00")
  checkOutTime                  String            @default("12:00")
  defaultBoardType              BoardType         @default(BB)
  cancellationPolicyDays        Int               @default(0)
  cancellationPolicyPenaltyPct  Decimal           @default(0) @db.Decimal(5, 2)
  /// Kapasite aşımında rezervasyon reddedilir ya da yönetici onayına gider.
  overbookingPolicy             OverbookingPolicy @default(REJECT)
  /// Rol matrisi (modül 2) kaydedildiğinde katalogda olan izinler. Sonradan
  /// kataloğa eklenen izin burada yoktur: o izinde rollerin koddaki varsayılanı
  /// geçerli olur (yeni modülün izni, matrisi kaydetmiş otelde kimseye kapalı kalmasın).
  permissionCatalog             String[]          @default([])
  /// Erken giriş (giriş saatinden önce) ve geç çıkış (çıkış saatinden sonra)
  /// ücreti. Değer: FIXED ise tutar, PERCENT_OF_NIGHT ise yüzde (modül 6).
  earlyCheckInFeeMode           StayFeeMode       @default(NONE)
  earlyCheckInFeeValue          Decimal           @default(0) @db.Decimal(12, 2)
  lateCheckOutFeeMode           StayFeeMode       @default(NONE)
  lateCheckOutFeeValue          Decimal           @default(0) @db.Decimal(12, 2)
  checkInIdentityPolicy         IdentityPolicy    @default(PRIMARY_GUEST)
  /// Bu tutar (otel para biriminde) ve üstü ödeme ikinci bir yetkilinin onayına
  /// gider; onaylanana kadar bakiyeye girmez (modül 17). 0: onay yok.
  largePaymentThreshold         Decimal           @default(0) @db.Decimal(12, 2)
  /// Ekspres çamaşır farkı (yüzde, modül 19): ekspres siparişte parçaların toplamına eklenir.
  laundryExpressPct             Decimal           @default(50) @db.Decimal(5, 2)
  /// Sahibi çıkmayan eşyanın saklama süresi (gün, modül 21); değerli eşya ayrı.
  lostItemRetentionDays         Int               @default(90)
  lostItemValuableRetentionDays Int               @default(365)
  /// Tahminin kritik gün eşikleri (yüzde, modül 25): tahmini doluluk düşüğün
  /// altında ya da yüksekin üstündeyse gün işaretlenir.
  forecastLowOccupancyPct       Int               @default(30)
  forecastHighOccupancyPct      Int               @default(95)
  settings                      Json              @default("{}")
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  deletedAt                     DateTime?

  users                  User[]
  refreshTokens          RefreshToken[]
  rolePermissions        RolePermission[]
  aiSettings             AiSettings?
  messagingChannels      MessagingChannel[]
  conversationAiStates   ConversationAiState[]
  eventLogs              EventLog[]
  processedEvents        ProcessedEvent[]
  actorSettings          ActorSetting[]
  activityLogs           ActivityLog[]
  auditLogs              AuditLog[]
  approvals              Approval[]
  pendingActions         PendingAction[]
  manualTasks            ManualTask[]
  llmUsages              LlmUsage[]
  llmUsageDaily          LlmUsageDaily[]
  notifications          Notification[]
  notificationTemplates  NotificationTemplate[]
  notificationChannels   NotificationChannelConfig[]
  staffAlerts            StaffAlert[]
  roomTypes              RoomType[]
  rooms                  Room[]
  roomBlocks             RoomBlock[]
  roomStaySegments       RoomStaySegment[]
  guests                 Guest[]
  reservations           Reservation[]
  reservationGuests      ReservationGuest[]
  ratePlans              RatePlan[]
  seasons                Season[]
  taxes                  Tax[]
  conversations          Conversation[]
  messages               Message[]
  guestRequests          GuestRequest[]
  folios                 Folio[]
  folioItems             FolioItem[]
  folioRoutes            FolioRoute[]
  roomChargeRuns         RoomChargeRun[]
  invoices               Invoice[]
  invoiceSettings        InvoiceSettings?
  invoiceTaxCodes        InvoiceTaxCode[]
  departments            Department[]
  employees              Employee[]
  payrollSettings        PayrollSettings?
  guestPortalSettings    GuestPortalSettings?
  guestPortalLinks       GuestPortalLink[]
  onlineCheckins         OnlineCheckin[]
  onlineCheckinDocuments OnlineCheckinDocument[]
  payrollParameterSets   PayrollParameterSet[]
  payElements            PayElement[]
  payrollRuns            PayrollRun[]
  testTaxpayers          TestTaxpayer[]
  payments               Payment[]
  exchangeRates          ExchangeRate[]
  minibarItems           MinibarItem[]
  minibarConsumptions    MinibarConsumption[]
  laundryItems           LaundryItem[]
  laundryOrders          LaundryOrder[]
  nightAudits            NightAudit[]
  shiftReports           ShiftReport[]
  dailyStats             DailyStats[]
  housekeepingTasks      HousekeepingTask[]
  maintenanceTickets     MaintenanceTicket[]
  maintenancePhotos      MaintenancePhoto[]
  maintenancePlans       MaintenancePlan[]
  lostItems              LostItem[]
  lostItemPhotos         LostItemPhoto[]
  lostItemNotes          LostItemNote[]
  revenueDayStats        RevenueDayStat[]
  revenueStatDays        RevenueStatDay[]
  budgets                Budget[]
  budgetLines            BudgetLine[]
  budgetExpenseItems     BudgetExpenseItem[]
  budgetExpenseActuals   BudgetExpenseActual[]
  budgetCommentaries     BudgetCommentary[]
  reservationGroups      ReservationGroup[]
  reservationNights      ReservationNight[]
  waitlistEntries        WaitlistEntry[]
  agencies               Agency[]
  contracts              Contract[]
  contractRates          ContractRate[]
  contractStopSales      ContractStopSale[]
  promotions             Promotion[]
  coupons                Coupon[]
  channels               Channel[]
  agencyBonusRules       AgencyBonusRule[]
  agencyBonuses          AgencyBonus[]
  venues                 Venue[]
  eventEquipment         EventEquipment[]
  eventClients           EventClient[]
  eventSettings          EventSettings?
  events                 Event[]
  eventPayments          EventPayment[]
  eventDocuments         EventDocument[]
  posOutlets             PosOutlet[]
  menuCategories         MenuCategory[]
  menuItems              MenuItem[]
  posSettings            PosSettings?
  posShifts              PosShift[]
  roomServiceOrders      RoomServiceOrder[]
  roomServiceLinks       RoomServiceLink[]
  posChecks              PosCheck[]
  posPayments            PosPayment[]
  stockItems             StockItem[]
  recipes                Recipe[]
  banquetMenus           BanquetMenu[]
  purchaseRequests       PurchaseRequest[]
  suppliers              Supplier[]
  purchaseSettings       PurchaseSettings?
  purchaseRounds         PurchaseRound[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  warehouses             Warehouse[]
  accountingSettings     AccountingSettings?
  ledgerAccounts         LedgerAccount[]
  ledgerEntries          LedgerEntry[]
  treasuryAccounts       TreasuryAccount[]
  treasuryMovements      TreasuryMovement[]
  treasuryMappings       TreasuryMapping[]
  accountingVouchers     AccountingVoucher[]
  instruments            Instrument[]
}

model User {
  id           String    @id @default(uuid())
  hotelId      String
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(FRONT_DESK)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  hotel         Hotel          @relation(fields: [hotelId], references: [id])
  refreshTokens RefreshToken[]

  assignedConversations Conversation[]   @relation("ConversationAssignee")
  assignedRequests      GuestRequest[]   @relation("GuestRequestAssignee")
  staffAlerts           StaffAlert[]
  staffAlertReads       StaffAlertRead[]
  staffAlertState       StaffAlertState?

  assignedHousekeepingTasks  HousekeepingTask[] @relation("HousekeepingAssignee")
  completedHousekeepingTasks HousekeepingTask[] @relation("HousekeepingCompleter")
  inspectedHousekeepingTasks HousekeepingTask[] @relation("HousekeepingInspector")

  employee Employee?
}

model RefreshToken {
  id        String    @id @default(uuid())
  hotelId   String
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

/// Rol → izin matrisi (modül 2 — RBAC). Bir otelin hiç satırı yoksa çözüm koddaki
/// varsayılanlara düşer; matris kaydedilince tüm roller için satır yazılır ve DB
/// kaynak olur. ADMIN satır tutmaz — kod her zaman ADMIN'e tüm izinleri verir.
model RolePermission {
  id         String   @id @default(uuid())
  hotelId    String
  role       UserRole
  permission String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, role, permission])
  @@index([hotelId, role])
}

model EventLog {
  id            String    @id @default(uuid())
  hotelId       String
  name          String
  version       Int       @default(1)
  payload       Json
  correlationId String
  causationId   String?
  hop           Int       @default(0)
  actor         String
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])
  // Dağıtılmamış olaylar: kısmi index `EventLog_unpublished_idx` (migration'da).

  // Olay listesi (modül 10): otel + zaman, otel + ad + zaman.
  @@index([hotelId, occurredAt, id])
  @@index([hotelId, name, occurredAt, id])
  @@index([correlationId])
}

model ProcessedEvent {
  id        String    @id @default(uuid())
  hotelId   String
  actorName String
  eventId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([actorName, eventId])
  // Saklama süresi temizliği (bkz. lib/maintenance-jobs.js).
  @@index([createdAt])
}

/// Aktörün otel bazındaki ayarı (modül 12). Satır yoksa aktör açıktır.
model ActorSetting {
  id               String    @id @default(uuid())
  hotelId          String
  actorName        String
  enabled          Boolean   @default(true)
  config           Json      @default("{}")
  dailyTokenBudget Int?
  /// Son açan / kapatan (e-posta) ve gerekçesi — panelde "neden kapalı" sorusunun cevabı.
  updatedBy        String?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, actorName])
}

/// Kullanıcı denetim izi: hangi kaydı kim, ne zaman, neyi neye çevirerek değiştirdi.
/// ActivityLog aktör/event odaklıdır; bu tablo insan odaklıdır (modül 10'un
/// "kullanıcı audit listesi" ekranı bunu okuyacak).
model AuditLog {
  id            String    @id @default(uuid())
  hotelId       String
  entity        String
  entityId      String
  action        String
  actor         String
  before        Json?
  after         Json?
  changedFields String[]  @default([])
  correlationId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  // Kaydın geçmişi (rezervasyon geçmişi, kaydın zincirleri).
  @@index([hotelId, entity, entityId, createdAt, id])
  // Denetim listesi (modül 10): en yeni önce; kişiye ve kayıt türüne göre.
  @@index([hotelId, createdAt, id])
  @@index([hotelId, actor, createdAt, id])
  @@index([hotelId, entity, createdAt, id])
  @@index([correlationId])
}

model ActivityLog {
  id            String    @id @default(uuid())
  hotelId       String
  actorName     String
  eventId       String?
  /// İşlenen olayın adı ve zinciri (modül 10): akış süzgeci ve zincir görünümü
  /// JSON'dan değil sütundan okur (index'li).
  eventName     String?
  correlationId String?
  level         LogLevel  @default(INFO)
  message       String
  meta          Json      @default("{}")
  durationMs    Int?
  tokensIn      Int?
  tokensOut     Int?
  costUsd       Decimal?  @db.Decimal(12, 6)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  // Canlı akış ve süzgeçler (en yeni önce, imleçli).
  @@index([hotelId, createdAt, id])
  @@index([hotelId, actorName, createdAt, id])
  @@index([hotelId, eventName, createdAt, id])
  @@index([hotelId, level, createdAt, id])
  @@index([correlationId])
}

/// Onay kuyruğu (modül 11): personelin karar vermesi gereken iş.
/// `data` isteyenin verdiği serbest yapı (ekranda gösterilir, yorumlanmaz);
/// `amount`/`currency` listede "tutar" sütunu için ayrı tutulur.
model Approval {
  id          String         @id @default(uuid())
  hotelId     String
  type        String
  summary     String
  reason      String?
  data        Json           @default("{}")
  amount      Decimal?       @db.Decimal(12, 2)
  currency    String?
  status      ApprovalStatus @default(PENDING)
  /// İsteyen aktörün adı; kişi ya da servis istediyse boş.
  actorName   String?
  /// Aktör bildirgesindeki onay gerektiren iş adı (`requiresApproval`).
  action      String?
  requestedBy String
  decidedBy   String?
  decidedAt   DateTime?
  note        String?
  entityType  String?
  entityId    String?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  hotel              Hotel               @relation(fields: [hotelId], references: [id])
  pendingActions     PendingAction[]
  payments           Payment[]
  agencyBonuses      AgencyBonus[]
  eventPayments      EventPayment[]
  posPayments        PosPayment[]
  posAdjustments     PosAdjustment[]
  accountingVouchers AccountingVoucher[]

  // Bekleyenler (eskiden yeniye) ve geçmiş (yeni karar önce), imleçli.
  @@index([hotelId, status, createdAt, id])
  @@index([hotelId, status, decidedAt, id])
  // Süre dolumu taraması: kısmi index `Approval_pending_expiry_idx` (migration'da).
  // Özet araması (trigram).
  @@index([summary(ops: raw("gin_trgm_ops"))], map: "Approval_summary_trgm_idx", type: Gin)
  // İsteyenin kendi kaydından onaya ulaşması (ör. aynı rezervasyon isteği ikinci kez gelince).
  @@index([hotelId, entityType, entityId])
}

/// Onay verilince kaldığı yerden devam edecek aktör işi: olayın zarfı
/// olduğu gibi saklanır. Aynı olay için ikinci istek açılmaz (`actorName`,
/// `eventId` tekil); devam bir kez yapılır (`resumedAt`).
model PendingAction {
  id          String    @id @default(uuid())
  hotelId     String
  actorName   String
  approvalId  String
  eventId     String
  resumeEvent Json
  resumedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  approval Approval @relation(fields: [approvalId], references: [id])

  @@unique([actorName, eventId])
  @@index([approvalId])
}

/// Aktörün yapamadığı iş (modül 3, 12): aktör kapalıydı, hata verdi ya da
/// iş sırası doluydu. İşin modülüne yetkili personel üstlenir, tamamlar ya da
/// "gerek kalmadı" der.
model ManualTask {
  id            String     @id @default(uuid())
  hotelId       String
  module        String
  title         String
  description   String?
  status        TaskStatus @default(PENDING)
  originalEvent Json?
  /// İşi düşüren aktör ve olayın zinciri (Activity Feed'e bağlantı).
  actorName     String?
  correlationId String?
  /// Üstlenen personelin kimliği (User.id) ve ne zaman üstlendiği.
  assignedTo    String?
  assignedAt    DateTime?
  completedAt   DateTime?
  /// Görev kapandı mı (tamamlandı ya da gerek kalmadı): açık görevler `closedAt IS NULL`.
  closedAt      DateTime?
  /// Kapatan (e-posta) ve notu / gerekçesi.
  resolvedBy    String?
  resolution    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  // Açık görevler en eski önce, kapananlar en yeni kapanan önce (imleçli).
  @@index([hotelId, closedAt, createdAt, id])
  @@index([hotelId, module, closedAt, createdAt, id])
  @@index([hotelId, actorName, closedAt, createdAt, id])
}

model LlmUsage {
  id             String    @id @default(uuid())
  hotelId        String
  actorName      String
  /// Çağrının ait olduğu konuşma (modül 8); konuşma başına maliyet için.
  conversationId String?
  model          String
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  cacheRead      Int       @default(0)
  costUsd        Decimal   @default(0) @db.Decimal(12, 6)
  date           DateTime  @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([actorName, date])
  // Gün bazlı döküm ve saklama süresi temizliği.
  @@index([hotelId, date])
}

/// LLM kullanımının günlük özeti (modül 12): otel × iş günü × ajan × model.
///
/// Her model çağrısı `LlmUsage`'a bir satır yazar; büyük otelde günde on
/// binlerce satır demek. Bütçe denetimi ve kullanım ekranları o satırları
/// toplamak yerine buradan okur: çağrı kaydedilirken aynı transaction'da
/// sayaçlar artırılır (`ON CONFLICT DO UPDATE`).
model LlmUsageDaily {
  hotelId   String
  date      DateTime @db.Date
  actorName String
  model     String
  calls     Int      @default(0)
  tokensIn  BigInt   @default(0)
  tokensOut BigInt   @default(0)
  cacheRead BigInt   @default(0)
  costUsd   Decimal  @default(0) @db.Decimal(14, 6)
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@id([hotelId, date, actorName, model])
  // Ajan kartı: bir ajanın son N günü.
  @@index([hotelId, actorName, date])
}

/// Misafire giden bildirim (modül 9) — aynı zamanda gönderim kuyruğu (outbox).
///
/// Metin kuyruğa yazılırken şablondan üretilip dondurulur: şablon sonradan
/// değişse de geçmiş, misafire gerçekte ne gittiğini gösterir.
model Notification {
  id                String              @id @default(uuid())
  hotelId           String
  channel           NotificationChannel
  source            NotificationSource
  language          String              @default("tr")
  /// E-posta adresi ya da uluslararası telefon (yalnızca rakam).
  recipient         String
  recipientName     String?
  subject           String?
  body              String
  /// Şablon değişkenlerinin gönderim anındaki değerleri (denetim için).
  params            Json                @default("{}")
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  /// `PENDING` iken bir sonraki deneme zamanı (sessiz saat ve yeniden deneme).
  nextAttemptAt     DateTime?
  /// `SENDING` iken göndericinin üstlendiği an; takılı kalanı bulmak için.
  lockedAt          DateTime?
  provider          String?
  providerMessageId String?
  errorCode         String?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  templateId        String?
  guestId           String?
  reservationId     String?
  resendOfId        String?
  /// Aynı olay için ikinci bildirim açılmasın (ör. aynı oda ataması iki kez işlendi).
  dedupeKey         String?
  createdBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  hotel       Hotel                 @relation(fields: [hotelId], references: [id])
  template    NotificationTemplate? @relation(fields: [templateId], references: [id])
  guest       Guest?                @relation(fields: [guestId], references: [id])
  reservation Reservation?          @relation(fields: [reservationId], references: [id])
  resendOf    Notification?         @relation("NotificationResend", fields: [resendOfId], references: [id])
  resends     Notification[]        @relation("NotificationResend")

  // Geçmiş ekranı: en yeni önce, imleçle.
  @@index([hotelId, createdAt, id])
  @@index([hotelId, status, createdAt])
  @@index([hotelId, channel, createdAt])
  // Gönderici: zamanı gelmiş bekleyenler (bütün oteller).
  @@index([status, nextAttemptAt])
  // Teslim raporu eşleştirmesi. Rapor bekleyen SMS'ler için kısmi index
  // `Notification_sms_report_idx` migration'da.
  @@index([provider, providerMessageId])
  @@index([reservationId])
  @@index([guestId])
  // Detaydaki tekrar gönderimler.
  @@index([resendOfId])
  // Arama (trigram).
  @@index([recipient(ops: raw("gin_trgm_ops"))], map: "Notification_recipient_trgm_idx", type: Gin)
  @@index([recipientName(ops: raw("gin_trgm_ops"))], map: "Notification_recipientName_trgm_idx", type: Gin)
  @@index([subject(ops: raw("gin_trgm_ops"))], map: "Notification_subject_trgm_idx", type: Gin)
}

/// Bildirim şablonu: olay × kanal × dil başına bir tane (modül 9).
model NotificationTemplate {
  id        String              @id @default(uuid())
  hotelId   String
  key       NotificationTrigger
  channel   NotificationChannel
  language  String
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  updatedBy String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  hotel         Hotel          @relation(fields: [hotelId], references: [id])
  notifications Notification[]

  @@index([hotelId, key])
}

/// Kanal ayarı (SMTP, SMS sağlayıcısı, WhatsApp) — otel × kanal başına bir tane.
///
/// Parola ve API anahtarı `secret` alanında **şifreli** durur (AES-256-GCM,
/// anahtar sunucu ortamında); API hiçbir zaman geri döndürmez.
model NotificationChannelConfig {
  id               String              @id @default(uuid())
  hotelId          String
  channel          NotificationChannel
  enabled          Boolean             @default(false)
  /// Gizli olmayan ayarlar (sunucu, port, gönderen, başlık, sessiz saatler).
  settings         Json                @default("{}")
  secret           String?
  secretUpdatedAt  DateTime?
  lastTestAt       DateTime?
  lastTestOk       Boolean?
  lastTestError    String?
  lastFailureAt    DateTime?
  lastFailureError String?
  updatedBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Personel uyarısı (üst bardaki zil).
///
/// Soft-delete yok: uyarı bir iş kaydı değil, `STAFF_ALERT_RETENTION_DAYS`
/// sonra kalıcı silinir. Kime gideceği ya bir kişi (`userId`) ya da bir izin
/// (`permission`, o izne sahip herkes) — 2500 kişiye satır çoğaltılmaz.
model StaffAlert {
  id         String             @id @default(uuid())
  hotelId    String
  kind       StaffAlertKind
  severity   StaffAlertSeverity @default(INFO)
  title      String
  body       String?
  link       String?
  userId     String?
  permission String?
  entityType String?
  entityId   String?
  /// Aynı konu için tek uyarı (aynı konuşmadan gelen yeni mesaj eskisini öne alır).
  dedupeKey  String?
  /// Uyarının en son tetiklendiği an (birleşen uyarıda güncellenir).
  occurredAt DateTime           @default(now())
  /// Birleşen tetiklenme sayısı ("3 yeni mesaj").
  count      Int                @default(1)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  hotel Hotel            @relation(fields: [hotelId], references: [id])
  user  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads StaffAlertRead[]

  @@index([hotelId, occurredAt, id])
  // Zil: kişiye özel uyarılar en yeniden. İzne gidenler için kısmi index
  // `StaffAlert_permission_feed_idx` (userId boş) migration'da.
  @@index([hotelId, userId, occurredAt, id])
  @@index([occurredAt])
}

/// Kişinin okuduğu uyarı.
model StaffAlertRead {
  alertId String
  userId  String
  readAt  DateTime @default(now())

  alert StaffAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([alertId, userId])
  @@index([userId])
}

/// Kişinin zil durumu: son bakış (rozet bundan sonrasını sayar) ve susturduğu türler.
model StaffAlertState {
  userId     String           @id
  hotelId    String
  lastSeenAt DateTime?
  mutedKinds StaffAlertKind[] @default([])
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── ÖN BÜRO ─────────────

model RoomType {
  id               String    @id @default(uuid())
  hotelId          String
  code             String
  name             String
  capacityAdults   Int       @default(2)
  capacityChildren Int       @default(0)
  basePrice        Decimal   @db.Decimal(12, 2)
  description      String?
  amenities        Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  hotel             Hotel                @relation(fields: [hotelId], references: [id])
  rooms             Room[]
  reservations      Reservation[]
  ratePlans         RatePlan[]
  waitlist          WaitlistEntry[]
  contractRates     ContractRate[]
  contractStopSales ContractStopSale[]
  channelMappings   ChannelRoomMapping[]

  // Benzersizlik kısmi (partial) unique index ile veritabanında tanımlı:
  // `RoomType_hotelId_code_active_key ... WHERE "deletedAt" IS NULL`.
  // Prisma kısmi index'i ifade edemediği için burada `@@unique` yok —
  // olsaydı silinmiş bir oda tipinin kodu asla tekrar kullanılamazdı.
  @@index([hotelId, code])
  @@index([hotelId, deletedAt])
}

/// Oda durumu üç bağımsız bilgidir: `occupancy` (boş/dolu), `housekeepingStatus`
/// (kirli/temiz...) ve tarihli arıza kaydı (`RoomBlock`). "Arızalı" bir kolon
/// değildir; o günü kapsayan bloktan okunur — böylece ileri tarihli arıza kaydı
/// günü gelince zamanlayıcı gerekmeden etkin olur ve bitince kendiliğinden kalkar.
model Room {
  id                 String             @id @default(uuid())
  hotelId            String
  number             String
  floor              Int                @default(1)
  roomTypeId         String
  occupancy          RoomOccupancy      @default(VACANT)
  housekeepingStatus HousekeepingStatus @default(CLEAN)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  hotel               Hotel                @relation(fields: [hotelId], references: [id])
  roomType            RoomType             @relation(fields: [roomTypeId], references: [id])
  reservations        Reservation[]
  blocks              RoomBlock[]
  staySegments        RoomStaySegment[]
  guestRequests       GuestRequest[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceTickets  MaintenanceTicket[]
  maintenancePlans    MaintenancePlan[]
  lostItems           LostItem[]
  minibarConsumptions MinibarConsumption[]
  laundryOrders       LaundryOrder[]
  roomServiceOrders   RoomServiceOrder[]
  roomServiceLinks    RoomServiceLink[]

  // Oda numarası benzersizliği de kısmi index ile (bkz. RoomType açıklaması):
  // silinen 101 numaralı oda sonradan tekrar açılabilmeli.
  @@index([hotelId, number])
  @@index([hotelId, deletedAt])
  // Oda listesi ve kat hizmetleri ekranının filtreleri ("3. kattaki kirli odalar").
  @@index([hotelId, housekeepingStatus])
  @@index([hotelId, occupancy])
}

/// Tarihli arıza kaydı: odanın belirli günlerde arızalı ya da hizmet dışı olması.
///
/// Tarihler UTC gün başıdır (veritabanı kısıtıyla zorunlu). `endDate` boşsa blok
/// süresizdir. Geçmiş kayıt değiştirilmez: süren blok "bitirilir" (bitişi bugüne
/// çekilir), başlamamış blok iptal edilir (soft-delete).
///
/// Rezervasyonla çakışması veritabanı tetikleyicisiyle engellenir
/// (`Reservation_room_blocked`, `RoomBlock_has_reservations`).
model RoomBlock {
  id        String        @id @default(uuid())
  hotelId   String
  roomId    String
  type      RoomBlockType @default(OUT_OF_ORDER)
  startDate DateTime
  endDate   DateTime?
  reason    String
  createdBy String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])
  room  Room  @relation(fields: [roomId], references: [id])

  @@index([hotelId, roomId, startDate, endDate])
  @@index([hotelId, deletedAt])
}

model Guest {
  id          String          @id @default(uuid())
  hotelId     String
  firstName   String
  lastName    String
  phone       String?
  email       String?
  nationality String?
  /// Kimlik belgesinin türü; `idNumber` onun numarası (girişte zorunlu, modül 6).
  idType      IdDocumentType?
  idNumber    String?
  birthDate   DateTime?
  notes       String?
  preferences Json            @default("{}")
  tags        String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  hotel             Hotel              @relation(fields: [hotelId], references: [id])
  reservations      Reservation[]
  reservationGuests ReservationGuest[]
  conversations     Conversation[]
  guestRequests     GuestRequest[]
  folios            Folio[]
  lostItems         LostItem[]
  notifications     Notification[]
  waitlistEntries   WaitlistEntry[]
  invoices          Invoice[]

  @@index([phone])
  @@index([email])
  // Girişte refakatçiyi belgesinden tanıma (aynı kişiye ikinci kart açılmasın).
  @@index([hotelId, idNumber])
  // Ada göre arama (trigram). E-posta eşleştirmesi için ifade index'i
  // `Guest_hotelId_email_lower_idx` (lower(email)) migration'da.
  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "Guest_firstName_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "Guest_lastName_trgm_idx", type: Gin)
}

model Reservation {
  id                  String               @id @default(uuid())
  hotelId             String
  guestId             String
  roomTypeId          String
  roomId              String?
  checkIn             DateTime
  checkOut            DateTime
  adults              Int                  @default(1)
  children            Int                  @default(0)
  status              ReservationStatus    @default(PENDING)
  source              ReservationSource    @default(UI)
  totalPrice          Decimal              @db.Decimal(12, 2)
  currency            String               @default("TRY")
  boardType           BoardType            @default(BB)
  requestId           String?
  /// Acente adına açıldıysa acente (modül 29); kaynak "Acente" olur.
  agencyId            String?
  /// Rezervasyon açıldığı andaki acente komisyon yüzdesi (acente kartı sonradan değişse de bu kalır).
  agencyCommissionPct Decimal?             @db.Decimal(5, 2)
  /// Uygulanan promosyon (modül 31) ve (kuponla uygulandıysa) kupon. `promotionTerms`
  /// açılıştaki kopyasıdır (indirim + koşullar + uygulandığı gün): promosyon sonradan
  /// değişse de bu rezervasyonun sözü değişmez; konaklama değişince bu kopyayla denetlenir.
  promotionId         String?
  couponId            String?
  promotionTerms      Json?
  /// Gecelere düşen indirimlerin toplamı (`ReservationNight.discount`); toplam fiyat indirimlidir.
  discountTotal       Decimal              @default(0) @db.Decimal(12, 2)
  /// Kanaldan (OTA / iCal) geldiyse kanal rezervasyonu ve oradaki oda sırası (modül 33).
  channelBookingId    String?
  channelRoomIndex    Int?
  groupId             String?
  notes               String?
  confirmationCode    String               @unique
  /// İçerideki misafir oda değiştirdiyse, `roomId` odasında kalmaya başladığı
  /// gece (gün başı). Boşsa konaklamanın tamamı `roomId` odasındadır. Önceki
  /// odalardaki geceler `RoomStaySegment`'te durur.
  roomSince           DateTime?
  /// Fiyatın kaynağı; `MANUAL` ise `priceNote` gerekçedir. Geceler `ReservationNight`'ta.
  priceMode           ReservationPriceMode @default(CALCULATED)
  priceNote           String?
  /// Rezervasyonu açan (personel e-postası, aktör adı ya da kanal).
  createdBy           String               @default("system")
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  cancelledBy         String?
  cancelReason        String?
  /// İptal politikasına göre hesaplanan ceza (tahsilatı folyo/ödeme modülünde).
  cancellationFee     Decimal?             @db.Decimal(12, 2)
  noShowAt            DateTime?
  noShowFee           Decimal?             @db.Decimal(12, 2)
  /// Giriş / çıkış (modül 6). İçerideyse `checkedInAt`, çıkmışsa ikisi de dolu (kısıt).
  checkedInAt         DateTime?
  checkedInBy         String?
  checkedOutAt        DateTime?
  checkedOutBy        String?
  /// Erken giriş / geç çıkış ücreti (politikadan; personel uygulamayabilir). Folyoya
  /// kalem olarak işlenmesi folyo modülünde (15), olay gövdesinden.
  earlyCheckInFee     Decimal?             @db.Decimal(12, 2)
  lateCheckOutFee     Decimal?             @db.Decimal(12, 2)
  vehiclePlate        String?
  /// Girişte alınan teminat (tahsilat değil; bkz. `DepositMethod`).
  depositMethod       DepositMethod?
  depositAmount       Decimal?             @db.Decimal(12, 2)
  /// Provizyon / dekont numarası. Kart numarası yazılamaz (sözleşmede reddedilir).
  depositReference    String?
  /// Bakiyesi kapanmadan yapılan çıkış: o anki açık tutar ve yetkilinin gerekçesi.
  checkoutOpenBalance Decimal?             @db.Decimal(12, 2)
  openBalanceReason   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  hotel                  Hotel                   @relation(fields: [hotelId], references: [id])
  guest                  Guest                   @relation(fields: [guestId], references: [id])
  roomType               RoomType                @relation(fields: [roomTypeId], references: [id])
  room                   Room?                   @relation(fields: [roomId], references: [id])
  group                  ReservationGroup?       @relation(fields: [groupId], references: [id])
  agency                 Agency?                 @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  promotion              Promotion?              @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  coupon                 Coupon?                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  channelBooking         ChannelBooking?         @relation(fields: [channelBookingId], references: [id], onDelete: Restrict)
  nights                 ReservationNight[]
  waitlistEntries        WaitlistEntry[]
  reservationGuests      ReservationGuest[]
  folios                 Folio[]
  folioItems             FolioItem[]
  folioRoutes            FolioRoute[]
  payments               Payment[]
  lostItems              LostItem[]
  minibarConsumptions    MinibarConsumption[]
  laundryOrders          LaundryOrder[]
  roomSegments           RoomStaySegment[]
  conversations          Conversation[]
  guestRequests          GuestRequest[]
  notifications          Notification[]
  agencyBonusLines       AgencyBonusLine[]
  posRoomCharges         PosRoomCharge[]
  roomServiceOrders      RoomServiceOrder[]
  roomServiceLinks       RoomServiceLink[]
  guestPortalLinks       GuestPortalLink[]
  onlineCheckin          OnlineCheckin?
  onlineCheckinDocuments OnlineCheckinDocument[]

  // Müsaitlik sorgusunun sıcak yolu: "şu otelde, şu oda tipinde, şu tarihlerde
  // envanteri tüketen rezervasyonlar". Dolu bir otelde saniyede onlarca kez çalışır.
  @@index([hotelId, roomTypeId, status, checkIn, checkOut])
  // Belirli bir odanın takvimi (oda planı ekranı, atama kontrolü).
  @@index([hotelId, roomId, checkIn, checkOut])
  // Pencere sorguları (oda planı özeti, müsaitlik): çıkışı pencereden sonra olanlar.
  @@index([hotelId, checkOut, checkIn])
  // Misafirin konaklamaları.
  @@index([hotelId, guestId, checkIn])
  // Onay koduyla arama (trigram).
  @@index([confirmationCode(ops: raw("gin_trgm_ops"))], map: "Reservation_confirmationCode_trgm_idx", type: Gin)
  // Rezervasyon listesi (modül 4): girişe göre, açılışa göre, durum + giriş, grup.
  // Tekrar gönderime karşı istek kimliği tekil: kısmi index
  // `Reservation_hotelId_requestId_key` (migration'da).
  @@index([hotelId, checkIn, id])
  @@index([hotelId, createdAt, id])
  @@index([hotelId, status, checkIn, id])
  @@index([hotelId, groupId])
  // Ön büro (modül 6): gidecekler (içeride, çıkışı bugün ya da geçmiş) ve
  // "bugün giriş / çıkış yapanlar".
  @@index([hotelId, status, checkOut, id])
  @@index([hotelId, checkedInAt])
  @@index([hotelId, checkedOutAt])
}

/// Grup rezervasyonu (modül 4): tek formda açılan birden fazla oda. Odalar
/// ayrı `Reservation` kayıtlarıdır; grup yalnızca onları bağlar.
model ReservationGroup {
  id        String    @id @default(uuid())
  hotelId   String
  code      String    @unique
  name      String
  notes     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  reservations Reservation[]

  @@index([hotelId, createdAt])
}

/// Konaklamanın gece gece fiyatı (modül 4). Toplam fiyat bunların toplamıdır;
/// gelir raporları (modül 13, 23) ve folyo (modül 15) geceyi buradan okur.
/// `baseRate`/`multiplier` hesaplanan fiyatta dolu, elle fiyatta ve eski
/// kayıtlardan aktarılan gecelerde boştur.
model ReservationNight {
  id            String    @id @default(uuid())
  hotelId       String
  reservationId String
  date          DateTime
  amount        Decimal   @db.Decimal(12, 2)
  baseRate      Decimal?  @db.Decimal(12, 2)
  multiplier    Decimal?  @db.Decimal(6, 3)
  seasonName    String?
  /// Bu geceye düşen promosyon indirimi (modül 31). `amount` indirimli tutardır;
  /// liste fiyatı `amount + discount`.
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@unique([reservationId, date])
  // "Bu gece hangi gelir var" (günlük durum, gelir raporu).
  @@index([hotelId, date])
}

/// Bekleme listesi (modül 4): yer yokken "listeye al"; yer açılınca personele
/// uyarı gider (`AVAILABLE`), rezervasyona çevrilince kapanır.
model WaitlistEntry {
  id             String         @id @default(uuid())
  hotelId        String
  guestId        String?
  firstName      String
  lastName       String
  phone          String?
  email          String?
  roomTypeId     String
  checkIn        DateTime
  checkOut       DateTime
  adults         Int            @default(1)
  children       Int            @default(0)
  boardType      BoardType      @default(BB)
  notes          String?
  status         WaitlistStatus @default(WAITING)
  /// Yerin açıldığı an (tarama bulduğunda); yer yeniden dolarsa boşalır.
  availableSince DateTime?
  reservationId  String?
  closedAt       DateTime?
  closedBy       String?
  closeReason    String?
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  guest       Guest?       @relation(fields: [guestId], references: [id])
  roomType    RoomType     @relation(fields: [roomTypeId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  // Açık kayıtlar (tarama ve liste), en yakın giriş önce.
  @@index([hotelId, status, checkIn, id])
  @@index([hotelId, createdAt, id])
}

/// Bir konaklamanın **kapanmış** oda dilimi: misafir içerideyken oda
/// değiştirdiğinde eski odada geçirdiği geceler `[startDate, endDate)`.
///
/// Rezervasyonun tek bir `roomId`'si var; bu tablo olmadan oda değişikliği
/// geçmişi yeniden yazıyordu (misafir geçmiş gecelerde de yeni odada
/// görünüyordu). Açık dilim rezervasyonun kendisidir:
/// `[coalesce(roomSince, checkIn), checkOut)` → `roomId`.
///
/// Yalnızca eklenir; düzeltme soft-delete ile yapılır. Gece kapanışı (modül 18),
/// faturalama (modül 16) ve kat hizmeti "o gece hangi odadaydı" sorusunu buradan
/// cevaplar.
model RoomStaySegment {
  id            String    @id @default(uuid())
  hotelId       String
  reservationId String
  roomId        String
  startDate     DateTime
  endDate       DateTime
  /// Taşımayı yapan (denetim izindeki aktör).
  movedBy       String
  /// Taşıma sebebi ("klima arızası", "misafir talebi").
  reason        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  room        Room        @relation(fields: [roomId], references: [id])

  // Oda planı ve müsaitlik: "bu odada bu tarihlerde kim vardı".
  @@index([hotelId, roomId, startDate, endDate])
  @@index([reservationId])
}

model ReservationGuest {
  id            String    @id @default(uuid())
  hotelId       String
  reservationId String
  guestId       String
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  guest       Guest       @relation(fields: [guestId], references: [id])

  @@unique([reservationId, guestId])
}

model RatePlan {
  id         String    @id @default(uuid())
  hotelId    String
  roomTypeId String
  name       String
  startDate  DateTime
  endDate    DateTime
  price      Decimal   @db.Decimal(12, 2)
  boardType  BoardType @default(BB)
  minStay    Int?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
}

model Season {
  id         String    @id @default(uuid())
  hotelId    String
  name       String
  startDate  DateTime
  endDate    DateTime
  multiplier Decimal   @default(1) @db.Decimal(6, 3)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  // Fiyat hesabı her rezervasyonda "şu tarihe düşen sezon" sorgusu atar; sıcak yol budur.
  @@index([hotelId, startDate, endDate])
  @@index([hotelId, deletedAt])
}

model Tax {
  id         String    @id @default(uuid())
  hotelId    String
  name       String
  rate       Decimal   @db.Decimal(6, 3)
  isIncluded Boolean   @default(true)
  appliesTo  String[]  @default([])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  hotel       Hotel           @relation(fields: [hotelId], references: [id])
  invoiceCode InvoiceTaxCode?

  @@index([hotelId, deletedAt])
}

/// Misafirle bir kanal üzerindeki konuşma (WhatsApp numarası, web chat oturumu).
///
/// Liste ekranı her satır için mesaj saymasın diye son mesaj özeti ve
/// okunmamış sayacı burada tutulur; mesaj yazan her işlem aynı transaction'da
/// günceller.
model Conversation {
  id                 String              @id @default(uuid())
  hotelId            String
  channel            NotificationChannel
  /// Kanaldaki karşı taraf: telefon numarası, web chat oturum kimliği.
  externalId         String
  /// Kanalın bildirdiği görünen ad (misafir kaydıyla eşleşmemişse ekranda bu görünür).
  displayName        String?
  guestId            String?
  reservationId      String?
  summary            String?
  status             ConversationStatus  @default(OPEN)
  mode               ConversationMode    @default(MANUAL)
  assignedToId       String?
  unreadCount        Int                 @default(0)
  /// Yönetim sürümü: durum, mod, atama ya da konaklama değişince artar.
  /// Yeni mesaj `updatedAt`'i değiştirir ama bunu değiştirmez — yoğun gelen
  /// kutusunda personel "ata" derken misafirin yazması çakışma sayılmasın.
  stateVersion       Int                 @default(0)
  lastMessageAt      DateTime            @default(now())
  lastMessagePreview String?
  lastMessageAuthor  MessageAuthor?
  /// Misafirin cevapsız bekleyen ilk mesajının zamanı; personel/AI cevap
  /// verince boşalır. "12 dakikadır cevap bekliyor" buradan hesaplanır.
  awaitingReplySince DateTime?
  lastReadAt         DateTime?
  closedAt           DateTime?
  closedBy           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  hotel       Hotel                @relation(fields: [hotelId], references: [id])
  guest       Guest?               @relation(fields: [guestId], references: [id])
  reservation Reservation?         @relation(fields: [reservationId], references: [id])
  assignedTo  User?                @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages    Message[]
  requests    GuestRequest[]
  aiState     ConversationAiState?
  // Kısmi index (migration'da): `Conversation_ai_waiting_idx` — AI'da cevap
  // bekleyen konuşmalar (modül 8, takılan AI turunu personele devreden iş).

  @@unique([hotelId, channel, externalId])
  // Gelen kutusu: "açık konuşmalar, en son mesaj önce".
  @@index([hotelId, status, lastMessageAt])
  // "Tümü" görünümü.
  @@index([hotelId, lastMessageAt, id])
  @@index([hotelId, assignedToId, status])
  @@index([hotelId, guestId])
  @@index([hotelId, reservationId])
  // Arama (trigram).
  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "Conversation_displayName_trgm_idx", type: Gin)
  @@index([externalId(ops: raw("gin_trgm_ops"))], map: "Conversation_externalId_trgm_idx", type: Gin)
  @@index([lastMessagePreview(ops: raw("gin_trgm_ops"))], map: "Conversation_lastMessagePreview_trgm_idx", type: Gin)
}

model Message {
  id             String           @id @default(uuid())
  hotelId        String
  conversationId String
  direction      MessageDirection
  author         MessageAuthor    @default(GUEST)
  text           String
  actorName      String?
  /// Yalnızca personelin gördüğü iç not; misafire gönderilmez.
  internal       Boolean          @default(false)
  delivery       MessageDelivery  @default(RECEIVED)
  /// Kanalın mesaj kimliği. Aynı webhook iki kez gelirse mesaj iki kez yazılmaz
  /// (kısmi unique index, bkz. migration).
  externalId     String?
  failureReason  String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  meta           Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  hotel        Hotel          @relation(fields: [hotelId], references: [id])
  conversation Conversation   @relation(fields: [conversationId], references: [id])
  requests     GuestRequest[]
  // Kısmi index (Prisma ifade edemez, migration'da): `Message_pending_outgoing_idx`
  // — gönderim bekleyen giden mesajlar (modül 8, bekleyenleri gönderen iş).

  // Konuşma geçmişi imleçle sayfalanır: (createdAt, id) sırası.
  @@index([conversationId, createdAt, id])
  // Kanal kuyruğu: gönderim bekleyen giden mesajlar.
  @@index([hotelId, delivery])
  // Kanalın teslim bildirimi mesajı kendi kimliğiyle bulur (WhatsApp `wamid`).
  @@index([hotelId, externalId])
}

/// Misafir isteği: havlu, oda servisi, uyandırma, arıza bildirimi, şikâyet.
///
/// Konuşmadan, telefondan ya da resepsiyondan doğabilir. `dueAt` hizmet
/// süresi hedefidir (SLA): önceliğe göre sunucuda hesaplanır, geçerse istek
/// "gecikmiş" sayılır. Uyandırma gibi zamanlı isteklerde `scheduledFor` asıl
/// zamandır.
model GuestRequest {
  id               String               @id @default(uuid())
  hotelId          String
  reservationId    String?
  guestId          String?
  roomId           String?
  conversationId   String?
  messageId        String?
  category         GuestRequestCategory
  title            String
  description      String?
  priority         GuestRequestPriority @default(NORMAL)
  status           GuestRequestStatus   @default(OPEN)
  source           GuestRequestSource   @default(FRONT_DESK)
  dueAt            DateTime
  scheduledFor     DateTime?
  assignedToId     String?
  createdBy        String
  startedAt        DateTime?
  completedAt      DateTime?
  completedBy      String?
  resolutionNote   String?
  cancelledReason  String?
  /// Gecikme uyarısının gönderildiği an; hedef süre değişince sıfırlanır (modül 9).
  overdueAlertedAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  hotel             Hotel              @relation(fields: [hotelId], references: [id])
  reservation       Reservation?       @relation(fields: [reservationId], references: [id])
  guest             Guest?             @relation(fields: [guestId], references: [id])
  room              Room?              @relation(fields: [roomId], references: [id])
  conversation      Conversation?      @relation(fields: [conversationId], references: [id])
  message           Message?           @relation(fields: [messageId], references: [id])
  assignedTo        User?              @relation("GuestRequestAssignee", fields: [assignedToId], references: [id])
  /// Oda servisi siparişine çevrildiyse (modül 41; aynı anda tek açık sipariş — teslim / iptal sonrası yeniden açılan istek yeniden çevrilir).
  roomServiceOrders RoomServiceOrder[]
  /// Kat görevine çevrildiyse (modül 14; görev bitince istek kapanır).
  housekeepingTasks HousekeepingTask[]

  // İş listesi: "açık istekler, süresi en yakın önce".
  @@index([hotelId, status, dueAt])
  // Bitmiş işler: tamamlanan, iptal ve tümü görünümleri.
  @@index([hotelId, status, completedAt, id])
  @@index([hotelId, status, updatedAt, id])
  @@index([hotelId, createdAt, id])
  @@index([hotelId, assignedToId, status])
  @@index([hotelId, roomId, status])
  @@index([hotelId, guestId])
  @@index([reservationId])
  @@index([conversationId])
  // Arama (trigram).
  @@index([title(ops: raw("gin_trgm_ops"))], map: "GuestRequest_title_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "GuestRequest_description_trgm_idx", type: Gin)
}

// ───────────── FOLYO / ÖDEME ─────────────

/// Konaklamanın hesabı (modül 15). Bir konaklamanın birden fazla folyosu
/// (penceresi) olabilir: 1 ana folyo, bölmeyle 2, 3... Kalem silinmez; iptal
/// eksi tutarlı ters kayıttır. Bakiye = Σ kalem toplamı − Σ ödeme × kur.
model Folio {
  id            String      @id @default(uuid())
  hotelId       String
  reservationId String
  /// Ödeyen misafir (varsayılan: rezervasyon sahibi).
  guestId       String
  /// Konaklamadaki sırası: 1 ana folyo; bölmeyle 2, 3... (en fazla `FOLIO_MAX_WINDOWS`).
  window        Int         @default(1)
  /// Ödeyen başkasıysa adı (şirket, acente). Boşsa misafir. Faturanın (16) alıcı varsayılanı.
  payerName     String?
  status        FolioStatus @default(OPEN)
  /// Denormalize toplamlar: folyoya yazan her işlem folyo kilitliyken kalem ve
  /// ödemelerden yeniden hesaplar (`refreshFolioTotals`); listeler bunları okur.
  /// Para-kritik yol (çıkış) yine kalemlerden hesaplar. Kısıt: bakiye = borç − ödenen.
  chargesTotal  Decimal     @default(0) @db.Decimal(12, 2)
  paymentsTotal Decimal     @default(0) @db.Decimal(12, 2)
  balance       Decimal     @default(0) @db.Decimal(12, 2)
  currency      String      @default("TRY")
  openedBy      String      @default("system")
  closedAt      DateTime?
  closedBy      String?
  /// Birleştirildiyse (durum `TRANSFERRED`) kalemlerinin taşındığı folyo.
  mergedIntoId  String?
  mergedAt      DateTime?
  mergedBy      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  hotel            Hotel        @relation(fields: [hotelId], references: [id])
  reservation      Reservation  @relation(fields: [reservationId], references: [id])
  guest            Guest        @relation(fields: [guestId], references: [id])
  mergedInto       Folio?       @relation("FolioMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom       Folio[]      @relation("FolioMerge")
  items            FolioItem[]  @relation("FolioItems")
  transferredItems FolioItem[]  @relation("FolioItemTransferredFrom")
  routes           FolioRoute[]
  invoices         Invoice[]
  payments         Payment[]

  /// Konaklamada pencere numarası tekil.
  @@unique([reservationId, window])
  // Çıkışta konaklamanın bakiyesi (modül 6) ve konaklamanın folyoları.
  @@index([hotelId, reservationId])
  // Folyo listesi: açıklar (son hareket önce), kapananlar (son kapanan önce).
  @@index([hotelId, status, updatedAt, id])
  @@index([hotelId, status, closedAt, id])
  @@index([mergedIntoId])
}

/// Folyo kalemi (modül 15). Satır: net + vergi = toplam; toplam = tutar × adet
/// + hariç vergiler. Vergi dökümü işlendiği andaki ayardan (`taxLines`).
model FolioItem {
  id                     String          @id @default(uuid())
  hotelId                String
  folioId                String
  /// Kalemin doğduğu konaklama (aktarma / birleştirmede değişmez).
  reservationId          String
  type                   FolioItemType
  source                 FolioItemSource @default(MANUAL)
  description            String
  /// Birim tutar (dahil vergiler içinde). İndirimde eksi; ters kayıtta asıl kalemin tersi.
  amount                 Decimal         @db.Decimal(12, 2)
  quantity               Int             @default(1)
  /// Vergi kategorisi (ayarlardaki "uygulandığı kalem"); boşsa vergisiz.
  taxCategory            String?
  netAmount              Decimal         @db.Decimal(12, 2)
  taxAmount              Decimal         @db.Decimal(12, 2)
  total                  Decimal         @db.Decimal(12, 2)
  /// İşlendiği andaki vergi dökümü: [{ taxId, name, rate, included, amount }].
  taxLines               Json            @default("[]")
  /// Hizmetin ait olduğu gün: oda ücretinde gece, diğerlerinde işlendiği iş günü.
  serviceDate            DateTime        @db.Date
  /// Tekrar işleme anahtarı (otel başına tekil): gece, olay, elle istek kimliği.
  sourceKey              String?
  postedBy               String
  postedAt               DateTime        @default(now())
  /// Ters kayıtsa asıl kalem (tekil: bir kalem bir kez iptal edilir).
  reversalOfId           String?         @unique
  voidedAt               DateTime?
  voidedBy               String?
  voidReason             String?
  /// İptal onayı: bekliyorsa `voidRequestedAt` dolu, karar verilince temizlenir.
  voidApprovalId         String?
  voidRequestedAt        DateTime?
  voidRequestedBy        String?
  /// Son aktarmanın kaynağı (tam iz denetim kaydında).
  transferredFromFolioId String?
  transferredAt          DateTime?
  transferredBy          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  hotel           Hotel       @relation(fields: [hotelId], references: [id])
  folio           Folio       @relation("FolioItems", fields: [folioId], references: [id])
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  reversalOf      FolioItem?  @relation("FolioItemReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal        FolioItem?  @relation("FolioItemReversal")
  transferredFrom Folio?      @relation("FolioItemTransferredFrom", fields: [transferredFromFolioId], references: [id], onDelete: Restrict)

  @@unique([hotelId, sourceKey])
  // Folyo dökümü: hizmet günü, aynı gün içinde işlenme sırası (imleçli).
  @@index([folioId, serviceDate, postedAt, id])
  // Konaklamanın gece ücretleri ve tek seferlik ücretleri (erken giriş, iptal...).
  @@index([reservationId, source, serviceDate])
  // Gelir raporu (modül 23): otelin işlenen geliri hizmet gününe göre.
  @@index([hotelId, serviceDate])
}

/// Konaklamanın yönlendirmesi (modül 15): bu tipteki sistem kalemleri (oda
/// ücreti, restoran, minibar) bu folyoya düşer. Yoksa konaklamanın ilk açık folyosu.
model FolioRoute {
  id            String        @id @default(uuid())
  hotelId       String
  reservationId String
  type          FolioItemType
  folioId       String
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  folio       Folio       @relation(fields: [folioId], references: [id])

  @@unique([reservationId, type])
  @@index([folioId])
}

/// Gecenin oda ücretlerinin işlenmesi (modül 15). Zamanlayıcı gün dönünce otel
/// başına bir kez açar (tekil) ve folyo aktörüne haber verir; işlenince tamamlanır.
model RoomChargeRun {
  id          String    @id @default(uuid())
  hotelId     String
  night       DateTime  @db.Date
  dueAt       DateTime  @default(now())
  completedAt DateTime?
  completedBy String?
  stays       Int?
  items       Int?
  total       Decimal?  @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, night])
}

/// Ödeme satırı (modül 17). Silinmez: hatalı giriş iptal kaydıyla (`REVERSAL`,
/// ters tutar), misafire geri verilen para iadeyle (`REFUND`, eksi tutar)
/// düzeltilir. Bakiyeye yalnızca işlenmiş (`POSTED`) satırlar girer.
model Payment {
  id              String        @id @default(uuid())
  hotelId         String
  folioId         String
  /// Ödemenin alındığı konaklama (folyo birleşse de değişmez; giriş teminatını bulmak için).
  reservationId   String
  kind            PaymentKind   @default(PAYMENT)
  /// Onay bekleyen (eşik üstü ödeme, iade) bakiyeye girmez; reddedilen hiç işlenmez.
  status          PaymentStatus @default(POSTED)
  source          PaymentSource @default(DESK)
  method          PaymentMethod
  /// Ödemenin kendi para birimindeki tutarı. Tahsilatta artı, iadede eksi;
  /// iptal kaydında asıl satırın tersi.
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("TRY")
  /// Ödeme para biriminden folyo para birimine kur (1 birim = kur). Aynı para biriminde boş.
  exchangeRate    Decimal?      @db.Decimal(12, 6)
  /// Folyoya giren tutar: ROUND(tutar × kur, 2) (kısıt). Bakiye bunu toplar.
  folioAmount     Decimal       @db.Decimal(12, 2)
  /// Kasanın günü: işlendiği iş günü (onay bekleyende isteğin günü; onaylanınca onay günü).
  businessDate    DateTime      @db.Date
  reference       String?
  note            String?
  /// Tekrar işleme anahtarı (otel başına tekil): elle istek, giriş teminatı, iptal.
  sourceKey       String?
  /// Personelin girdiği an ve kişi (ya da aktör).
  receivedBy      String
  receivedAt      DateTime      @default(now())
  /// Bakiyeye girdiği an (onaysızda girişle aynı; onaylıda onay anı).
  postedAt        DateTime?
  /// Bu satırı onaya bağlayan onay (eşik üstü ödeme ya da iade).
  approvalId      String?
  /// "Acente / cari" ve voucher'da borcun yazıldığı cari (modül 47).
  ledgerAccountId String?
  declinedAt      DateTime?
  /// İptal kaydıysa asıl satır (tekil: bir satır bir kez iptal edilir).
  reversalOfId    String?       @unique
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  /// İptal onayı: bekliyorsa `voidRequestedAt` dolu, karar verilince temizlenir.
  voidApprovalId  String?
  voidRequestedAt DateTime?
  voidRequestedBy String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  hotel         Hotel          @relation(fields: [hotelId], references: [id])
  folio         Folio          @relation(fields: [folioId], references: [id])
  reservation   Reservation    @relation(fields: [reservationId], references: [id])
  approval      Approval?      @relation(fields: [approvalId], references: [id])
  reversalOf    Payment?       @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal      Payment?       @relation("PaymentReversal")
  ledgerAccount LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([hotelId, sourceKey])
  // Folyonun ödemeleri (girildiği sırayla, imleçli).
  @@index([folioId, receivedAt, id])
  // Kasa: günün işlenen hareketleri (son işlenen önce, imleçli) ve toplamları.
  @@index([hotelId, businessDate, postedAt, id])
  // Onay bekleyenler (kasa görünümünün "bekleyen" kutusu).
  @@index([hotelId, status, receivedAt])
  // Konaklamanın giriş teminatı (giriş geri alınınca düşer).
  @@index([reservationId, source])
  @@index([approvalId])
  @@index([ledgerAccountId])
}

/// Günlük döviz kuru (modül 17): 1 birim döviz = `rate` × otel para birimi.
/// Otel × döviz × gün tekil; yalnızca iş günü için girilir (aynı gün yeniden
/// girilirse güncellenir, denetim izi eski değeri tutar). Ödeme kendi kurunu
/// saklar: kur sonradan değişse de geçmiş ödeme değişmez.
model ExchangeRate {
  id        String   @id @default(uuid())
  hotelId   String
  currency  String
  date      DateTime @db.Date
  rate      Decimal  @db.Decimal(12, 6)
  enteredBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, currency, date])
  // Günün kurları ve geçmiş (son gün önce).
  @@index([hotelId, date])
}

/// Minibar ürünü (modül 19). Fiyat vergi ayarına göre (kalem tipi minibar)
/// dahil / hariç yorumlanır. Kod otel içinde tekil (silinmemişler arasında:
/// kısmi index `MinibarItem_hotelId_code_active_key`).
model MinibarItem {
  id        String          @id @default(uuid())
  hotelId   String
  code      String
  name      String
  category  MinibarCategory @default(DRINK)
  price     Decimal         @db.Decimal(12, 2)
  /// Odadaki standart adet (dolum ve sayım ekranı için).
  parLevel  Int             @default(1)
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  hotel Hotel                    @relation(fields: [hotelId], references: [id])
  lines MinibarConsumptionLine[]

  // Giriş ekranının satıştaki ürünleri (sıralı) ve yönetim listesi.
  @@index([hotelId, active, sortOrder])
}

/// Odanın minibar sayımı: bir fiş (modül 19). Konaklamaya yazılan fiş
/// `minibar.consumed` olayıyla folyoya gider (`eventId`: folyo kalemlerinin
/// tekrar işleme anahtarı `evt:<eventId>:<sıra>`); kayıp fiş folyoya gitmez.
/// Fiş silinmez, değiştirilmez: düzeltme folyodaki kalem iptaliyle.
model MinibarConsumption {
  id            String              @id @default(uuid())
  hotelId       String
  roomId        String
  /// Yazıldığı konaklama (kayıpta boş).
  reservationId String?
  chargeTarget  MinibarChargeTarget
  /// İnsanın okuyacağı fiş no ("MB-7K2Q9X"): folyo kaleminde ve denetimde görünür.
  reference     String
  /// Sayımın iş günü (rapor).
  businessDate  DateTime            @db.Date
  totalAmount   Decimal             @db.Decimal(12, 2)
  itemCount     Int
  lossReason    String?
  note          String?
  /// Çift gönderim koruması (otel başına tekil).
  requestId     String
  /// Folyoya giden olay (kayıpta boş).
  eventId       String?
  recordedBy    String
  recordedAt    DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  hotel       Hotel                    @relation(fields: [hotelId], references: [id])
  room        Room                     @relation(fields: [roomId], references: [id])
  reservation Reservation?             @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  lines       MinibarConsumptionLine[]

  @@unique([hotelId, requestId])
  @@unique([hotelId, reference])
  // Günün fişleri (son giren önce, imleçli) ve günlük rapor.
  @@index([hotelId, businessDate, recordedAt, id])
  // Odanın son sayımları (aynı odaya iki kez girişe karşı uyarı).
  @@index([roomId, recordedAt])
  @@index([reservationId])
}

/// Minibar fişinin satırı: ürünün o anki adı ve fiyatı (fiyat sonradan değişse de fiş değişmez).
model MinibarConsumptionLine {
  id            String  @id @default(uuid())
  hotelId       String
  consumptionId String
  itemId        String
  name          String
  unitPrice     Decimal @db.Decimal(12, 2)
  quantity      Int
  total         Decimal @db.Decimal(12, 2)

  consumption MinibarConsumption @relation(fields: [consumptionId], references: [id])
  item        MinibarItem        @relation(fields: [itemId], references: [id])

  @@index([consumptionId])
  @@index([itemId])
}

/// Çamaşırhane fiyat listesi satırı: parça × hizmet (ör. gömlek — yıkama + ütü).
/// Kod otel içinde tekil (kısmi index `LaundryItem_hotelId_code_active_key`).
model LaundryItem {
  id        String         @id @default(uuid())
  hotelId   String
  code      String
  name      String
  service   LaundryService @default(WASH)
  price     Decimal        @db.Decimal(12, 2)
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  hotel Hotel              @relation(fields: [hotelId], references: [id])
  lines LaundryOrderLine[]

  @@index([hotelId, active, sortOrder])
}

/// Çamaşır siparişi (modül 19): içerideki misafir adına alınır, teslimde
/// ücreti `laundry.charged` olayıyla folyoya gider (`chargeEventId`).
/// Ekspres farkı sipariş anındaki ayardan (`expressPct`).
model LaundryOrder {
  id                    String        @id @default(uuid())
  hotelId               String
  roomId                String
  reservationId         String
  reference             String
  status                LaundryStatus @default(RECEIVED)
  express               Boolean       @default(false)
  expressPct            Decimal       @default(0) @db.Decimal(5, 2)
  subtotal              Decimal       @db.Decimal(12, 2)
  surcharge             Decimal       @default(0) @db.Decimal(12, 2)
  total                 Decimal       @db.Decimal(12, 2)
  itemCount             Int
  dueAt                 DateTime
  note                  String?
  requestId             String
  /// Alındığı iş günü (rapor).
  businessDate          DateTime      @db.Date
  receivedBy            String
  receivedAt            DateTime      @default(now())
  statusChangedAt       DateTime      @default(now())
  statusChangedBy       String
  deliveredAt           DateTime?
  deliveredBy           String?
  /// Teslim edildiği iş günü (gelir raporu).
  deliveredBusinessDate DateTime?     @db.Date
  chargeEventId         String?
  cancelledAt           DateTime?
  cancelledBy           String?
  cancelReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  hotel       Hotel              @relation(fields: [hotelId], references: [id])
  room        Room               @relation(fields: [roomId], references: [id])
  reservation Reservation        @relation(fields: [reservationId], references: [id])
  lines       LaundryOrderLine[]

  @@unique([hotelId, requestId])
  @@unique([hotelId, reference])
  // Pano: açık siparişler teslim sırasıyla, gecikenler.
  @@index([hotelId, status, dueAt, id])
  // Teslim edilenler / iptaller (son değişen önce; ikisi de son durum).
  @@index([hotelId, status, statusChangedAt, id])
  // Günlük rapor: o gün teslim edilenler (gelir).
  @@index([hotelId, deliveredBusinessDate])
  // Günlük rapor: o gün alınanlar.
  @@index([hotelId, businessDate])
  // Çıkışta teslim edilmemiş sipariş uyarısı.
  @@index([reservationId, status])
}

/// Çamaşır siparişinin satırı: parçanın o anki adı, hizmeti ve fiyatı.
model LaundryOrderLine {
  id        String         @id @default(uuid())
  hotelId   String
  orderId   String
  itemId    String
  name      String
  service   LaundryService
  unitPrice Decimal        @db.Decimal(12, 2)
  quantity  Int
  total     Decimal        @db.Decimal(12, 2)

  order LaundryOrder @relation(fields: [orderId], references: [id])
  item  LaundryItem  @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@index([itemId])
}

/// Gün kapanış durumu (modül 18). İş günü ("bugün") bu tablodan okunur:
/// son CLOSED günün ertesi (`lib/business-date.js`). Hiç kapanış yoksa takvim
/// günü. Bir gün yalnızca IN_PROGRESS → CLOSED yürür; aynı güne iki satır açılmaz
/// (kısıt) — iki görevli aynı anda kapatamaz.
enum NightAuditStatus {
  IN_PROGRESS
  CLOSED
}

model NightAudit {
  id              String           @id @default(uuid())
  hotelId         String
  /// Kapatılan iş günü (UTC gün başı).
  date            DateTime         @db.Date
  status          NightAuditStatus @default(IN_PROGRESS)
  startedAt       DateTime         @default(now())
  startedBy       String
  closedAt        DateTime?
  closedBy        String?
  /// Kapanışın yaptığı işin özeti (denetim; kaynak veriyi değiştirmez).
  noShowCount     Int              @default(0)
  roomChargeStays Int              @default(0)
  roomChargeTotal Decimal          @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  shiftReport ShiftReport?

  @@unique([hotelId, date])
  @@index([hotelId, status])
}

/// Vardiya devri / kasa sayımı (modül 18). Kapanışta yöntem bazında beklenen
/// (sistem) ve sayılan tutar, fark, devralan. `counts`: `[{ method, expected,
/// counted, variance }]`. Devir raporu (PDF) bundan üretilir.
model ShiftReport {
  id            String   @id @default(uuid())
  hotelId       String
  nightAuditId  String   @unique
  date          DateTime @db.Date
  counts        Json     @default("[]")
  expectedTotal Decimal  @default(0) @db.Decimal(14, 2)
  countedTotal  Decimal  @default(0) @db.Decimal(14, 2)
  variance      Decimal  @default(0) @db.Decimal(14, 2)
  note          String?
  handedOverBy  String
  createdAt     DateTime @default(now())

  hotel      Hotel      @relation(fields: [hotelId], references: [id])
  nightAudit NightAudit @relation(fields: [nightAuditId], references: [id])

  @@index([hotelId, date])
}

/// Günlük özet (modül 18 → 23 / 75 / 87): kapanan günün doluluğu, oda geliri,
/// ADR, RevPAR ve tahsilatı. Göstergeler modül 23 tanımlarıyla (satılan gece,
/// satılabilir = oda − arıza). Kaynak veri değişmez; kapanış anındaki özettir.
/// FlexAI 2.0'da gece müdürü (87) ve patron uygulaması (75) bunu okur.
model DailyStats {
  id            String   @id @default(uuid())
  hotelId       String
  day           DateTime @db.Date
  currency      String
  roomsSellable Int
  roomsSold     Int
  occupancyPct  Decimal  @db.Decimal(5, 2)
  roomRevenue   Decimal  @db.Decimal(14, 2)
  adr           Decimal  @db.Decimal(14, 2)
  revpar        Decimal  @db.Decimal(14, 2)
  collections   Decimal  @db.Decimal(14, 2)
  closedAt      DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, day])
}

// ───────────── KAT HİZMETLERİ / BAKIM ─────────────

/// Kat hizmeti görevi (modül 14). Odanın kat hizmeti durumundan ayrı kayıt:
/// durum "oda şu an nasıl", görev "kim ne zaman ne yapacak" sorusuna cevap.
/// Açık **temizlik** görevi oda başına tektir (kısmi tekil index, elle);
/// misafir isteği görevleri (havlu) bundan muaftır.
model HousekeepingTask {
  id           String           @id @default(uuid())
  hotelId      String
  roomId       String
  type         HousekeepingType @default(CHECKOUT_CLEAN)
  status       TaskStatus       @default(PENDING)
  /// 1 en acil, 5 en düşük. Çıkış temizliği 2'den açılır: oda satışa dönecek.
  priority     Int              @default(3)
  /// Görevin günü (UTC gün başı, otelin iş günü).
  scheduledFor DateTime         @default(now())
  /// Zamanlayıcı/aktör mü açtı, personel mi (Activity ayrımı için).
  source       String           @default("staff")
  notes        String?

  assignedToId String?
  startedAt    DateTime?

  completedAt    DateTime?
  completedById  String?
  completionNote String?

  /// Kat şefi kontrolü (dört göz: temizleyen onaylayamaz). `null`: henüz bakılmadı.
  inspectionPassed Boolean?
  inspectedById    String?
  inspectedAt      DateTime?
  inspectionNote   String?

  /// "Sorun var": görev açık kalır, iş teknik servise manuel görevle taşınır.
  issueNote       String?
  issueReportedAt DateTime?

  cancelReason String?

  /// Misafir isteğinden doğduysa (modül 7) — görev bitince istek kapanır.
  guestRequestId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  room         Room          @relation(fields: [roomId], references: [id])
  assignedTo   User?         @relation("HousekeepingAssignee", fields: [assignedToId], references: [id])
  completedBy  User?         @relation("HousekeepingCompleter", fields: [completedById], references: [id])
  inspectedBy  User?         @relation("HousekeepingInspector", fields: [inspectedById], references: [id])
  guestRequest GuestRequest? @relation(fields: [guestRequestId], references: [id])

  @@index([hotelId, scheduledFor])
  @@index([hotelId, status, priority])
  @@index([hotelId, roomId, status])
  @@index([hotelId, assignedToId, status])
}

/// Arıza / bakım türü (modül 20). Oda kapatma kararını da besler: su basması /
/// elektrik ağır iştir (OUT_OF_ORDER önerilir), kozmetik iş kısa.
enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  HVAC
  FURNITURE
  APPLIANCE
  STRUCTURAL
  SAFETY
  OTHER
}

/// Teknik servis / arıza-bakım bileti (modül 20). İskeletten genişletildi:
/// yaşam döngüsü (PENDING→IN_PROGRESS→DONE/CANCELLED, `TaskStatus`), kaynak
/// (personel, kat görevlisi bildirimi, misafir isteği, periyodik plan), oda
/// kapatıldıysa `roomBlockId` (çözülünce kaldırılır) ve fotoğraflar.
model MaintenanceTicket {
  id          String              @id @default(uuid())
  hotelId     String
  /// Oda arızası; oda dışı iş (lobi, asansör) için `locationText` (biri, kısıt).
  roomId      String?
  locationText String?
  category    MaintenanceCategory @default(OTHER)
  title       String
  description String
  status      TaskStatus          @default(PENDING)
  /// 1 en acil, 5 en düşük (kat hizmeti görevleriyle aynı ölçek).
  priority    Int                 @default(3)
  /// Kim açtı ve nasıl: `staff` | `housekeeping` (kat görevlisi bildirimi) |
  /// `guest` (misafir isteği) | `plan` (periyodik bakım).
  source      String              @default("staff")
  reportedBy  String
  assignedTo  String?
  assignedAt  DateTime?
  startedAt   DateTime?
  resolvedAt  DateTime?
  resolvedBy  String?
  resolutionNote String?
  cancelReason String?
  /// Oda kapatıldıysa açılan arıza kaydı (RoomBlock); çözülünce kaldırılır.
  roomBlockId String?
  /// Kat görevlisi "sorun var" bildiriminden doğduysa (housekeeping.issue.reported).
  housekeepingTaskId String?
  /// Misafir isteğinden doğduysa (modül 7); bilet durumu isteğe yansır.
  guestRequestId String?
  /// Periyodik bakım planından üretildiyse.
  planId      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  hotel  Hotel              @relation(fields: [hotelId], references: [id])
  room   Room?              @relation(fields: [roomId], references: [id])
  plan   MaintenancePlan?   @relation(fields: [planId], references: [id])
  photos MaintenancePhoto[]

  @@index([hotelId, status, priority])
  @@index([hotelId, roomId, status])
  @@index([hotelId, assignedTo, status])
  @@index([hotelId, guestRequestId])
}

/// Arıza fotoğrafı (modül 20; LostItemPhoto ile aynı desen). İçerik dosya
/// deposunda; burada yalnızca üstveri. İstemci yüklemeden önce küçültür.
model MaintenancePhoto {
  id          String   @id @default(uuid())
  hotelId     String
  ticketId    String
  contentType String
  sizeBytes   Int
  thumbBytes  Int
  createdBy   String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  hotel  Hotel             @relation(fields: [hotelId], references: [id])
  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}

/// Periyodik bakım planı (modül 20): aylık kontrol listeleri. Zamanlanmış iş
/// her periyotta (`intervalDays`) plandan bir MaintenanceTicket üretir.
model MaintenancePlan {
  id           String              @id @default(uuid())
  hotelId      String
  title        String
  description  String?
  category     MaintenanceCategory @default(OTHER)
  /// Belirli oda ya da genel otel işi (oda yoksa `locationText`).
  roomId       String?
  locationText String?
  /// Periyot (gün): 30 ≈ aylık. Bir sonraki üretim = `lastRunOn` + bu.
  intervalDays Int
  priority     Int                 @default(3)
  /// Kontrol listesi maddeleri (string dizisi).
  checklist    Json                @default("[]")
  active       Boolean             @default(true)
  /// En son görev üretilen gün; boşsa ilk turda hemen üretilir.
  lastRunOn    DateTime?           @db.Date
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  hotel   Hotel               @relation(fields: [hotelId], references: [id])
  room    Room?               @relation(fields: [roomId], references: [id])
  tickets MaintenanceTicket[]

  @@index([hotelId, active])
}

/// Bulunan eşya (modül 21). Etiket no (`LF-XXXXXX`) poşetin üstüne yazılır;
/// otel içinde tekil. Eşleşen misafir `guestId` (adaydan seçildiyse konaklaması
/// da). Teslim (`RETURNED`) ve kapatma (`DISPOSED`) izleri eksiksizdir (kısıt).
/// Saklama süresi kolon olarak tutulmaz: otel ayarından ve `businessDate`'ten
/// hesaplanır, ayar değişince bütün açık eşyalara uygulanır.
model LostItem {
  id                String                 @id @default(uuid())
  hotelId           String
  /// Etiket no: "LF-7K2Q9X".
  reference         String
  /// Çift gönderime karşı (formun ürettiği kimlik).
  requestId         String
  description       String
  category          LostItemCategory
  /// Değerli eşya: kasada saklanır, daha uzun tutulur, elden teslimde kimlik görülür.
  valuable          Boolean                @default(false)
  /// Odada bulunduysa oda; ortak alanda bulunduysa `locationText` (ikisinden biri, kısıt).
  roomId            String?
  locationText      String?
  foundAt           DateTime
  /// Bulunduğu iş günü: saklama süresi ve tarih süzgeci bundan.
  businessDate      DateTime               @db.Date
  /// Bulan kişi (sistemde hesabı olmayan personel de olabilir).
  foundByName       String
  /// Eşyanın durduğu yer ("Kasa", "Depo raf B3").
  storageLocation   String
  status            LostItemStatus         @default(STORED)
  guestId           String?
  reservationId     String?
  matchedAt         DateTime?
  matchedBy         String?
  returnMethod      LostItemReturnMethod?
  receiverName      String?
  receiverIdChecked Boolean                @default(false)
  carrier           String?
  trackingNumber    String?
  shippingAddress   String?
  shippingCost      Decimal?               @db.Decimal(12, 2)
  shippingPayer     LostItemShippingPayer?
  returnNote        String?
  disposalMethod    LostItemDisposal?
  disposalReason    String?
  /// Teslim ya da kapatma anı ve yapan (fotoğraflar bundan bir ay sonra silinir).
  closedAt          DateTime?
  closedBy          String?
  photosPurgedAt    DateTime?
  recordedBy        String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  hotel       Hotel           @relation(fields: [hotelId], references: [id])
  room        Room?           @relation(fields: [roomId], references: [id])
  guest       Guest?          @relation(fields: [guestId], references: [id])
  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  photos      LostItemPhoto[]
  notes       LostItemNote[]

  @@unique([hotelId, reference])
  @@unique([hotelId, requestId])
  // Açık liste: son bulunan önce.
  @@index([hotelId, status, foundAt(sort: Desc), id])
  // Süresi dolanlar: (değerli / normal) × bulunduğu gün eşiği.
  @@index([hotelId, status, valuable, businessDate])
  // Teslim edilen / kapatılan: son kapanan önce.
  @@index([hotelId, status, closedAt(sort: Desc), id])
  // Oda geçmişi ve tarih süzgeci.
  @@index([hotelId, roomId, foundAt])
  @@index([hotelId, businessDate])
  // Çıkış penceresinin "teslim bekleyen eşyası var" uyarısı.
  @@index([guestId, status])
  @@index([reservationId, status])
  // Açıklama araması ("siyah cüzdan"). Fotoğraf silme işinin kısmi index'i
  // (`LostItem_photo_purge_idx`) migration'da.
  @@index([description(ops: raw("gin_trgm_ops"))], map: "LostItem_description_trgm_idx", type: Gin)
  @@index([locationText(ops: raw("gin_trgm_ops"))], map: "LostItem_locationText_trgm_idx", type: Gin)
}

/// Kayıp eşyanın fotoğrafı (modül 21). Dosya sunucu diskinde
/// (`lost-items/<otel>/<id>.jpg` ve önizlemesi); yalnızca yetkili personel okur.
model LostItemPhoto {
  id          String   @id @default(uuid())
  hotelId     String
  itemId      String
  contentType String
  sizeBytes   Int
  thumbBytes  Int
  createdBy   String
  createdAt   DateTime @default(now())

  hotel Hotel    @relation(fields: [hotelId], references: [id])
  item  LostItem @relation(fields: [itemId], references: [id])

  @@index([itemId, createdAt])
}

/// Misafirle iletişim notu (modül 21): "aradım, açmadı", "kargo adresini yolladı".
/// Silinmez, değişmez.
model LostItemNote {
  id        String                 @id @default(uuid())
  hotelId   String
  itemId    String
  channel   LostItemContactChannel
  text      String
  createdBy String
  createdAt DateTime               @default(now())

  hotel Hotel    @relation(fields: [hotelId], references: [id])
  item  LostItem @relation(fields: [itemId], references: [id])

  @@index([itemId, createdAt])
}

/// Gelir raporunun kapanmış gün özeti (modül 23): gün × oda tipi × kaynak ×
/// para birimi. Rapor bu tablodan okur; canlı sorgu yalnızca son günleri ve
/// eldeki rezervasyonu tarar (geçmiş büyüdükçe rapor yavaşlamasın). Satırlar
/// zamanlanmış işle yeniden hesaplanır (`modules/reports/stats.js`); kaynak
/// veri (gece, folyo kalemi) değişmez — bu tablo yalnızca özetidir.
model RevenueDayStat {
  id            String            @id @default(uuid())
  hotelId       String
  day           DateTime          @db.Date
  /// Oda tipi kimliği (ilişki yok: silinmiş oda tipinin geçmiş satışı da kalır).
  roomTypeId    String
  source        ReservationSource
  currency      String
  sold          Int
  roomRevenue   Decimal           @db.Decimal(14, 2)
  discounts     Decimal           @db.Decimal(14, 2)
  fees          Decimal           @db.Decimal(14, 2)
  cancellations Decimal           @db.Decimal(14, 2)

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, day, roomTypeId, source, currency])
}

/// Özeti hesaplanmış gün (satışı olmayan gün de işaretlenir). Rapor işaretli
/// günü özetten, işaretsiz günü canlı okur.
model RevenueStatDay {
  hotelId    String
  day        DateTime @db.Date
  computedAt DateTime

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@id([hotelId, day])
  // Kendini onarma turu: en eski hesaplanan gün önce.
  @@index([hotelId, computedAt])
}

/// Otelin AI asistanı ayarları (modül 8). Satır yoksa AI kapalıdır.
///
/// Fiyatlar sağlayıcının 1M token başına USD fiyatıdır; model başına
/// `{ "model": { "input": "0.40", "cachedInput": "0.10", "output": "1.60" } }`.
/// Fiyatı tanımlı olmayan modelle çağrı yapılmaz (maliyet sayılamazsa bütçe
/// denetlenemez). Bütçe 0 ise AI kapalı sayılır.
model AiSettings {
  id                           String            @id @default(uuid())
  hotelId                      String            @unique
  enabled                      Boolean           @default(false)
  /// Niyet sınıflandırma ve özet (küçük model).
  routerModel                  String            @default("")
  /// Misafirle konuşan ajan.
  conciergeModel               String            @default("")
  prices                       Json              @default("{}")
  dailyBudgetUsd               Decimal           @default(0) @db.Decimal(10, 2)
  /// AI'ın açtığı rezervasyon: kesin (onay bildirimi gider) ya da opsiyonlu.
  reservationStatus            ReservationStatus @default(CONFIRMED)
  /// Otelin misafire anlatılabilecek bilgisi (olanaklar, ulaşım, kurallar).
  hotelInfo                    String?
  /// Tek konuşmada günde en fazla AI cevabı (kötüye kullanıma karşı).
  maxRepliesPerConversationDay Int               @default(40)
  updatedBy                    String?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// AI asistanının konuşma başına hafızası (modül 8): özet, son müsaitlik
/// teklifleri, misafire sunulup onay bekleyen teklif, gönderilmiş rezervasyon isteği.
model ConversationAiState {
  conversationId   String    @id
  hotelId          String
  /// Misafirin dili (router'ın tespiti; ISO 639-1).
  language         String?
  lastIntent       String?
  /// Eski mesajların özeti; `summarizedUntil` ve öncesi özette.
  summary          String?
  summarizedUntil  DateTime?
  /// Son müsaitlik sorgusunun seçenekleri (fiyat, tip, tarih).
  offers           Json      @default("[]")
  offersAt         DateTime?
  /// Misafire sunulan ve "evet" bekleyen teklif (misafir bilgisiyle).
  pendingOffer     Json?
  /// Gönderilen rezervasyon isteği; `reservation.created/rejected` bununla eşleşir.
  pendingRequestId String?   @unique
  requestedAt      DateTime?
  /// Günlük cevap sayacı.
  repliesDay       DateTime? @db.Date
  repliesCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotel        Hotel        @relation(fields: [hotelId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([hotelId])
}

/// Mesaj kanalı bağlantısı (modül 8): WhatsApp Cloud API ya da web chat balonu.
///
/// - WhatsApp: `externalAccountId` = Meta telefon numarası kimliği; sırlar
///   (erişim token'ı, uygulama sırrı, webhook doğrulama token'ı) `secret`
///   içinde şifreli JSON. Webhook adresi kayda özel: `/webhooks/whatsapp/{id}`.
/// - Web chat: `publicKey` sitedeki balonun genel anahtarı (gizli değil);
///   `settings.allowedOrigins` balonun gömülebileceği site adresleri.
model MessagingChannel {
  id                String              @id @default(uuid())
  hotelId           String
  channel           NotificationChannel
  enabled           Boolean             @default(false)
  externalAccountId String?             @unique
  publicKey         String?             @unique
  settings          Json                @default("{}")
  secret            String?
  secretUpdatedAt   DateTime?
  lastInboundAt     DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  updatedBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, channel])
}

/// Yılın bütçe sürümü (modül 27). Yıl başına en fazla bir taslak ve bir onaylı
/// (kısmi tekil index'ler, migration). Onaylı sürüm kilitlidir; değişiklik için
/// revize taslağı açılır (satırları kopyalanır), revize onaylanınca önceki
/// onaylı "eski sürüm" olur. Silinmez: sapma raporu geçmişte neye göre
/// çıktığını gösterebilmeli.
model Budget {
  id           String       @id @default(uuid())
  hotelId      String
  year         Int
  /// Yılın içinde 1'den artan sürüm numarası.
  version      Int
  status       BudgetStatus @default(DRAFT)
  /// Revize gerekçesi (ilk sürümde boş).
  reason       String?
  createdBy    String
  approvedAt   DateTime?
  approvedBy   String?
  supersededAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  lines        BudgetLine[]
  commentaries BudgetCommentary[]

  @@unique([hotelId, year, version])
  // Yılın sürümleri (en yeni önce) ve yılın onaylı / taslak sürümü.
  @@index([hotelId, year, status])
}

/// Bütçe satırı: kalem × ay plan değeri. Kalem sistem kalemi kodu
/// (ROOM_REVENUE, OCCUPANCY...) ya da gider kaleminin kimliği. Doluluk yüzde
/// (0–100), diğerleri otelin para biriminde, vergiler hariç.
model BudgetLine {
  id            String   @id @default(uuid())
  hotelId       String
  budgetId      String
  item          String
  expenseItemId String?
  month         Int
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  hotel       Hotel              @relation(fields: [hotelId], references: [id])
  budget      Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  expenseItem BudgetExpenseItem? @relation(fields: [expenseItemId], references: [id], onDelete: Restrict)

  @@unique([budgetId, item, month])
  @@index([expenseItemId])
  @@index([hotelId])
}

/// Otelin gider kalemleri (bütçe sürümlerinden bağımsız: gerçekleşen de
/// bunlara bağlı). Kaldırılan kalem arşivlenir; eski bütçelerde görünmeye devam eder.
model BudgetExpenseItem {
  id         String    @id @default(uuid())
  hotelId    String
  label      String
  sortOrder  Int
  archivedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hotel   Hotel                 @relation(fields: [hotelId], references: [id])
  lines   BudgetLine[]
  actuals BudgetExpenseActual[]

  // Etkin kalemler sırasıyla (bütçe ızgarası, Excel şablonu).
  @@index([hotelId, archivedAt, sortOrder])
}

/// Giderin gerçekleşeni (ay ay elle; satın alma ve ön muhasebe — modül 45 /
/// 47 — gelince oradan hesaplanır). Bütçe sürümünden bağımsızdır.
model BudgetExpenseActual {
  id            String   @id @default(uuid())
  hotelId       String
  expenseItemId String
  year          Int
  month         Int
  amount        Decimal  @db.Decimal(14, 2)
  enteredBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotel       Hotel             @relation(fields: [hotelId], references: [id])
  expenseItem BudgetExpenseItem @relation(fields: [expenseItemId], references: [id], onDelete: Restrict)

  @@unique([expenseItemId, year, month])
  // Yılın gerçekleşenleri (sapma raporu).
  @@index([hotelId, year])
}

/// AI sapma yorumu (modül 27): bir dönem için istenir, ajan (budget-agent)
/// yazar. Aynı dönem için aynı anda tek bekleyen istek (kısmi tekil index).
model BudgetCommentary {
  id            String                 @id @default(uuid())
  hotelId       String
  budgetId      String
  year          Int
  month         Int
  /// MONTH | YTD
  scope         String
  status        BudgetCommentaryStatus @default(PENDING)
  text          String?
  failureReason String?
  model         String?
  requestedBy   String
  requestedAt   DateTime               @default(now())
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  // Dönemin son yorumu.
  @@index([hotelId, year, month, scope, requestedAt(sort: Desc)])
  @@index([budgetId])
}

/// Acente kartı (modül 29): firma, yetkili, iletişim, komisyon, vade. Rezervasyonu olan
/// acente silinmez, pasife alınır. Kod ve ad otel içinde tekil (büyük / küçük harf duyarsız:
/// migration'daki index'ler).
model Agency {
  id              String       @id @default(uuid())
  hotelId         String
  /// Büyük harf kısa kod ("TUI", "ATLAS1").
  code            String
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  taxOffice       String?
  taxNumber       String?
  /// Rezervasyon toplamı üzerinden acenteye komisyon yüzdesi (0–100). Rezervasyon
  /// açılırken rezervasyona kopyalanır: sonradan değişirse geçmiş rezervasyonlar etkilenmez.
  commissionPct   Decimal      @default(0) @db.Decimal(5, 2)
  /// Çıkış gününden sonra ödeme vadesi (gün).
  paymentTermDays Int          @default(0)
  status          AgencyStatus @default(ACTIVE)
  notes           String?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hotel         Hotel             @relation(fields: [hotelId], references: [id])
  contracts     Contract[]
  reservations  Reservation[]
  bonusRules    AgencyBonusRule[]
  bonuses       AgencyBonus[]
  ledgerAccount LedgerAccount?

  // Kod otel içinde tekil. Ad tekilliği (büyük / küçük harf duyarsız) ve arama (trigram): migration.
  @@unique([hotelId, code])
  // Liste: duruma göre, ada göre sıralı.
  @@index([hotelId, status, name])
}

/// Acente kontratı (modül 29): dönem + fiyat satırları + stop-sale. Taslak satışa kapalıdır;
/// aktif kontrat acentenin o günkü satış fiyatını belirler. Acentenin aynı günü kapsayan
/// en fazla bir aktif kontratı olur (EXCLUDE kısıtı, migration). Rezervasyonu olan kontrat
/// silinmez, sonlandırılır (rezervasyonlar fiyatını açıldığı günkü haliyle taşır).
model Contract {
  id          String         @id @default(uuid())
  hotelId     String
  agencyId    String
  name        String
  /// Dönem; iki uç dahil.
  startDate   DateTime       @db.Date
  endDate     DateTime       @db.Date
  status      ContractStatus @default(DRAFT)
  /// Fiyatların para birimi: oluşturulduğu andaki otel parası (çoklu para: modül 60).
  currency    String
  notes       String?
  createdBy   String
  activatedAt DateTime?
  activatedBy String?
  endedAt     DateTime?
  endedBy     String?
  endReason   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  hotel     Hotel              @relation(fields: [hotelId], references: [id])
  agency    Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  rates     ContractRate[]
  stopSales ContractStopSale[]

  // Satış anında "acentenin bu günleri kapsayan aktif kontratı" (sıcak yol) ve acente kartındaki liste.
  @@index([hotelId, agencyId, status, startDate, endDate])
  @@index([hotelId, status, endDate])
}

/// Kontrat fiyat satırı (modül 29): oda tipi × pansiyon × dönem için oda başı gecelik fiyat.
/// Aynı kontratta aynı oda tipi + pansiyon için dönemler çakışmaz (EXCLUDE, migration).
model ContractRate {
  id         String    @id @default(uuid())
  hotelId    String
  contractId String
  roomTypeId String
  boardType  BoardType
  /// Dönem; iki uç dahil.
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  price      Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@index([contractId, roomTypeId, boardType, startDate, endDate])
  @@index([hotelId, roomTypeId])
}

/// Kontrat stop-sale'i (modül 29): bu günlerde acente satamaz. Oda tipi boşsa kontratın
/// bütün oda tipleri. Aynı kapsamda çakışan kayıt olmaz (EXCLUDE, migration).
model ContractStopSale {
  id         String   @id @default(uuid())
  hotelId    String
  contractId String
  roomTypeId String?
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  createdBy  String
  createdAt  DateTime @default(now())

  hotel    Hotel     @relation(fields: [hotelId], references: [id])
  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@index([contractId, startDate, endDate])
  @@index([hotelId, roomTypeId])
}

/// Promosyon (modül 31): koşulu tutan doğrudan satışa kendiliğinden (`requiresCoupon = false`)
/// ya da kuponla uygulanan indirim. Bir rezervasyona tek indirim düşer (en avantajlısı);
/// acente satışına uygulanmaz. Rezervasyon açılırken koşullarıyla kopyalanır. Kullanılmış
/// promosyon silinmez, durdurulur. Tutarlılık kısıtları ve ad tekilliği migration'da.
model Promotion {
  id             String                @id @default(uuid())
  hotelId        String
  name           String
  notes          String?
  status         PromotionStatus       @default(DRAFT)
  requiresCoupon Boolean               @default(false)
  discountType   PromotionDiscountType
  /// Yüzde (0–100] ya da konaklama başına tutar; "X kal Y öde"de boş.
  discountValue  Decimal?              @db.Decimal(12, 2)
  /// "X gece kal Y gece öde": X ve Y (yalnızca FREE_NIGHTS).
  stayNights     Int?
  payNights      Int?
  /// Rezervasyonun yapıldığı (satış) gün aralığı; iki uç dahil, boşsa sınırsız.
  bookFrom       DateTime?             @db.Date
  bookTo         DateTime?             @db.Date
  /// İndirimin düştüğü geceler; iki uç dahil, boşsa sınırsız.
  stayFrom       DateTime?             @db.Date
  stayTo         DateTime?             @db.Date
  minNights      Int?
  maxNights      Int?
  /// Erken rezervasyon: girişe en az bu kadar gün kala. Son dakika: en fazla.
  minLeadDays    Int?
  maxLeadDays    Int?
  /// Boşsa bütün oda tipleri / pansiyonlar.
  roomTypeIds    String[]              @default([])
  boardTypes     BoardType[]           @default([])
  /// Uygulandığı satış kanalları (acente hiçbir zaman).
  sources        ReservationSource[]
  createdBy      String
  activatedAt    DateTime?
  activatedBy    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  coupons      Coupon[]
  reservations Reservation[]

  // Satışta değerlendirilen promosyonlar: yayındaki, kendiliğinden uygulananlar.
  @@index([hotelId, status, requiresCoupon])
  // Liste: ada göre sıralı. Ad tekilliği (büyük / küçük harf duyarsız) ve arama (trigram): migration.
  @@index([hotelId, name])
}

/// Kupon (modül 31): bir promosyonu kodla açar. Kod otel içinde tekil. Kullanım = kuponla
/// açılmış geçerli (iptal / gelmedi olmayan) rezervasyon sayısı — sayaç tutulmaz, kupon
/// satırı kilitlenip sayılır (iptalde hak kendiliğinden geri açılır). Her oda bir kullanım.
model Coupon {
  id          String   @id @default(uuid())
  hotelId     String
  promotionId String
  /// Büyük harf, harf / rakam / tire.
  code        String
  /// Boşsa sınırsız; 1 = tek kullanımlık.
  maxUses     Int?
  isActive    Boolean  @default(true)
  /// Aynı seferde üretilen kodlar (dağıtım için dışa aktarma bu kimlikle).
  batchId     String
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  promotion    Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([hotelId, code])
  // Promosyonun kuponları (sayfalı), üretimin kodları.
  @@index([hotelId, promotionId, createdAt, id])
  @@index([promotionId, batchId])
}

/**
 * ══════════════════ Kanal yönetimi (modül 33) ══════════════════
 */

/// Kanal türü: Channex (OTA'lara aracı) ya da iCal takvimi.
enum ChannelType {
  CHANNEX
  ICAL
}

/// DRAFT: kuruluyor. ACTIVE: senkronda. PAUSED: durduruldu (hiçbir şey gitmez / gelmez).
enum ChannelStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ChannexEnvironment {
  STAGING
  PRODUCTION
}

/// iCal takviminin geldiği yer (Airbnb rezervasyonu kapatmadan ayırır).
enum IcalProvider {
  AIRBNB
  BOOKING
  OTHER
}

enum ChannelSyncKind {
  DELTA
  FULL
  BOOKINGS
  ICAL_IMPORT
  SETUP
}

enum ChannelSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum ChannelSyncTrigger {
  CHANGE
  SCHEDULE
  MANUAL
  WEBHOOK
}

/// Kanala en son gönderilen değerin türü: oda tipine müsaitlik, fiyat planına fiyat + stop-sale.
enum ChannelAriKind {
  AVAILABILITY
  RATE
}

/// Kanal rezervasyonunun bizdeki durumu (bkz. sözleşme `CHANNEL_BOOKING_STATES`).
enum ChannelBookingState {
  PENDING
  PROCESSED
  REVIEW
  ATTENTION
}

/// Kanaldaki durumu.
enum ChannelBookingStatus {
  ACTIVE
  CANCELLED
}

enum ChannelRevisionKind {
  NEW
  MODIFIED
  CANCELLED
}

/// Satış kanalı (modül 33). Channex: OTA'lara (Booking, Expedia, Airbnb…) aracı; müsaitlik
/// oda tipine, fiyat ve stop-sale fiyat planına gider, rezervasyonlar revizyon akışından
/// alınır. iCal: kanal takvimimizi okur (dışa aktarma), biz kanalınkini okuruz (içe aktarma).
///
/// Gönderim "fark" ile yapılır: değişiklikler kanalı kirli işaretler (`dirtyFrom` /
/// `dirtyTo`), zamanlanmış iş penceredeki değerleri hesaplayıp kanala en son gönderilenle
/// (`ChannelAriState`) karşılaştırır, yalnızca farkı gönderir. Silme yumuşaktır (log ve
/// rezervasyon bağları kalır). Ad tekilliği (büyük / küçük harf duyarsız) ve Channex mülkünün
/// tek kanala bağlanması: kısmi index'ler (migration).
model Channel {
  id                 String              @id @default(uuid())
  hotelId            String
  type               ChannelType
  name               String
  status             ChannelStatus       @default(DRAFT)
  /// Channex: ortam, mülk, şifreli API anahtarı (secret-box), webhook kimliği ve şifreli sırrı.
  environment        ChannexEnvironment?
  propertyId         String?
  apiKey             String?
  webhookId          String?
  webhookSecret      String?
  /// Channex mülkünün adı ve para birimi (bağlantı denetiminde okunur).
  externalName       String?
  externalCurrency   String?
  /// iCal: takvimin geldiği yer.
  provider           IcalProvider?
  /// Kanala giden fiyat = liste fiyatı × (1 + fark / 100).
  priceMarkupPercent Decimal             @default(0) @db.Decimal(5, 2)
  /// Kaç gün ileriye gönderilir / dışa aktarılır.
  horizonDays        Int
  activatedAt        DateTime?
  activatedBy        String?
  createdBy          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  hotel     Hotel                    @relation(fields: [hotelId], references: [id])
  state     ChannelState?
  rooms     ChannelRoomMapping[]
  rates     ChannelRateMapping[]
  ariStates ChannelAriState[]
  stopSales ChannelStopSale[]
  logs      ChannelSyncLog[]
  bookings  ChannelBooking[]
  revisions ChannelBookingRevision[]

  @@index([hotelId, deletedAt, name])
  // Zamanlanmış işlerin taraması: senkrondaki kanallar.
  @@index([status, type])
}

/// Kanalın gönderim / alım durumu (modül 33). Ayardan ayrı tutulur: kanal ayarının sürümü
/// (`Channel.updatedAt`, optimistic lock) her gönderimde ilerlemesin — ayar formu açık
/// duran yönetici, arka planda giden bir gönderim yüzünden "kayıt değişti" görmesin.
model ChannelState {
  channelId           String              @id
  hotelId             String
  /// Gönderilecek değişiklik penceresi (otelin günleri, iki uç dahil; ikisi de boşsa temiz).
  dirtyFrom           DateTime?           @db.Date
  dirtyTo             DateTime?           @db.Date
  /// Tam eşitleme istendi (senkrona alma, eşleştirme, elle); sebebi ve tetikleyeni loga yazılır.
  fullSyncRequestedAt DateTime?
  fullSyncReason      String?
  fullSyncTrigger     ChannelSyncTrigger?
  lastFullSyncAt      DateTime?
  lastDeltaAt         DateTime?
  lastBookingPollAt   DateTime?
  lastIcalImportAt    DateTime?
  /// Son işin zamanı ve sonucu (kanal listesinde).
  lastSyncAt          DateTime?
  lastSyncStatus      ChannelSyncStatus?
  /// Hız sınırı ya da art arda hata: bu ana kadar gönderim yapılmaz.
  pausedUntil         DateTime?
  failureCount        Int                 @default(0)
  lastError           String?
  lastErrorAt         DateTime?
  updatedAt           DateTime            @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

/// Bizim oda tipi ↔ kanalın oda tipi (Channex) ya da iCal takvimi (bir ilan / tip).
/// Eşleştirme kaydı oda tipiyle tekildir ve yeniden kaydedilince korunur: iCal dışa aktarma
/// adresinin belirteci (`exportToken`) kanala verildiği için değişmemeli.
model ChannelRoomMapping {
  id                 String    @id @default(uuid())
  hotelId            String
  channelId          String
  roomTypeId         String
  externalRoomTypeId String?
  externalName       String?
  /// iCal: kanalın takvim adresi (içe aktarma); boşsa yalnızca dışa aktarılır.
  icalImportUrl      String?
  /// iCal dışa aktarma adresinin gizli belirteci.
  exportToken        String?   @unique
  lastImportAt       DateTime?
  lastImportError    String?
  /// iCal: kanalın dışa aktarma takvimini en son okuduğu an.
  lastExportAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  channel  Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomType RoomType             @relation(fields: [roomTypeId], references: [id])
  rates    ChannelRateMapping[]

  @@unique([channelId, roomTypeId])
  @@unique([channelId, externalRoomTypeId])
  @@index([hotelId, roomTypeId])
}

/// Kanalın fiyat planı ↔ bizim oda tipi + pansiyon (Channex). Gelen rezervasyonun pansiyonu buradan.
model ChannelRateMapping {
  id                 String    @id @default(uuid())
  hotelId            String
  channelId          String
  roomMappingId      String
  externalRatePlanId String
  externalName       String?
  boardType          BoardType
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  channel     Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomMapping ChannelRoomMapping @relation(fields: [roomMappingId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalRatePlanId])
  @@index([roomMappingId])
}

/// Kanala en son başarıyla gönderilen değerler (gün → değer): fark bununla hesaplanır.
/// Kanalın kimliğiyle tutulur (eşleştirme yeniden kaydedilse de geçerli kalır).
model ChannelAriState {
  id         String         @id @default(uuid())
  channelId  String
  kind       ChannelAriKind
  externalId String
  sent       Json           @default("{}")
  updatedAt  DateTime       @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, kind, externalId])
}

/// Kanala özel satış kapatma (iki uç dahil). Oda tipleri boşsa kanaldaki bütün tipler.
model ChannelStopSale {
  id          String   @id @default(uuid())
  hotelId     String
  channelId   String
  roomTypeIds String[] @default([])
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  createdBy   String
  createdAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, endDate])
}

/// Senkron logu: ne gönderildi / alındı, sonuç, kanalın uyarıları ve hata. 90 gün saklanır.
model ChannelSyncLog {
  id          String             @id @default(uuid())
  hotelId     String
  channelId   String
  kind        ChannelSyncKind
  status      ChannelSyncStatus
  trigger     ChannelSyncTrigger
  summary     String
  details     Json               @default("{}")
  error       String?
  /// Kanalın iş kimlikleri (Channex "task" kimliği; destek talebinde istenir).
  externalIds String[]           @default([])
  windowFrom  DateTime?          @db.Date
  windowTo    DateTime?          @db.Date
  durationMs  Int
  createdAt   DateTime           @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc), id])
  @@index([channelId, kind, createdAt])
  @@index([channelId, status, createdAt])
  @@index([createdAt])
}

/// Kanaldaki rezervasyon (OTA rezervasyonu ya da iCal kaydı) ve bizdeki karşılığı. Her oda
/// ayrı bir `Reservation`dır (`channelRoomIndex`). Revizyonlar sırayla uygulanır; eski
/// revizyon yenisinin üstüne yazılmaz (`appliedRevisionAt`).
model ChannelBooking {
  id                String               @id @default(uuid())
  hotelId           String
  channelId         String
  externalBookingId String
  externalCode      String?
  otaName           String?
  status            ChannelBookingStatus @default(ACTIVE)
  state             ChannelBookingState  @default(PENDING)
  stateReason       String?
  guestName         String?
  checkIn           DateTime?            @db.Date
  checkOut          DateTime?            @db.Date
  roomCount         Int                  @default(1)
  amount            Decimal?             @db.Decimal(12, 2)
  currency          String?
  appliedRevisionAt DateTime?
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionNote    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  channel      Channel                  @relation(fields: [channelId], references: [id], onDelete: Restrict)
  revisions    ChannelBookingRevision[]
  reservations Reservation[]

  @@unique([channelId, externalBookingId])
  @@index([channelId, createdAt(sort: Desc), id])
  // Dikkat isteyenler (rozet ve süzgeç).
  @@index([hotelId, state, updatedAt])
}

/// Kanaldan gelen revizyon (yeni / değişiklik / iptal): kalıcı olarak saklanır, kanala
/// teyit edilir, sonra aktör işler. Kart bilgisi saklanmaz (normalleştirilmiş gövde).
model ChannelBookingRevision {
  id                 String              @id @default(uuid())
  hotelId            String
  channelId          String
  bookingId          String
  externalRevisionId String
  kind               ChannelRevisionKind
  occurredAt         DateTime
  payload            Json
  receivedAt         DateTime            @default(now())
  processedAt        DateTime?
  outcome            String?
  error              String?

  channel Channel        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  booking ChannelBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([channelId, externalRevisionId])
  @@index([bookingId, occurredAt])
}

/// Acente hedef / prim kuralı (modül 35): acentenin bir dönemdeki gece ya da ciro hedefi ve
/// kademeli prim oranları. Üretim = dönemde gerçekleşen geceler; ciro = bu gecelerin folyoya
/// işlenen vergisiz oda geliri. İlerleme özeti (`progress*`) zamanlanmış işte ham SQL ile
/// yazılır: `updatedAt`'e dokunmaz (formdaki sürüm kontrolünü bozmaz).
model AgencyBonusRule {
  id              String                @id @default(uuid())
  hotelId         String
  agencyId        String
  name            String
  /// Dönem (iki uç dahil, otelin günü).
  startDate       DateTime              @db.Date
  endDate         DateTime              @db.Date
  metric          AgencyBonusMetric
  mode            AgencyBonusMode
  /// Ticari hedef (puan = gerçekleşen / hedef). Gece ölçütünde tam sayı.
  target          Decimal               @db.Decimal(14, 2)
  /// Kademeler: [{ threshold, ratePct }] — eşik kesin artan, oran azalmaz (sözleşmede denetlenir).
  tiers           Json
  /// Boşsa bütün oda tipleri sayılır.
  roomTypeIds     String[]              @default([])
  /// Prim tavanı; boşsa tavansız.
  maxBonus        Decimal?              @db.Decimal(12, 2)
  currency        String
  notes           String?
  status          AgencyBonusRuleStatus @default(DRAFT)
  createdBy       String
  activatedAt     DateTime?
  activatedBy     String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  /// İlerleme özeti (gerçekleşen; zamanlanmış iş tazeler): liste sıralaması ve kademe uyarısı.
  progressNights  Int                   @default(0)
  progressRevenue Decimal               @default(0) @db.Decimal(14, 2)
  /// Gerçekleşen / hedef × 100.
  progressScore   Decimal               @default(0) @db.Decimal(9, 2)
  /// Ulaşılan kademe (0 = yok, 1..n). Yükselince bir kez uyarı düşer.
  reachedTier     Int                   @default(0)
  progressAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  hotel  Hotel        @relation(fields: [hotelId], references: [id])
  agency Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  bonus  AgencyBonus?
  // Ada göre arama (trigram) ve aynı acentenin aynı ölçütte çakışan yürürlükteki kuralı: migration.

  // Acentenin kuralları (kartta) ve çakışma denetimi.
  @@index([hotelId, agencyId, startDate])
  // Liste: duruma göre dönem sonu ya da hedefe ulaşma sırasıyla (imleç: id).
  @@index([hotelId, status, endDate, id])
  @@index([hotelId, status, progressScore, id])
  // Kural adıyla arama (trigram). Aynı acentenin aynı ölçütte çakışan yürürlükteki kuralı
  // olamaz: EXCLUDE kısıtı (migration).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "AgencyBonusRule_name_trgm_idx", type: Gin)
}

/// Dönem sonu hak edişi (modül 35): kuralın hesap anındaki kopyası ve sonucu. Kural başına bir
/// tane; yeniden hesaplama aynı satırı günceller (`revision` artar), onaylanınca kilitlenir.
model AgencyBonus {
  id               String            @id @default(uuid())
  hotelId          String
  ruleId           String            @unique
  agencyId         String
  status           AgencyBonusStatus @default(DRAFT)
  /// Yeniden açıldıkça artar (1'den başlar).
  revision         Int               @default(1)
  /// Kuralın hesap anındaki kopyası (kural sonradan değişse de bu hak ediş değişmez).
  periodStart      DateTime          @db.Date
  periodEnd        DateTime          @db.Date
  metric           AgencyBonusMetric
  mode             AgencyBonusMode
  target           Decimal           @db.Decimal(14, 2)
  tiers            Json
  roomTypeIds      String[]          @default([])
  maxBonus         Decimal?          @db.Decimal(12, 2)
  currency         String
  /// Hesaplanan kuralın sürümü: kural sonra değiştiyse hak ediş bayattır (onaya gönderilemez).
  ruleUpdatedAt    DateTime
  /// Sonuç: gerçekleşen gece, vergisiz oda geliri, hedefe ulaşma, kademe, prim.
  nights           Int
  revenue          Decimal           @db.Decimal(14, 2)
  scorePct         Decimal           @db.Decimal(9, 2)
  /// Ulaşılan kademe (0 = yok).
  tierIndex        Int
  /// Tavandan önceki prim ve ödenecek prim.
  grossAmount      Decimal           @db.Decimal(12, 2)
  amount           Decimal           @db.Decimal(12, 2)
  capped           Boolean           @default(false)
  /// Dilim dökümü: [{ tier, ratePct, base, amount, nights? }].
  slices           Json
  reservationCount Int
  /// Gerçekleşmiş ama oda ücreti folyoya işlenmemiş gece (ciro eksik olabilir uyarısı).
  missingPostings  Int               @default(0)
  calculatedAt     DateTime
  calculatedBy     String
  submittedAt      DateTime?
  submittedBy      String?
  submitNote       String?
  approvalId       String?
  approvedAt       DateTime?
  approvedBy       String?
  /// Son kararın notu (ret gerekçesi, süre dolumu, onay notu).
  decisionNote     String?
  /// Ödeme (muhasebe işaretler; cari düşümü modül 47).
  paidAt           DateTime?         @db.Date
  paidBy           String?
  paidRecordedAt   DateTime?
  paymentRef       String?
  paymentNote      String?
  reopenedAt       DateTime?
  reopenedBy       String?
  reopenReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  hotel    Hotel             @relation(fields: [hotelId], references: [id])
  rule     AgencyBonusRule   @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  agency   Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  approval Approval?         @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  lines    AgencyBonusLine[]

  // Hak ediş raporu: duruma göre, dönem sonuna göre (imleç: id); acentenin hak edişleri.
  @@index([hotelId, status, periodEnd, id])
  @@index([hotelId, periodEnd, id])
  @@index([hotelId, agencyId, periodEnd])
  // Onay kararı geldiğinde hak edişi bulmak.
  @@index([approvalId])
}

/// Hak edişin dayandığı rezervasyonlar (hesap anında dondurulur): dönemdeki gerçekleşen gece ve
/// vergisiz oda geliri. Denetim ve itiraz için "hangi rezervasyonlar sayıldı" sorusunun cevabı.
model AgencyBonusLine {
  id            String  @id @default(uuid())
  hotelId       String
  bonusId       String
  reservationId String
  nights        Int
  revenue       Decimal @db.Decimal(14, 2)

  bonus       AgencyBonus @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([bonusId, reservationId])
  // Döküm: ciroya ya da geceye göre büyükten küçüğe (imleç: id).
  @@index([bonusId, revenue, id])
  @@index([bonusId, nights, id])
  // Rezervasyonun hangi hak edişlere girdiği.
  @@index([reservationId])
}

/// Salon (modül 37). Bölünebilir salon: bütün (`parentId` boş, parçaları var) ve parçaları
/// (`parentId` = bütün). Bütün satılınca parçaları da dolar; parça satılınca bütün dolar —
/// salon tutma satırları "atomik parça" başına yazıldığı için veritabanı kısıtı bunu da korur.
model Venue {
  id              String      @id @default(uuid())
  hotelId         String
  code            String
  name            String
  description     String?
  parentId        String?
  areaSqm         Decimal?    @db.Decimal(8, 2)
  hourlyRate      Decimal?    @db.Decimal(12, 2)
  halfDayRate     Decimal?    @db.Decimal(12, 2)
  dayRate         Decimal?    @db.Decimal(12, 2)
  /// Oturumdan önce / sonra salonun hazırlık süresi (dakika): salon bu sürede de doludur.
  setupMinutes    Int         @default(60)
  teardownMinutes Int         @default(60)
  status          VenueStatus @default(ACTIVE)
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  hotel      Hotel            @relation(fields: [hotelId], references: [id])
  parent     Venue?           @relation("VenueParts", fields: [parentId], references: [id], onDelete: Restrict)
  parts      Venue[]          @relation("VenueParts")
  capacities VenueCapacity[]
  sessions   EventSession[]
  holds      EventVenueHold[]

  @@unique([hotelId, code])
  @@index([hotelId, status, code])
  @@index([parentId])
}

/// Salonun düzene göre kapasitesi.
model VenueCapacity {
  id       String      @id @default(uuid())
  venueId  String
  layout   VenueLayout
  capacity Int

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, layout])
}

/// Banket ekipmanı (projeksiyon, ses sistemi, sahne…): stoklu; aynı saatte stoktan fazlası ayrılamaz.
model EventEquipment {
  id            String   @id @default(uuid())
  hotelId       String
  code          String
  name          String
  unitPrice     Decimal  @db.Decimal(12, 2)
  stockQuantity Int
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotel Hotel       @relation(fields: [hotelId], references: [id])
  items EventItem[]

  @@unique([hotelId, code])
  @@index([hotelId, isActive, name])
}

/// Etkinlik müşterisi (firma ya da kişi): tekrar eden müşteri için kart.
model EventClient {
  id          String          @id @default(uuid())
  hotelId     String
  type        EventClientType
  name        String
  contactName String?
  phone       String?
  email       String?
  taxOffice   String?
  taxNumber   String?
  address     String?
  notes       String?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  hotel         Hotel          @relation(fields: [hotelId], references: [id])
  events        Event[]
  ledgerAccount LedgerAccount?

  @@index([hotelId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "EventClient_name_trgm_idx", type: Gin)
}

/// Otelin banket politikası (tek satır): opsiyon süresi, teklif geçerliliği, depozito, iptal kademeleri.
model EventSettings {
  hotelId               String   @id
  optionDays            Int      @default(7)
  offerValidityDays     Int      @default(14)
  depositPct            Decimal  @default(30) @db.Decimal(5, 2)
  requireSignedContract Boolean  @default(true)
  /// [{ daysBefore, feePct }]: etkinliğe en az N gün kala iptalde bedel yüzdesi.
  cancellationTiers     Json     @default("[]")
  contractTerms         String?
  /// Banket F&B (modül 43): mutfağın garanti üstüne hazırladığı pay (%) ve menünün etkinlikten kaç gün önce
  /// mutfağa kesinleşmesi gerektiği (0 = hatırlatma yok).
  overproductionPct     Decimal  @default(5) @db.Decimal(5, 2)
  menuFinalizeDays      Int      @default(7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Numara serisi (otel × tür × yıl): etkinlik, teklif, sözleşme, proforma.
model EventSequence {
  hotelId String
  kind    String
  year    Int
  last    Int

  @@id([hotelId, kind, year])
}

/// Etkinlik dosyası (modül 37). Tutarlar kalemlerden ve ödemelerden yeniden hesaplanan
/// denormalize toplamlardır (kalem / kişi / ödeme yazan işlem aynı transaction'da yazar).
model Event {
  id                String      @id @default(uuid())
  hotelId           String
  code              String
  name              String
  type              EventType
  clientId          String
  /// Satış sorumlusu (personel e-postası).
  ownerEmail        String
  status            EventStatus @default(INQUIRY)
  expectedPax       Int
  guaranteedPax     Int?
  actualPax         Int?
  /// Faturalanacak kişi (kişi başı kalemlerin miktarı): kesin öncesi garanti ya da tahmin,
  /// gerçekleşince en çok (garanti, gerçekleşen).
  billablePax       Int         @default(0)
  /// Opsiyonun son günü (dahil) ve opsiyona alındığı an (opsiyon sırası için).
  optionUntil       DateTime?   @db.Date
  optionedAt        DateTime?
  /// Oturumların kapsadığı aralık (liste ve takvim için).
  firstStartAt      DateTime?
  lastEndAt         DateTime?
  currency          String
  netTotal          Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal     @default(0) @db.Decimal(14, 2)
  grandTotal        Decimal     @default(0) @db.Decimal(14, 2)
  /// Bakiyeye girmiş ödemelerin toplamı (tahsilat − iade ± iptal).
  paidTotal         Decimal     @default(0) @db.Decimal(14, 2)
  /// Kesinleşirken politikadan kopyalanan iptal kademeleri ve iptalde hesaplanan bedel.
  cancellationTiers Json?
  cancellationFee   Decimal?    @db.Decimal(14, 2)
  definiteAt        DateTime?
  definiteBy        String?
  completedAt       DateTime?
  completedBy       String?
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?
  lostAt            DateTime?
  lostBy            String?
  lostReason        String?
  notes             String?
  createdBy         String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  hotel                Hotel                 @relation(fields: [hotelId], references: [id])
  client               EventClient           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessions             EventSession[]
  holds                EventVenueHold[]
  items                EventItem[]
  installments         EventInstallment[]
  payments             EventPayment[]
  documents            EventDocument[]
  invoices             Invoice[]
  menus                EventMenu[]
  purchaseRequestLines PurchaseRequestLine[]

  @@unique([hotelId, code])
  // Liste: duruma göre / tarihe göre (imleç: id); müşterinin ve sorumlunun etkinlikleri.
  @@index([hotelId, status, firstStartAt, id])
  @@index([hotelId, firstStartAt, id])
  @@index([hotelId, clientId, firstStartAt])
  @@index([hotelId, ownerEmail, firstStartAt])
  // Opsiyon süresi dolumu taraması.
  @@index([status, optionUntil])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Event_name_trgm_idx", type: Gin)
}

/// Etkinliğin oturumu (program satırı): salon × saat × düzen × kişi. Saatler gerçek an (UTC).
model EventSession {
  id              String      @id @default(uuid())
  hotelId         String
  eventId         String
  title           String
  venueId         String
  layout          VenueLayout
  pax             Int
  startAt         DateTime
  endAt           DateTime
  setupMinutes    Int
  teardownMinutes Int
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  holds EventVenueHold[]
  items EventItem[]
  menus EventMenu[]

  @@index([eventId, startAt])
  @@index([hotelId, venueId, startAt])
}

/// Salon tutma: oturumun kapladığı her atomik salon parçası için bir satır (kurulum ve söküm
/// dahil aralık). Kesin tutmalar çakışamaz (EXCLUDE); opsiyonlar çakışır, sırası `heldAt`.
model EventVenueHold {
  id        String          @id @default(uuid())
  hotelId   String
  eventId   String
  sessionId String
  venueId   String
  startAt   DateTime
  endAt     DateTime
  status    EventHoldStatus
  /// Opsiyon sırası bu ana göre (önce tutan önde). Oturumun salonu / saati değişince yenilenir.
  heldAt    DateTime
  createdAt DateTime        @default(now())

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  venue   Venue        @relation(fields: [venueId], references: [id], onDelete: Restrict)

  // Takvim ve çakışma: salonun belli aralıktaki tutmaları.
  @@index([hotelId, venueId, startAt, endAt])
  // Otelin takvim penceresi: "pencere başında sonra biten" tutmalar — geçmiş birikse de tarama gelecek ufkuyla sınırlı.
  @@index([hotelId, endAt])
  @@index([eventId])
  @@index([sessionId])
}

/// Etkinlik kalemi. Tutarlar folyonun vergi motoruyla hesaplanıp yazılır (kişi başı kalemde
/// miktar faturalanacak kişi sayısıdır: `billedQuantity`).
model EventItem {
  id             String            @id @default(uuid())
  hotelId        String
  eventId        String
  sessionId      String?
  equipmentId    String?
  category       EventItemCategory
  description    String
  perPerson      Boolean           @default(false)
  quantity       Decimal           @db.Decimal(12, 2)
  billedQuantity Decimal           @db.Decimal(12, 2)
  unit           EventItemUnit
  unitPrice      Decimal           @db.Decimal(12, 2)
  discountPct    Decimal           @default(0) @db.Decimal(5, 2)
  taxCategory    String
  netAmount      Decimal           @db.Decimal(14, 2)
  taxAmount      Decimal           @db.Decimal(14, 2)
  total          Decimal           @db.Decimal(14, 2)
  taxLines       Json              @default("[]")
  sortOrder      Int
  /// Menüden gelen kişi başı kalem (modül 43): menü sekmesinde düzenlenir, kalem tablosunda salt okunur.
  eventMenuId    String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session   EventSession?   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  equipment EventEquipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  eventMenu EventMenu?      @relation(fields: [eventMenuId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  // Ekipman stoku: aynı ekipmanın oturumlardaki ayrımları.
  @@index([equipmentId, sessionId])
  @@index([sessionId])
}

/// Ödeme planı taksiti (depozito, ara ödeme, kalan). Ödenen tutar vadesi eskiden yeniye dağıtılır.
model EventInstallment {
  id        String   @id @default(uuid())
  hotelId   String
  eventId   String
  label     String
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  sortOrder Int
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, dueDate])
  // Gecikme taraması.
  @@index([hotelId, dueDate])
}

/// Etkinlik ödemesi (depozito, ödeme, iade, iptal kaydı). Kasa ekranına (modül 17) "Etkinlik"
/// kaynağıyla girer. Kurallar konaklama tahsilatıyla aynı: büyük ödeme ve iade onaya gider,
/// iptal ters kayıtla yapılır (dört göz).
model EventPayment {
  id              String        @id @default(uuid())
  hotelId         String
  eventId         String
  kind            PaymentKind   @default(PAYMENT)
  status          PaymentStatus @default(POSTED)
  method          PaymentMethod
  /// Tahsilatta artı, iadede eksi; iptal kaydında asıl satırın tersi.
  amount          Decimal       @db.Decimal(14, 2)
  currency        String
  businessDate    DateTime      @db.Date
  reference       String?
  note            String?
  sourceKey       String?
  receivedBy      String
  receivedAt      DateTime      @default(now())
  postedAt        DateTime?
  approvalId      String?
  declinedAt      DateTime?
  reversalOfId    String?       @unique
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  voidApprovalId  String?
  voidRequestedAt DateTime?
  voidRequestedBy String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hotel      Hotel         @relation(fields: [hotelId], references: [id])
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  approval   Approval?     @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  reversalOf EventPayment? @relation("EventPaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal   EventPayment? @relation("EventPaymentReversal")

  @@unique([hotelId, sourceKey])
  @@index([eventId, receivedAt, id])
  // Kasa: günün işlenen hareketleri ve onay bekleyenler.
  @@index([hotelId, businessDate, postedAt, id])
  @@index([hotelId, status, receivedAt])
  @@index([approvalId])
  @@index([voidApprovalId])
}

/// Etkinlik belgesi (teklif, sözleşme, proforma): üretildiği andaki veriyle dondurulmuş ve PDF'i
/// sunucu diskinde saklanan sürüm.
model EventDocument {
  id           String              @id @default(uuid())
  hotelId      String
  eventId      String
  kind         EventDocumentKind
  number       String
  version      Int
  status       EventDocumentStatus @default(ISSUED)
  snapshot     Json
  fileKey      String
  fileSize     Int
  grandTotal   Decimal             @db.Decimal(14, 2)
  validUntil   DateTime?           @db.Date
  /// Kabul / ret / imza kaydı (gün ve kaydeden).
  decisionDate DateTime?           @db.Date
  decidedBy    String?
  decidedAt    DateTime?
  note         String?
  issuedBy     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([hotelId, number])
  @@unique([eventId, kind, version])
  @@index([eventId, kind, createdAt])
}

/**
 * ════════════════════════════════════════════════════════════════════════
 * Restoran POS (modül 39) ve menü (modül 38'in menü kısmı)
 * ════════════════════════════════════════════════════════════════════════
 */

/// Ürünün hazırlandığı istasyon: mutfak ekranı (modül 40) bu alana göre süzer; NONE mutfağa gitmez.
enum PosStation {
  HOT
  COLD
  BAR
  PASTRY
  NONE
}

/// Açık → kapandı (bakiye sıfır); hiç kalemi olmayan adisyon "iptal (boş)" kapanır.
enum PosCheckStatus {
  OPEN
  CLOSED
  VOID
}

/// Sipariş turunun mutfak durumu (modül 40 ilerletir): yeni → hazırlanıyor → hazır → servis edildi.
enum PosOrderStatus {
  NEW
  PREPARING
  READY
  SERVED
}

/// İkram (kalem bedava), iptal (kalem düşer; zayi işaretlenebilir), indirim (adisyona).
enum PosAdjustmentKind {
  COMP
  VOID
  DISCOUNT
}

/// Eşik altı düzeltme hemen uygulanır; eşik üstü onay bekler (dört göz).
enum PosAdjustmentStatus {
  APPLIED
  PENDING
  DECLINED
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

/// Satış noktasının türü: masalı salon (restoran, bar) ya da oda servisi (masasız; teslim panosuyla, modül 41).
enum PosOutletKind {
  DINING
  ROOM_SERVICE
}

/// Menüde görünmeyen, sistemin eklediği ürün (oda servisi tepsi ücreti; fiyatı politikadan).
enum PosSystemItem {
  TRAY_CHARGE
}

/// Oda servisi siparişinin kaynağı: personel (telefon, kat), misafirin QR bağlantısı, misafir isteği (modül 7).
enum RoomServiceSource {
  STAFF
  GUEST
  REQUEST
}

/// Oda servisi akışı (modül 41): misafirden gelen kabul bekler (REQUESTED); ileri saatli olan zamanı gelince
/// mutfağa düşer (SCHEDULED); mutfakta → hazırlanıyor → hazır → yolda → teslim. İptal teslimden önce; ret kabulden önce.
enum RoomServiceStatus {
  REQUESTED
  SCHEDULED
  RECEIVED
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
  REJECTED
}

/// Satış noktası (restoran, lobi bar, havuz bar).
model PosOutlet {
  id              String        @id @default(uuid())
  hotelId         String
  code            String
  name            String
  /// İçerideki misafirin folyosuna yazılabilir mi.
  allowRoomCharge Boolean       @default(true)
  /// Salon (masa planı) ya da oda servisi (teslim panosu; odaya yazma açık olmalı).
  kind            PosOutletKind @default(DINING)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hotel             Hotel              @relation(fields: [hotelId], references: [id])
  tables            PosTable[]
  checks            PosCheck[]
  shifts            PosShift[]
  orders            PosOrder[]
  roomServiceOrders RoomServiceOrder[]

  @@unique([hotelId, code])
  @@index([hotelId, isActive, sortOrder])
}

model PosTable {
  id        String   @id @default(uuid())
  hotelId   String
  outletId  String
  name      String
  seats     Int      @default(4)
  /// Masa planında bölüm (iç salon, teras, bahçe).
  zone      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet PosOutlet  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  checks PosCheck[]

  @@unique([outletId, name])
  @@index([hotelId, outletId, sortOrder])
}

/// Menü grubu (modül 38'in menü kısmı). `outletIds` boşsa bütün satış noktalarında satılır.
model MenuCategory {
  id        String   @id @default(uuid())
  hotelId   String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  outletIds String[] @default([])
  /// Sistemin açtığı gizli grup (tepsi ücreti gibi menüde görünmeyen ürünler; otel başına tek).
  system    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel      @relation(fields: [hotelId], references: [id])
  items MenuItem[]

  @@unique([hotelId, name])
  @@index([hotelId, sortOrder])
}

/// Menü ürünü: vergi dahil fiyat, vergi kategorisi (otelin vergi ayarı), mutfak istasyonu.
model MenuItem {
  id          String         @id @default(uuid())
  hotelId     String
  categoryId  String
  code        String?
  name        String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  taxCategory String         @default("FNB")
  station     PosStation     @default(HOT)
  isActive    Boolean        @default(true)
  /// Servis sırasında "tükendi" (şef garson açar / kapatır); siparişe eklenemez.
  soldOut     Boolean        @default(false)
  /// Sistem ürünü (menüde ve tanımlarda görünmez; fiyatı politikadan): türü başına otelde tek.
  system      PosSystemItem?
  sortOrder   Int            @default(0)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  hotel    Hotel          @relation(fields: [hotelId], references: [id])
  category MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lines    PosOrderLine[]
  recipe   Recipe?

  @@unique([hotelId, code])
  @@unique([categoryId, name])
  @@unique([hotelId, system])
  @@index([hotelId, categoryId, sortOrder])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "MenuItem_name_trgm_idx", type: Gin)
}

/// POS politikası (otel başına tek satır).
model PosSettings {
  hotelId                  String   @id
  /// İkram / indirim / iptal bu tutar ve üstündeyse dört göz onaya gider (0: onay yok).
  adjustmentApprovalAmount Decimal  @default(1000) @db.Decimal(12, 2)
  /// Vardiya kapanışında bu tutarı aşan nakit farkı yöneticiye uyarı düşürür.
  cashVarianceAlert        Decimal  @default(100) @db.Decimal(12, 2)
  /// Oda servisi (modül 41): sipariş başına tepsi ücreti (0 = yok), teslim hedefi (dakika), ileri saatli siparişin
  /// teslimden kaç dakika önce mutfağa düşeceği, teslimden kaç dakika sonra toplanmayan tepsinin uyarı düşüreceği,
  /// misafirin QR bağlantısıyla sipariş verip veremeyeceği.
  trayCharge               Decimal  @default(0) @db.Decimal(12, 2)
  deliveryTargetMinutes    Int      @default(30)
  prepLeadMinutes          Int      @default(30)
  trayAlertMinutes         Int      @default(90)
  guestOrderingEnabled     Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Adisyon numara serisi (otel × tür × yıl).
model PosSequence {
  hotelId String
  kind    String
  year    Int
  last    Int

  @@id([hotelId, kind, year])
}

/// Garson vardiyası: kasa avansıyla açılır; kapanışta nakit sayılır, beklenenle fark kaydedilir.
model PosShift {
  id           String         @id @default(uuid())
  hotelId      String
  waiterEmail  String
  outletId     String?
  status       PosShiftStatus @default(OPEN)
  openingFloat Decimal        @db.Decimal(12, 2)
  /// Açıldığı iş günü (rapor süzgeci).
  businessDate DateTime       @db.Date
  openedAt     DateTime       @default(now())
  closedAt     DateTime?
  closedBy     String?
  countedCash  Decimal?       @db.Decimal(12, 2)
  expectedCash Decimal?       @db.Decimal(12, 2)
  variance     Decimal?       @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  hotel    Hotel        @relation(fields: [hotelId], references: [id])
  outlet   PosOutlet?   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  checks   PosCheck[]
  payments PosPayment[]

  @@index([hotelId, status, waiterEmail])
  @@index([hotelId, openedAt, id])
  @@index([hotelId, waiterEmail, openedAt])
}

/// Adisyon: masada (ya da masasız) açılır, sipariş turlarıyla dolar, ödemeyle kapanır.
model PosCheck {
  id              String         @id @default(uuid())
  hotelId         String
  outletId        String
  tableId         String?
  number          String
  status          PosCheckStatus @default(OPEN)
  covers          Int            @default(1)
  note            String?
  /// Sahibi olan garson ve vardiyası (devirle değişir).
  waiterEmail     String
  shiftId         String
  sourceKey       String?
  openedAt        DateTime       @default(now())
  openedBy        String
  billRequestedAt DateTime?
  closedAt        DateTime?
  closedBy        String?
  /// Kapandığı iş günü (satış raporu).
  businessDate    DateTime?      @db.Date
  voidedAt        DateTime?
  voidedBy        String?
  reopenedAt      DateTime?
  reopenedBy      String?
  reopenReason    String?
  /// Bölünerek açıldıysa kaynak adisyon.
  splitFromId     String?
  /// Kalemlerin brüt toplamı (iptal ve ikram düşülmüş), indirim, vergi dökümü ve tahsilat.
  subtotal        Decimal        @default(0) @db.Decimal(14, 2)
  compTotal       Decimal        @default(0) @db.Decimal(14, 2)
  voidTotal       Decimal        @default(0) @db.Decimal(14, 2)
  discountPct     Decimal?       @db.Decimal(5, 2)
  discountTotal   Decimal        @default(0) @db.Decimal(14, 2)
  netTotal        Decimal        @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal        @default(0) @db.Decimal(14, 2)
  paidTotal       Decimal        @default(0) @db.Decimal(14, 2)
  roomChargeTotal Decimal        @default(0) @db.Decimal(14, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hotel       Hotel             @relation(fields: [hotelId], references: [id])
  outlet      PosOutlet         @relation(fields: [outletId], references: [id], onDelete: Restrict)
  table       PosTable?         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  shift       PosShift          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  splitFrom   PosCheck?         @relation("PosCheckSplit", fields: [splitFromId], references: [id], onDelete: Restrict)
  splits      PosCheck[]        @relation("PosCheckSplit")
  orders      PosOrder[]
  lines       PosOrderLine[]
  adjustments PosAdjustment[]
  payments    PosPayment[]
  roomCharges PosRoomCharge[]
  roomService RoomServiceOrder?

  @@unique([hotelId, number])
  @@unique([hotelId, sourceKey])
  // Masa planı: satış noktasının açık adisyonları.
  @@index([hotelId, status, outletId, tableId])
  // Adisyon listesi (en yeni açılan önce) ve satış raporu (kapanış iş günü).
  @@index([hotelId, openedAt, id])
  @@index([hotelId, businessDate, outletId])
  // Masa adıyla arama: masanın adisyonları, en yeni önce.
  @@index([tableId, openedAt])
  // Numara araması ("123", "000123").
  @@index([number(ops: raw("gin_trgm_ops"))], map: "PosCheck_number_trgm_idx", type: Gin)
  @@index([shiftId, status])
  @@index([hotelId, waiterEmail, status])
}

/// Sipariş turu ("Gönder"): mutfağa giden kalemler; durumunu mutfak ekranı (modül 40) ilerletir.
model PosOrder {
  id        String         @id @default(uuid())
  hotelId   String
  checkId   String
  outletId  String
  /// Adisyondaki tur numarası (1, 2, 3…).
  seq       Int
  status    PosOrderStatus @default(NEW)
  sourceKey String
  sentAt    DateTime       @default(now())
  sentBy    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  check  PosCheck       @relation(fields: [checkId], references: [id], onDelete: Restrict)
  outlet PosOutlet      @relation(fields: [outletId], references: [id], onDelete: Restrict)
  lines  PosOrderLine[]

  @@unique([hotelId, sourceKey])
  @@unique([checkId, seq])
  // Mutfak ekranı: satış noktasının bekleyen turları.
  @@index([hotelId, outletId, status, sentAt])
}

/// Sipariş kalemi: ürünün adı, fiyatı, vergi kategorisi ve istasyonu gönderildiği anki kopyadır.
model PosOrderLine {
  id             String     @id @default(uuid())
  hotelId        String
  checkId        String
  orderId        String
  menuItemId     String
  name           String
  station        PosStation
  taxCategory    String
  unitPrice      Decimal    @db.Decimal(12, 2)
  quantity       Int
  /// Uygulanmış iptal ve ikram adetleri (onay bekleyenler düzeltme kaydında).
  voidedQuantity Int        @default(0)
  compedQuantity Int        @default(0)
  note           String?
  sortOrder      Int
  /// Adisyonun kapandığı iş günü (kapanışta yazılır, yeniden açılınca silinir): ürün satış
  /// raporu kalemleri adisyona dönmeden gün aralığıyla okur.
  businessDate   DateTime?  @db.Date
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  check       PosCheck        @relation(fields: [checkId], references: [id], onDelete: Restrict)
  order       PosOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem    MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  adjustments PosAdjustment[]

  @@index([checkId, sortOrder])
  @@index([orderId])
  // Ürün satış raporu (kapanış iş günü aralığı).
  @@index([hotelId, businessDate])
}

/// İkram / iptal / indirim: kim, neden, ne kadar; eşik üstüyse onay kaydıyla.
model PosAdjustment {
  id             String              @id @default(uuid())
  hotelId        String
  checkId        String
  kind           PosAdjustmentKind
  lineId         String?
  quantity       Int?
  /// İptal edilen kalem hazırlanmıştı (zayi).
  waste          Boolean             @default(false)
  discountPct    Decimal?            @db.Decimal(5, 2)
  discountAmount Decimal?            @db.Decimal(14, 2)
  /// İstek anındaki para etkisi (eşik denetimi ve rapor).
  value          Decimal             @db.Decimal(14, 2)
  reason         String
  status         PosAdjustmentStatus
  requestedBy    String
  requestedAt    DateTime            @default(now())
  approvalId     String?
  decidedAt      DateTime?
  decidedBy      String?
  /// Yeni indirim eskisinin yerine geçti.
  supersededAt   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  check    PosCheck      @relation(fields: [checkId], references: [id], onDelete: Restrict)
  line     PosOrderLine? @relation(fields: [lineId], references: [id], onDelete: Restrict)
  approval Approval?     @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@index([checkId, status])
  @@index([approvalId])
  // İkram / iptal / indirim raporu.
  @@index([hotelId, kind, requestedAt])
}

/// Restoran ödemesi (nakit / kart): adisyonun kendi hesabı; kasada "Restoran" kaynağı.
model PosPayment {
  id              String        @id @default(uuid())
  hotelId         String
  checkId         String
  /// Parayı alanın vardiyası (kasa sayımı bununla).
  shiftId         String
  kind            PaymentKind   @default(PAYMENT)
  status          PaymentStatus @default(POSTED)
  method          PaymentMethod
  /// Tahsilatta artı; iptal kaydında asıl satırın tersi.
  amount          Decimal       @db.Decimal(14, 2)
  currency        String
  businessDate    DateTime      @db.Date
  reference       String?
  sourceKey       String?
  receivedBy      String
  receivedAt      DateTime      @default(now())
  postedAt        DateTime?
  approvalId      String?
  declinedAt      DateTime?
  reversalOfId    String?       @unique
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  voidApprovalId  String?
  voidRequestedAt DateTime?
  voidRequestedBy String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  check      PosCheck    @relation(fields: [checkId], references: [id], onDelete: Restrict)
  shift      PosShift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  approval   Approval?   @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  reversalOf PosPayment? @relation("PosPaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal   PosPayment? @relation("PosPaymentReversal")

  @@unique([hotelId, sourceKey])
  @@index([checkId, receivedAt, id])
  // Kasa: günün işlenen hareketleri ve onay bekleyenler.
  @@index([hotelId, businessDate, postedAt, id])
  @@index([hotelId, status, receivedAt])
  // Vardiya kasası.
  @@index([shiftId, method])
  @@index([approvalId])
  @@index([voidApprovalId])
}

/// Odaya yazılan adisyon tutarı: içerideki misafirin folyosuna `fnb.order.charged` ile işlenir.
model PosRoomCharge {
  id            String   @id @default(uuid())
  hotelId       String
  checkId       String
  reservationId String
  roomNumber    String
  guestName     String
  amount        Decimal  @db.Decimal(14, 2)
  /// Folyoya giden olay (işlenme durumu `evt:<olay>:0` kalem anahtarından okunur).
  eventId       String
  sourceKey     String
  chargedBy     String
  chargedAt     DateTime @default(now())
  businessDate  DateTime @db.Date
  createdAt     DateTime @default(now())

  check       PosCheck    @relation(fields: [checkId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([hotelId, sourceKey])
  @@index([checkId])
  @@index([hotelId, businessDate])
  @@index([reservationId])
}

/// Oda servisi siparişi (modül 41): odaya teslim kaydı. Mutfağa düşünce (hemen, kabulde ya da zamanı gelince) bir
/// adisyon ve sipariş turu açılır; teslimde kapıda alınan ödeme ve kalanın odaya yazılmasıyla adisyon kapanır.
/// Misafirden gelen (kabul bekleyen) ve ileri saatli sipariş mutfağa düşene kadar adisyonsuzdur; kalemleri `items`'tadır.
model RoomServiceOrder {
  id              String            @id @default(uuid())
  hotelId         String
  outletId        String
  /// "OS-2026-000123".
  number          String
  checkId         String?           @unique
  reservationId   String
  roomId          String
  /// Sipariş anındaki oda ve misafir (teslim fişi; konaklama sonra oda değiştirse de iz kalır).
  roomNumber      String
  guestName       String
  source          RoomServiceSource
  guestRequestId  String?
  /// Misafir siparişinin geldiği QR bağlantısı.
  linkId          String?
  status          RoomServiceStatus
  covers          Int               @default(1)
  note            String?
  /// İstenen teslim anı (boş = hemen).
  deliverAt       DateTime?
  /// İleri saatli siparişin mutfağa düşeceği an (teslim − hazırlık payı).
  releaseAt       DateTime?
  /// Teslim hedefi: istenen an ya da mutfağa düşüş + hedef süre (gecikme uyarısı ve zamanında teslim oranı buna göre).
  dueAt           DateTime
  /// Sipariş edilen kalemlerin kopyası (ad, fiyat, istasyon, adet, not): kabul / mutfağa düşüş öncesi tek kaynak;
  /// sonrası hazırlık listesi ve geçmiş için. Adisyonun kalemleri ayrıca `PosOrderLine`'dadır.
  items           Json
  /// Kalemlerin vergi dahil tutarı (tepsi ücreti hariç; misafire gösterilen tahmini tutar).
  itemsTotal      Decimal           @db.Decimal(14, 2)
  /// Tepsi bırakılacak mı (içecekte olmayabilir): toplanma takibi buna göre.
  trayExpected    Boolean           @default(true)
  sourceKey       String
  createdBy       String
  createdAt       DateTime          @default(now())
  acceptedAt      DateTime?
  acceptedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectReason    String?
  /// Mutfağa düştüğü an.
  receivedAt      DateTime?
  preparingAt     DateTime?
  readyAt         DateTime?
  dispatchedAt    DateTime?
  /// Siparişi götüren personel.
  runnerEmail     String?
  deliveredAt     DateTime?
  deliveredBy     String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  trayCollectedAt DateTime?
  trayCollectedBy String?
  /// Zamanlanmış uyarıların düştüğü an (aynı sipariş için bir kez): gecikti, tepsi toplanmadı, misafir siparişi /
  /// zamanı gelen sipariş bekliyor, konaklama bitti ama sipariş açık.
  lateAlertedAt   DateTime?
  trayAlertedAt   DateTime?
  waitAlertedAt   DateTime?
  stayAlertedAt   DateTime?
  updatedAt       DateTime          @updatedAt

  hotel        Hotel            @relation(fields: [hotelId], references: [id])
  outlet       PosOutlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  check        PosCheck?        @relation(fields: [checkId], references: [id], onDelete: Restrict)
  reservation  Reservation      @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  room         Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guestRequest GuestRequest?    @relation(fields: [guestRequestId], references: [id], onDelete: Restrict)
  link         RoomServiceLink? @relation(fields: [linkId], references: [id], onDelete: Restrict)

  @@unique([hotelId, number])
  @@unique([hotelId, sourceKey])
  // Pano sütunları (teslim hedefine göre) ve gecikme taraması.
  @@index([hotelId, status, dueAt])
  // İleri saatli siparişlerin mutfağa düşürülmesi ve hazırlık listesi (teslim anına göre).
  @@index([hotelId, status, releaseAt])
  @@index([hotelId, deliverAt])
  // Toplanacak tepsiler ve teslim süresi raporu.
  @@index([hotelId, status, deliveredAt])
  // Geçmiş (en yeni önce) ve oda numarasıyla arama.
  @@index([hotelId, createdAt, id])
  @@index([hotelId, roomNumber, createdAt])
  @@index([reservationId, status])
  @@index([linkId, status])
  @@index([guestRequestId])
  // Numara ve misafir adı araması.
  @@index([number(ops: raw("gin_trgm_ops"))], map: "RoomServiceOrder_number_trgm_idx", type: Gin)
  @@index([guestName(ops: raw("gin_trgm_ops"))], map: "RoomServiceOrder_guestName_trgm_idx", type: Gin)
}

/// Misafirin QR ile sipariş bağlantısı (modül 41; misafir sayfası modül 53): konaklamaya ve odaya bağlı, imzalı.
/// Oda değişince, çıkışta ya da personel yenileyince geçersizdir; konaklamada aynı anda tek geçerli bağlantı olur.
model RoomServiceLink {
  id            String    @id @default(uuid())
  hotelId       String
  reservationId String
  roomId        String
  /// İmzaya giren rastgele değer: veritabanı sızsa da bağlantı imza anahtarı olmadan üretilemez.
  nonce         String
  createdBy     String
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedBy     String?
  lastUsedAt    DateTime?

  hotel       Hotel              @relation(fields: [hotelId], references: [id])
  reservation Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  room        Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  orders      RoomServiceOrder[]

  @@index([reservationId, revokedAt])
}

/**
 * ══════════════════ Reçete ve malzeme kartı (modül 38'in reçete kısmı — modül 43) ══════════════════
 */

/// Malzeme kartı (44'ün stok kartının yalın hâli): stok birimi, güncel birim maliyet (KDV hariç), alerjenler.
/// Depo / hareket / hareketli ortalama maliyet 44'te bu tabloya eklenir. Silinmez, pasife alınır.
model StockItem {
  id            String         @id @default(uuid())
  hotelId       String
  code          String?
  name          String
  group         StockItemGroup
  unit          KitchenUnit
  /// Stok birimi başına, KDV hariç (44 gelince hareketli ortalama maliyet bunu günceller).
  unitCost      Decimal        @default(0) @db.Decimal(14, 4)
  costUpdatedAt DateTime?
  allergens     String[]       @default([])
  /// Toplam mevcut (depoların toplamı, stok biriminde) ve minimum seviye (altında talep önerisi; boş = izlenmez).
  onHand        Decimal        @default(0) @db.Decimal(14, 3)
  minLevel      Decimal?       @db.Decimal(14, 3)
  isActive      Boolean        @default(true)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  hotel                Hotel                 @relation(fields: [hotelId], references: [id])
  recipeLines          RecipeLine[]
  purchaseRequestLines PurchaseRequestLine[]
  roundLines           PurchaseRoundLine[]
  orderLines           PurchaseOrderLine[]
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]

  @@unique([hotelId, code])
  @@index([hotelId, group, name])
  @@index([hotelId, isActive, name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "StockItem_name_trgm_idx", type: Gin)
}

/// Reçete: verim (porsiyon ya da kg / L / adet), istasyon, servisten önce hazırlık süresi; satırları malzeme
/// ya da ara reçete. Maliyet saklanmaz, malzemenin güncel birim maliyetinden hesaplanır.
model Recipe {
  id            String      @id @default(uuid())
  hotelId       String
  code          String?
  name          String
  kind          RecipeKind
  station       PosStation  @default(HOT)
  /// Restoran menüsündeki ürünü (maliyet / kâr marjı); bir ürünün tek reçetesi olur.
  menuItemId    String?     @unique
  yieldQuantity Decimal     @db.Decimal(12, 3)
  yieldUnit     KitchenUnit
  /// Servisten (ara üründe: onu kullanan reçetenin başlangıcından) kaç dakika önce hazırlığa başlanır.
  leadMinutes   Int         @default(0)
  method        String?
  isActive      Boolean     @default(true)
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  hotel           Hotel             @relation(fields: [hotelId], references: [id])
  menuItem        MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  lines           RecipeLine[]      @relation("RecipeLines")
  usedIn          RecipeLine[]      @relation("RecipeSubRecipe")
  banquetDishes   BanquetMenuDish[]
  eventMenuDishes EventMenuDish[]

  @@unique([hotelId, code])
  @@index([hotelId, kind, isActive, name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Recipe_name_trgm_idx", type: Gin)
}

/// Reçete satırı: malzeme ya da ara reçete (tam biri); net miktar satırın biriminde, fire yüzdesiyle brüte çıkar.
model RecipeLine {
  id          String      @id @default(uuid())
  hotelId     String
  recipeId    String
  sortOrder   Int
  stockItemId String?
  subRecipeId String?
  quantity    Decimal     @db.Decimal(12, 4)
  unit        KitchenUnit
  wastePct    Decimal     @default(0) @db.Decimal(5, 2)
  note        String?

  recipe    Recipe     @relation("RecipeLines", fields: [recipeId], references: [id], onDelete: Cascade)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  subRecipe Recipe?    @relation("RecipeSubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)

  @@index([recipeId, sortOrder])
  @@index([stockItemId])
  @@index([subRecipeId])
}

/**
 * ══════════════════ Banket F&B planlaması (modül 43) ══════════════════
 */

/// Set menü kataloğu: kurslar ve yemekler, kişi başı fiyat (vergi dahil). Etkinliğe kopyası alınır.
model BanquetMenu {
  id             String   @id @default(uuid())
  hotelId        String
  code           String?
  name           String
  description    String?
  pricePerPerson Decimal  @db.Decimal(12, 2)
  taxCategory    String   @default("FNB")
  /// En az kişi şartı (altında uyarı).
  minGuests      Int?
  isActive       Boolean  @default(true)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hotel      Hotel               @relation(fields: [hotelId], references: [id])
  courses    BanquetMenuCourse[]
  eventMenus EventMenu[]

  @@unique([hotelId, code])
  @@index([hotelId, isActive, name])
}

model BanquetMenuCourse {
  id        String         @id @default(uuid())
  hotelId   String
  menuId    String
  name      String
  mode      MenuCourseMode
  sortOrder Int

  menu   BanquetMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dishes BanquetMenuDish[]

  @@index([menuId, sortOrder])
}

model BanquetMenuDish {
  id               String  @id @default(uuid())
  hotelId          String
  courseId         String
  recipeId         String
  label            String?
  portionsPerGuest Decimal @default(1) @db.Decimal(6, 3)
  sortOrder        Int

  course BanquetMenuCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recipe Recipe            @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([courseId, sortOrder])
  @@index([recipeId])
}

/// Etkinlik menüsü: bir oturumun öğünü (servis anı oturumun içinde). Dosyanın kişi başı fiyat kalemini üretir
/// (`EventItem.eventMenuId`). Mutfağa kesinleşince değişmez; gerekçeyle yeniden açılır.
model EventMenu {
  id             String    @id @default(uuid())
  hotelId        String
  eventId        String
  sessionId      String
  sourceMenuId   String?
  name           String
  serveAt        DateTime
  /// Boş = etkinliğin faturalanacak kişisi; dolu = bu öğünün kendi kişisi.
  guests         Int?
  pricePerPerson Decimal   @db.Decimal(12, 2)
  discountPct    Decimal   @default(0) @db.Decimal(5, 2)
  taxCategory    String    @default("FNB")
  notes          String?
  sortOrder      Int
  finalizedAt    DateTime?
  finalizedBy    String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session    EventSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sourceMenu BanquetMenu?      @relation(fields: [sourceMenuId], references: [id], onDelete: SetNull)
  courses    EventMenuCourse[]
  dishes     EventMenuDish[]
  item       EventItem?

  @@index([eventId, serveAt])
  // İhtiyaç ve üretim planı: otelin servis aralığındaki menüleri.
  @@index([hotelId, serveAt])
  @@index([sessionId])
  @@index([sourceMenuId])
}

model EventMenuCourse {
  id          String         @id @default(uuid())
  hotelId     String
  eventMenuId String
  name        String
  mode        MenuCourseMode
  sortOrder   Int

  eventMenu EventMenu       @relation(fields: [eventMenuId], references: [id], onDelete: Cascade)
  dishes    EventMenuDish[]

  @@index([eventMenuId, sortOrder])
}

/// Etkinlik menüsünün yemeği. Seçmeli kursta `guestCount` sabit kişi; boşsa "kalan".
model EventMenuDish {
  id               String  @id @default(uuid())
  hotelId          String
  eventMenuId      String
  courseId         String
  recipeId         String
  label            String?
  portionsPerGuest Decimal @default(1) @db.Decimal(6, 3)
  guestCount       Int?
  sortOrder        Int

  eventMenu EventMenu       @relation(fields: [eventMenuId], references: [id], onDelete: Cascade)
  course    EventMenuCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recipe    Recipe          @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([courseId, sortOrder])
  @@index([eventMenuId])
  @@index([recipeId])
}

/**
 * ══════════════════ Satın alma talebi (modül 45'in talep kısmı — modül 43) ══════════════════
 */

/// Satın alma talebi: STR-yıl-sıra. Satırları malzeme × etkinlik (banket ihtiyacının eksiği).
model PurchaseRequest {
  id           String                @id @default(uuid())
  hotelId      String
  number       String
  status       PurchaseRequestStatus @default(OPEN)
  source       PurchaseRequestSource
  /// Satırların en erken ihtiyaç günü.
  neededBy     DateTime              @db.Date
  note         String?
  requestedBy  String
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  hotel Hotel                 @relation(fields: [hotelId], references: [id])
  lines PurchaseRequestLine[]

  @@unique([hotelId, number])
  @@index([hotelId, createdAt, id])
  @@index([hotelId, status, createdAt, id])
  @@index([hotelId, neededBy])
}

model PurchaseRequestLine {
  id                String      @id @default(uuid())
  hotelId           String
  requestId         String
  stockItemId       String
  /// Stok biriminde (kopya: birim sonradan değişse de talep okunur kalır).
  quantity          Decimal     @db.Decimal(14, 3)
  unit              KitchenUnit
  neededBy          DateTime    @db.Date
  eventId           String?
  /// Talep anındaki birim maliyet (45'te teklif karşılaştırmasının dayanağı).
  estimatedUnitCost Decimal     @db.Decimal(14, 4)
  sortOrder         Int
  /// Teklif turundaki satırı (malzeme başına birleşmiş); tur iptal edilince boşalır.
  roundLineId       String?

  request   PurchaseRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stockItem StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  event     Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  roundLine PurchaseRoundLine? @relation(fields: [roundLineId], references: [id], onDelete: SetNull)

  @@index([requestId, sortOrder])
  // Etkinliğin talep edilmiş miktarı (ihtiyaç ekranının "talep edildi" sütunu).
  @@index([eventId, stockItemId])
  @@index([hotelId, stockItemId])
  @@index([roundLineId])
  @@index([hotelId, roundLineId, neededBy])
}

/// Satın alma numara serisi (otel × tür × yıl): talep (STR); 45 sipariş serisini ekler.
model PurchaseSequence {
  hotelId String
  kind    String
  year    Int
  last    Int

  @@id([hotelId, kind, year])
}

/**
 * ══════════════════ Satın alma (modül 45) ══════════════════
 */

/// Tedarikçi kartı: vergi bilgisi, ödeme vadesi (mal kabulden itibaren), olağan termin, tedarik ettiği gruplar.
model Supplier {
  id              String   @id @default(uuid())
  hotelId         String
  code            String?
  name            String
  contactName     String?
  phone           String?
  email           String?
  taxOffice       String?
  taxNumber       String?
  address         String?
  paymentTermDays Int      @default(30)
  leadTimeDays    Int      @default(1)
  groups          String[] @default([])
  notes           String?
  isActive        Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel         Hotel           @relation(fields: [hotelId], references: [id])
  quotes        PurchaseQuote[]
  orders        PurchaseOrder[]
  receipts      GoodsReceipt[]
  ledgerAccount LedgerAccount?

  @@unique([hotelId, code])
  @@index([hotelId, isActive, name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Supplier_name_trgm_idx", type: Gin)
  @@index([groups], type: Gin)
}

/// Satın alma politikası (otel başına tek satır).
model PurchaseSettings {
  hotelId             String   @id
  /// Bu tutar (KDV dahil) ve üstündeki sipariş onay kuyruğuna gider (0 = onay yok).
  orderApprovalAmount Decimal  @default(50000) @db.Decimal(14, 2)
  defaultTaxRatePct   Decimal  @default(10) @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Teklif turu (TKT-yıl-sıra): açık talep satırları malzeme başına birleşir; tedarikçiler teklif verir.
model PurchaseRound {
  id           String              @id @default(uuid())
  hotelId      String
  number       String
  status       PurchaseRoundStatus @default(OPEN)
  /// Satırların en erken ihtiyaç günü.
  neededBy     DateTime            @db.Date
  note         String?
  createdBy    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  awardedAt    DateTime?
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  hotel  Hotel               @relation(fields: [hotelId], references: [id])
  lines  PurchaseRoundLine[]
  quotes PurchaseQuote[]
  orders PurchaseOrder[]

  @@unique([hotelId, number])
  @@index([hotelId, status, createdAt, id])
  @@index([hotelId, createdAt, id])
}

/// Tur satırı (malzeme): toplam miktar, en erken ihtiyaç; seçilen teklif satırı ve oluşan sipariş satırı.
model PurchaseRoundLine {
  id                 String      @id @default(uuid())
  hotelId            String
  roundId            String
  stockItemId        String
  quantity           Decimal     @db.Decimal(14, 3)
  unit               KitchenUnit
  neededBy           DateTime    @db.Date
  sortOrder          Int
  awardedQuoteLineId String?     @unique
  /// En ucuz dışı seçimin gerekçesi.
  awardReason        String?
  orderLineId        String?     @unique
  /// Tur kapatıldı, satır siparişe dönmeden talebe geri bırakıldı.
  releasedAt         DateTime?

  round        PurchaseRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  stockItem    StockItem             @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  awardedQuote PurchaseQuoteLine?    @relation("AwardedQuoteLine", fields: [awardedQuoteLineId], references: [id], onDelete: SetNull)
  orderLine    PurchaseOrderLine?    @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  quoteLines   PurchaseQuoteLine[]   @relation("QuoteLineRoundLine")
  requestLines PurchaseRequestLine[]

  @@index([roundId, sortOrder])
  @@index([stockItemId])
}

/// Tedarikçinin teklifi (turda tedarikçi başına tek): termin ve geçerlilik.
model PurchaseQuote {
  id           String    @id @default(uuid())
  hotelId      String
  roundId      String
  supplierId   String
  deliveryDays Int
  validUntil   DateTime? @db.Date
  note         String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  round    PurchaseRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseQuoteLine[]

  @@unique([roundId, supplierId])
  @@index([supplierId])
}

/// Teklif satırı: KDV hariç birim fiyat (stok biriminde; boş = vermiyor) ve KDV oranı.
model PurchaseQuoteLine {
  id          String   @id @default(uuid())
  hotelId     String
  quoteId     String
  roundLineId String
  unitPrice   Decimal? @db.Decimal(14, 4)
  taxRatePct  Decimal  @db.Decimal(5, 2)

  quote     PurchaseQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  roundLine PurchaseRoundLine  @relation("QuoteLineRoundLine", fields: [roundLineId], references: [id], onDelete: Cascade)
  awardedTo PurchaseRoundLine? @relation("AwardedQuoteLine")

  @@unique([quoteId, roundLineId])
  @@index([roundLineId])
}

/// Satın alma siparişi (SAS-yıl-sıra): tedarikçi başına; eşik üstü onay kuyruğundan; mal kabulle kapanır.
model PurchaseOrder {
  id              String              @id @default(uuid())
  hotelId         String
  number          String
  supplierId      String
  roundId         String?
  status          PurchaseOrderStatus
  /// Beklenen teslim günü (talep + termin).
  expectedOn      DateTime            @db.Date
  paymentTermDays Int
  currency        String
  netTotal        Decimal             @db.Decimal(14, 2)
  taxTotal        Decimal             @db.Decimal(14, 2)
  grandTotal      Decimal             @db.Decimal(14, 2)
  /// Teslim alınanın KDV dahil tutarı.
  receivedTotal   Decimal             @default(0) @db.Decimal(14, 2)
  note            String?
  approvalId      String?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  /// Kalan miktar gelmeyecek: eksik kapatan ve gerekçesi (mal kabulle kapatılırsa gerekçe boş olabilir).
  closedAt        DateTime?
  closedBy        String?
  closeReason     String?

  hotel    Hotel               @relation(fields: [hotelId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  round    PurchaseRound?      @relation(fields: [roundId], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([hotelId, number])
  @@index([hotelId, status, createdAt, id])
  @@index([hotelId, createdAt, id])
  @@index([hotelId, supplierId, createdAt])
  @@index([hotelId, expectedOn])
  @@index([roundId])
}

model PurchaseOrderLine {
  id               String      @id @default(uuid())
  hotelId          String
  orderId          String
  stockItemId      String
  quantity         Decimal     @db.Decimal(14, 3)
  unit             KitchenUnit
  unitPrice        Decimal     @db.Decimal(14, 4)
  taxRatePct       Decimal     @db.Decimal(5, 2)
  netAmount        Decimal     @db.Decimal(14, 2)
  taxAmount        Decimal     @db.Decimal(14, 2)
  total            Decimal     @db.Decimal(14, 2)
  receivedQuantity Decimal     @default(0) @db.Decimal(14, 3)
  sortOrder        Int

  order        PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItem    StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  roundLine    PurchaseRoundLine?
  receiptLines GoodsReceiptLine[]

  @@index([orderId, sortOrder])
  @@index([hotelId, stockItemId])
}

/// Mal kabul / irsaliye (MKB-yıl-sıra): siparişten gelen miktar depoya girer; tedarikçinin aynı irsaliyesi iki kez girilmez.
model GoodsReceipt {
  id            String   @id @default(uuid())
  hotelId       String
  number        String
  orderId       String
  supplierId    String
  warehouseId   String
  waybillNumber String
  receivedOn    DateTime @db.Date
  note          String?
  netTotal      Decimal  @db.Decimal(14, 2)
  taxTotal      Decimal  @db.Decimal(14, 2)
  grandTotal    Decimal  @db.Decimal(14, 2)
  /// Bu kabulle sipariş eksik kapatıldı (kalan gelmeyecek).
  closedShort   Boolean  @default(false)
  receivedBy    String
  createdAt     DateTime @default(now())

  hotel     Hotel              @relation(fields: [hotelId], references: [id])
  order     PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supplier  Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     GoodsReceiptLine[]

  @@unique([hotelId, number])
  @@unique([hotelId, supplierId, waybillNumber])
  @@index([hotelId, receivedOn, id])
  @@index([orderId])
  @@index([hotelId, warehouseId, receivedOn])
}

model GoodsReceiptLine {
  id          String  @id @default(uuid())
  hotelId     String
  receiptId   String
  orderLineId String
  stockItemId String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 4)
  taxRatePct  Decimal @db.Decimal(5, 2)
  netAmount   Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  receipt   GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([orderLineId])
}

/**
 * ══════════════════ Stok çekirdeği (44'ün çekirdeği — modül 45) ══════════════════
 */

/// Depo (ana depo, soğuk oda, bar deposu…). Otelde tek varsayılan depo (mal kabulde önce seçili).
model Warehouse {
  id        String   @id @default(uuid())
  hotelId   String
  code      String
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel     Hotel           @relation(fields: [hotelId], references: [id])
  levels    StockLevel[]
  movements StockMovement[]
  receipts  GoodsReceipt[]

  @@unique([hotelId, code])
  @@index([hotelId, isActive, name])
}

/// Depo × malzeme mevcudu (stok biriminde).
model StockLevel {
  id          String   @id @default(uuid())
  hotelId     String
  warehouseId String
  stockItemId String
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, stockItemId])
  @@index([hotelId, stockItemId])
}

/// Stok hareketi (değişmez kayıt): işaretli miktar, birim maliyet, hareket sonrası kartın mevcudu ve ortalama maliyeti, kaynağı.
model StockMovement {
  id           String            @id @default(uuid())
  hotelId      String
  kind         StockMovementKind
  stockItemId  String
  warehouseId  String
  quantity     Decimal           @db.Decimal(14, 3)
  unitCost     Decimal           @db.Decimal(14, 4)
  totalCost    Decimal           @db.Decimal(14, 2)
  onHandAfter  Decimal           @db.Decimal(14, 3)
  avgCostAfter Decimal           @db.Decimal(14, 4)
  sourceType   String
  sourceId     String
  note         String?
  occurredAt   DateTime
  createdBy    String
  createdAt    DateTime          @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([hotelId, stockItemId, occurredAt, id])
  @@index([hotelId, occurredAt, id])
  @@index([hotelId, warehouseId, occurredAt])
  @@index([sourceType, sourceId])
}

// ═══════════════════════ Ön muhasebe (modül 47) ═══════════════════════

/// Cari hesabın türü: acente ve tedarikçi kartına, etkinlik müşterisine bağlı ya da elle açılmış.
enum LedgerAccountType {
  AGENCY
  SUPPLIER
  COMPANY
  PERSON
  OTHER
  EMPLOYEE
}

/// Cari hareketin kaynağı (otomatik kayıt ya da fiş).
enum LedgerSource {
  OPENING
  FOLIO_TRANSFER
  EVENT_CHARGE
  EVENT_PAYMENT
  GOODS_RECEIPT
  AGENCY_BONUS
  VOUCHER
  INSTRUMENT
  INVOICE
  PAYROLL
  PAYROLL_PAYMENT
  EMPLOYEE_ADVANCE
}

enum TreasuryKind {
  CASH
  BANK
}

/// Kasa / banka hareketinin kaynağı.
enum TreasurySource {
  OPENING
  FOLIO_PAYMENT
  EVENT_PAYMENT
  POS_PAYMENT
  VOUCHER
  INSTRUMENT
  PAYROLL_PAYMENT
  EMPLOYEE_ADVANCE
}

/// Otomatik tahsilatın geldiği yer: yöntem → kasa / banka eşlemesi bunun üstüne kurulur.
enum TreasuryChannel {
  FRONT_DESK
  BANQUET
  POS
}

enum AccountingVoucherType {
  COLLECTION
  PAYMENT
  TRANSFER
  TREASURY_IN
  TREASURY_OUT
  OPENING
}

/// İşlendi; eşik üstü ödeme fişi onay bekler; reddedilen / süresi dolan hiç işlenmez; iptal ters kayıtla.
enum AccountingVoucherStatus {
  POSTED
  PENDING_APPROVAL
  DECLINED
  VOIDED
}

enum VoucherLineKind {
  TREASURY
  CHEQUE_IN
  CHEQUE_OUT
  ENDORSE
}

enum InstrumentKind {
  CHEQUE
  NOTE
}

enum InstrumentDirection {
  RECEIVED
  ISSUED
}

/// Alınan: portföy → tahsilde → tahsil / karşılıksız / iade, portföy → ciro. Verilen: ödenecek → ödendi / karşılıksız / iade.
enum InstrumentStatus {
  PORTFOLIO
  AT_BANK
  COLLECTED
  ENDORSED
  BOUNCED
  RETURNED
  OUTSTANDING
  PAID
  CANCELLED
}

enum InstrumentAction {
  RECEIVE
  ISSUE
  DEPOSIT
  WITHDRAW
  COLLECT
  ENDORSE
  BOUNCE
  RETURN
  PAY
  CANCEL
}

/// Ön muhasebe ayarı: otomatik kayıtların başlangıç günü (öncesi açılış bakiyesiyle) ve ödeme fişi onay eşiği.
model AccountingSettings {
  hotelId               String   @id
  /// Bu günden (dahil) sonraki belgeler cari / kasaya otomatik işlenir.
  startDate             DateTime @db.Date
  /// Bu tutar ve üstündeki ödeme fişi dört göz onayına gider (0 = onay yok).
  paymentApprovalAmount Decimal  @default(50000) @db.Decimal(14, 2)
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Belge numarası ve cari / kasa kodu sırası (otel × önek × yıl; kodlarda yıl 0).
model AccountingSequence {
  hotelId String
  kind    String
  year    Int
  last    Int    @default(0)

  @@id([hotelId, kind, year])
}

/// Cari hesap: acente, tedarikçi, etkinlik müşterisi (bire bir bağlı) ya da elle açılan şirket / şahıs. Bakiye = borç − alacak.
model LedgerAccount {
  id              String            @id @default(uuid())
  hotelId         String
  code            String
  name            String
  type            LedgerAccountType
  agencyId        String?           @unique
  supplierId      String?           @unique
  eventClientId   String?           @unique
  /// Personel carisi (modül 51): net ücret borcumuz, avans ve maaş ödemesi.
  employeeId      String?           @unique
  taxOffice       String?
  taxNumber       String?
  contactName     String?
  phone           String?
  email           String?
  address         String?
  /// Bu carinin alacak vadesi (gün); bağlı kartta karttan gelir.
  paymentTermDays Int               @default(0)
  /// Artı: cari bize borçlu; eksi: biz cariye borçluyuz. Hareketle aynı işlemde, satır kilidi altında.
  balance         Decimal           @default(0) @db.Decimal(16, 2)
  debitTotal      Decimal           @default(0) @db.Decimal(16, 2)
  creditTotal     Decimal           @default(0) @db.Decimal(16, 2)
  lastEntryOn     DateTime?         @db.Date
  isActive        Boolean           @default(true)
  notes           String?
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hotel             Hotel               @relation(fields: [hotelId], references: [id])
  agency            Agency?             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  eventClient       EventClient?        @relation(fields: [eventClientId], references: [id], onDelete: Restrict)
  employee          Employee?           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  entries           LedgerEntry[]
  vouchers          AccountingVoucher[]
  invoices          Invoice[]
  instruments       Instrument[]        @relation("InstrumentAccount")
  endorsements      Instrument[]        @relation("InstrumentEndorsee")
  treasuryMovements TreasuryMovement[]
  payments          Payment[]

  @@unique([hotelId, code])
  // Cari listesi: türe ve duruma göre ada göre; bakiyeye göre sıralı (en borçlu).
  @@index([hotelId, type, isActive, name])
  @@index([hotelId, isActive, balance])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "LedgerAccount_name_trgm_idx", type: Gin)
}

/// Cari hareket (ekstre satırı): borç ya da alacak; kaynağı tekil — aynı belge iki kez yazılmaz. Düzeltme ters kayıtla.
model LedgerEntry {
  id            String       @id @default(uuid())
  hotelId       String
  accountId     String
  /// Belge günü (ekstre sırası) ve vade (yaşlandırma).
  date          DateTime     @db.Date
  dueDate       DateTime?    @db.Date
  debit         Decimal      @default(0) @db.Decimal(14, 2)
  credit        Decimal      @default(0) @db.Decimal(14, 2)
  description   String
  reference     String?
  /// Bağlı faturanın numarası (modül 16 / 49): folyo aktarımı ve etkinlik bedeli alacağına fatura kesilince yazılır, iptalde silinir.
  invoiceNumber String?
  sourceType    LedgerSource
  sourceId      String
  /// Tekrar işleme anahtarı (otel başına tekil): "PAYMENT:<id>", "GOODS_RECEIPT:<id>", "EVENT:<id>:<n>"…
  sourceKey     String
  voucherId     String?
  instrumentId  String?
  reversalOfId  String?      @unique
  createdBy     String
  createdAt     DateTime     @default(now())

  hotel      Hotel              @relation(fields: [hotelId], references: [id])
  account    LedgerAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  voucher    AccountingVoucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  instrument Instrument?        @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  reversalOf LedgerEntry?       @relation("LedgerEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal   LedgerEntry?       @relation("LedgerEntryReversal")

  @@unique([hotelId, sourceKey])
  // Ekstre (belge günü + kayıt anı + kimlik, imleçli) ve devir toplamı.
  @@index([accountId, date, createdAt, id])
  // Kaynağın kayıtları (etkinlik / prim farkı, fiş iptali).
  @@index([hotelId, sourceType, sourceId])
  @@index([hotelId, date, id])
  @@index([voucherId])
  @@index([instrumentId])
}

/// Kasa ya da banka hesabı (kendi para biriminde). Bakiye hareketlerle aynı işlemde güncellenir.
model TreasuryAccount {
  id             String       @id @default(uuid())
  hotelId        String
  kind           TreasuryKind
  code           String
  name           String
  currency       String
  bankName       String?
  branch         String?
  iban           String?
  accountNumber  String?
  balance        Decimal      @default(0) @db.Decimal(16, 2)
  lastMovementOn DateTime?    @db.Date
  isActive       Boolean      @default(true)
  notes          String?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  hotel       Hotel                   @relation(fields: [hotelId], references: [id])
  movements   TreasuryMovement[]
  mappings    TreasuryMapping[]
  vouchers    AccountingVoucher[]     @relation("VoucherTreasury")
  transfersIn AccountingVoucher[]     @relation("VoucherTargetTreasury")
  lines       AccountingVoucherLine[]
  instruments Instrument[]

  @@unique([hotelId, code])
  @@index([hotelId, kind, isActive, name])
}

/// Kasa / banka hareketi: + giriş, − çıkış (hesabın para biriminde). Kaynağı tekil; düzeltme ters kayıtla.
model TreasuryMovement {
  id                String         @id @default(uuid())
  hotelId           String
  treasuryAccountId String
  date              DateTime       @db.Date
  amount            Decimal        @db.Decimal(14, 2)
  description       String
  reference         String?
  /// Karşı cari (tahsilat / ödeme fişi, etkinlik tahsilatı).
  ledgerAccountId   String?
  /// Dövizli tahsilatın kaynak tutarı ve kuru (hesap para birimi farklıysa).
  originalAmount    Decimal?       @db.Decimal(14, 2)
  originalCurrency  String?
  exchangeRate      Decimal?       @db.Decimal(12, 6)
  sourceType        TreasurySource
  sourceId          String
  sourceKey         String
  voucherId         String?
  instrumentId      String?
  reversalOfId      String?        @unique
  createdBy         String
  createdAt         DateTime       @default(now())

  hotel         Hotel              @relation(fields: [hotelId], references: [id])
  account       TreasuryAccount    @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount?     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  voucher       AccountingVoucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  instrument    Instrument?        @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  reversalOf    TreasuryMovement?  @relation("TreasuryMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal      TreasuryMovement?  @relation("TreasuryMovementReversal")

  @@unique([hotelId, sourceKey])
  // Hesap hareketleri (gün + kayıt anı + kimlik, imleçli) ve devir toplamı.
  @@index([treasuryAccountId, date, createdAt, id])
  @@index([hotelId, sourceType, sourceId])
  @@index([hotelId, date, id])
  @@index([voucherId])
  @@index([instrumentId])
  @@index([ledgerAccountId])
}

/// Yöntem → kasa / banka eşlemesi: ön büro, etkinlik ve restoran tahsilatı hangi hesaba girer (para birimi boş = hepsi).
model TreasuryMapping {
  id                String          @id @default(uuid())
  hotelId           String
  channel           TreasuryChannel
  method            PaymentMethod
  currency          String          @default("")
  treasuryAccountId String
  updatedBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  hotel   Hotel           @relation(fields: [hotelId], references: [id])
  account TreasuryAccount @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)

  @@unique([hotelId, channel, method, currency])
  @@index([treasuryAccountId])
}

/// Fiş: tahsilat, ödeme (eşik üstü dört göz), virman, kasa / banka giriş-çıkış, açılış bakiyesi. İptal ters kayıtla.
model AccountingVoucher {
  id                      String                  @id @default(uuid())
  hotelId                 String
  number                  String
  type                    AccountingVoucherType
  status                  AccountingVoucherStatus @default(POSTED)
  date                    DateTime                @db.Date
  ledgerAccountId         String?
  treasuryAccountId       String?
  targetTreasuryAccountId String?
  amount                  Decimal                 @db.Decimal(14, 2)
  /// Açılış bakiyesinde carinin yönü (DEBIT / CREDIT).
  openingSide             String?
  dueDate                 DateTime?               @db.Date
  description             String
  reference               String?
  /// Çift gönderim anahtarı (otel başına tekil).
  requestId               String
  approvalId              String?
  createdBy               String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  postedAt                DateTime?
  approvedBy              String?
  declinedAt              DateTime?
  voidedAt                DateTime?
  voidedBy                String?
  voidReason              String?

  hotel             Hotel                   @relation(fields: [hotelId], references: [id])
  ledgerAccount     LedgerAccount?          @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  treasuryAccount   TreasuryAccount?        @relation("VoucherTreasury", fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  targetTreasury    TreasuryAccount?        @relation("VoucherTargetTreasury", fields: [targetTreasuryAccountId], references: [id], onDelete: Restrict)
  approval          Approval?               @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  lines             AccountingVoucherLine[]
  ledgerEntries     LedgerEntry[]
  treasuryMovements TreasuryMovement[]
  instruments       Instrument[]

  @@unique([hotelId, number])
  @@unique([hotelId, requestId])
  // Fiş listesi (gün + kimlik), duruma göre, cariye göre.
  @@index([hotelId, date, id])
  @@index([hotelId, status, createdAt])
  @@index([ledgerAccountId, date])
  @@index([approvalId])
}

/// Fişin para satırı: kasa / banka, alınan ya da verilen çek-senet (bilgisi satırda, işlenince kartı açılır), portföyden ciro.
model AccountingVoucherLine {
  id                String          @id @default(uuid())
  hotelId           String
  voucherId         String
  sortOrder         Int
  kind              VoucherLineKind
  amount            Decimal         @db.Decimal(14, 2)
  treasuryAccountId String?
  instrumentId      String?
  instrumentKind    InstrumentKind?
  number            String?
  bankName          String?
  branch            String?
  drawer            String?
  dueDate           DateTime?       @db.Date

  voucher    AccountingVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  treasury   TreasuryAccount?  @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  instrument Instrument?       @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@unique([voucherId, sortOrder])
  @@index([instrumentId])
  @@index([treasuryAccountId])
}

/// Çek / senet: alınan (müşteriden, portföy) ya da verilen (bizim). Durum makinesi ve geçmişi; tutar otelin para biriminde.
model Instrument {
  id                  String              @id @default(uuid())
  hotelId             String
  kind                InstrumentKind
  direction           InstrumentDirection
  status              InstrumentStatus
  number              String
  bankName            String?
  branch              String?
  /// Keşideci / borçlu (alınan çekte müşterinin müşterisi olabilir).
  drawer              String?
  issueDate           DateTime            @db.Date
  dueDate             DateTime            @db.Date
  amount              Decimal             @db.Decimal(14, 2)
  currency            String
  /// Alınan: kimden; verilen: kime.
  ledgerAccountId     String
  /// Ciro edildiği cari (tedarikçi).
  endorsedToAccountId String?
  /// Tahsile verildiği / tahsil edildiği ya da (verilen çekte) ödeneceği kasa / banka.
  treasuryAccountId   String?
  voucherId           String
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  hotel             Hotel                   @relation(fields: [hotelId], references: [id])
  account           LedgerAccount           @relation("InstrumentAccount", fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  endorsedTo        LedgerAccount?          @relation("InstrumentEndorsee", fields: [endorsedToAccountId], references: [id], onDelete: Restrict)
  treasury          TreasuryAccount?        @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  voucher           AccountingVoucher       @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  movements         InstrumentMovement[]
  voucherLines      AccountingVoucherLine[]
  ledgerEntries     LedgerEntry[]
  treasuryMovements TreasuryMovement[]

  // Portföy: duruma göre vade sırası; vade takvimi; carinin çekleri.
  @@index([hotelId, status, dueDate, id])
  @@index([hotelId, dueDate])
  @@index([ledgerAccountId])
  @@index([number(ops: raw("gin_trgm_ops"))], map: "Instrument_number_trgm_idx", type: Gin)
}

/// Çek / senet durum geçmişi: kim, ne zaman, hangi işlemle, hangi hesaba.
model InstrumentMovement {
  id                String            @id @default(uuid())
  hotelId           String
  instrumentId      String
  action            InstrumentAction
  fromStatus        InstrumentStatus?
  toStatus          InstrumentStatus
  date              DateTime          @db.Date
  treasuryAccountId String?
  ledgerAccountId   String?
  voucherId         String?
  note              String?
  createdBy         String
  createdAt         DateTime          @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@index([instrumentId, createdAt])
}

/**
 * ─────────────── Fatura ve e-belge (modül 16 çekirdeği + 49) ───────────────
 */

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCEL_PENDING
  CANCELLED
}

/// Faturanın kaynağı: kapanmış folyo, gerçekleşmiş / iptal bedelli etkinlik, cariye serbest fatura.
enum InvoiceSource {
  FOLIO
  EVENT
  MANUAL
}

/// Kesimde alıcının GİB kaydına göre: kayıtlı mükellef → e-Fatura, değilse e-Arşiv.
enum InvoiceDocumentType {
  E_FATURA
  E_ARSIV
}

enum InvoiceBuyerType {
  PERSON
  COMPANY
  FOREIGN
  /// Yurt dışındaki tüzel kişi (tur operatörü): GİB kimliği 2222222222, e-Arşiv.
  FOREIGN_COMPANY
}

/// e-belgenin entegratör / GİB yolculuğu.
enum EDocumentState {
  QUEUED
  SENDING
  SENT
  DELIVERED
  REJECTED
  FAILED
  CANCELLED
}

/// Test ortamı mükellefinin davranışı (GİB benzetimi).
enum TestTaxpayerBehavior {
  ACCEPT
  REJECT
  NO_MAILBOX
  UNAVAILABLE
}

/// Fatura (modül 16 çekirdeği + 49). Taslak düzenlenir; kesimde numara (seri + yıl + 9 hane), belge türü
/// (e-Fatura / e-Arşiv), alıcı ve UBL belgesi donar — kesilmiş fatura değişmez, iptal onay kuyruğundan.
/// Folyo ve etkinlik başına en fazla bir geçerli (iptal edilmemiş) fatura: kısmi tekil index'ler migration'da.
/// Alıcının bütün bilgisi `buyer`da (JSON); liste ve arama için ad ve vergi no ayrıca.
model Invoice {
  id                String               @id @default(uuid())
  hotelId           String
  source            InvoiceSource
  status            InvoiceStatus        @default(DRAFT)
  /// ETTN (evrensel tekil tanımlama numarası): taslakta verilir, kesimde değişmez.
  uuid              String               @unique @default(uuid())
  number            String?
  documentType      InvoiceDocumentType?
  folioId           String?
  eventId           String?
  ledgerAccountId   String?
  guestId           String?
  currency          String
  exchangeRate      Decimal?             @db.Decimal(12, 6)
  issueDate         DateTime?            @db.Date
  issuedAt          DateTime?
  issuedBy          String?
  /// Hizmet dönemi (yasal 7 günlük süre ve faturadaki dönem notu).
  serviceFrom       DateTime?            @db.Date
  serviceTo         DateTime?            @db.Date
  buyerType         InvoiceBuyerType?
  buyerName         String?
  buyerTaxNumber    String?
  buyer             Json                 @default("{}")
  note              String?
  grossTotal        Decimal              @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal              @default(0) @db.Decimal(14, 2)
  netTotal          Decimal              @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal              @default(0) @db.Decimal(14, 2)
  total             Decimal              @default(0) @db.Decimal(14, 2)
  /// Vergi dökümü (kod × oran: matrah, tutar, muafiyet kodu).
  taxes             Json                 @default("[]")
  edocState         EDocumentState?
  edocProvider      String?
  edocEnvironment   String?
  edocAttempts      Int                  @default(0)
  edocNextAttemptAt DateTime?
  edocLockedAt      DateTime?
  edocSentAt        DateTime?
  edocCompletedAt   DateTime?
  edocCheckedAt     DateTime?
  edocChecks        Int                  @default(0)
  edocProviderRef   String?
  edocStatusCode    String?
  edocMessage       String?
  /// e-Faturada alıcının posta kutusu etiketi (urn:mail:…).
  receiverAlias     String?
  cancelReason      String?
  /// e-Faturada GİB portalındaki iptal / itiraz referansı.
  cancelReference   String?
  cancelRequestedAt DateTime?
  cancelRequestedBy String?
  cancelApprovalId  String?
  cancelledAt       DateTime?
  cancelledBy       String?
  /// LOCAL (GİB'e ulaşmadan), INTEGRATOR (e-Arşiv iptali), PORTAL (e-Fatura, GİB portalında).
  cancelMethod      String?
  createdBy         String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  hotel         Hotel            @relation(fields: [hotelId], references: [id])
  folio         Folio?           @relation(fields: [folioId], references: [id], onDelete: Restrict)
  event         Event?           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount?   @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  guest         Guest?           @relation(fields: [guestId], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]
  document      InvoiceDocument?
  logs          InvoiceLog[]

  @@unique([hotelId, number])
  // Fatura listesi: kesim günü (yeniden eskiye), aynı gün kesim anı.
  @@index([hotelId, issueDate(sort: Desc), issuedAt(sort: Desc), id])
  // Taslaklar ve durum süzgeci.
  @@index([hotelId, status, createdAt])
  // GİB durumu süzgeci.
  @@index([hotelId, edocState, issueDate])
  @@index([hotelId, buyerTaxNumber])
  @@index([folioId])
  @@index([eventId])
  @@index([ledgerAccountId, issueDate])
  // Misafirin önceki faturasından alıcı bilgisi.
  @@index([guestId, issuedAt])
  @@index([buyerName(ops: raw("gin_trgm_ops"))], map: "Invoice_buyerName_trgm_idx", type: Gin)
}

/// Fatura satırı: folyo faturasında gelir grubu, etkinlikte kalem, serbest faturada girilen satır.
/// Eksi satır yoktur (ters kayıt grubun içinde, indirim satır iskontosu).
model InvoiceLine {
  id             String    @id @default(uuid())
  hotelId        String
  invoiceId      String
  sortOrder      Int
  description    String
  quantity       Decimal   @db.Decimal(12, 2)
  unitCode       String
  unitPrice      Decimal   @db.Decimal(14, 2)
  grossAmount    Decimal   @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @db.Decimal(14, 2)
  netAmount      Decimal   @db.Decimal(14, 2)
  taxAmount      Decimal   @db.Decimal(14, 2)
  total          Decimal   @db.Decimal(14, 2)
  taxes          Json      @default("[]")
  serviceFrom    DateTime? @db.Date
  serviceTo      DateTime? @db.Date
  /// Elle girilen satır (serbest fatura, iptal bedeli): vergi kategorisi ve birim tutar (dahil vergiler içinde).
  taxCategory    String?
  unitAmount     Decimal?  @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}

/// Kesimde donan UBL-TR belgesi (gönderim ve tekrar gönderim bunu kullanır).
model InvoiceDocument {
  invoiceId String   @id
  hotelId   String
  xml       String
  sha256    String
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// Faturanın zaman çizelgesi: kesim, sıraya girme, gönderim, GİB cevabı, yeniden deneme, iptal.
model InvoiceLog {
  id        String          @id @default(uuid())
  hotelId   String
  invoiceId String
  kind      String
  state     EDocumentState?
  code      String?
  message   String?
  actor     String
  createdAt DateTime        @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}

/// Fatura ayarları: satıcı (otelin işletmesi), seriler, entegratör ve ortam.
model InvoiceSettings {
  hotelId         String   @id
  legalName       String
  taxNumber       String
  taxOffice       String
  mersisNo        String?
  tradeRegistryNo String?
  street          String
  district        String
  city            String
  postalCode      String?
  country         String   @default("Türkiye")
  phone           String?
  email           String?
  website         String?
  eFaturaPrefix   String
  eArsivPrefix    String
  provider        String   @default("TEST")
  environment     String   @default("TEST")
  senderAlias     String?
  /// Faturalama başlangıcı (otelin takvim günü): öncesinde kapanan folyo / etkinlik önceki sistemde faturalanmış
  /// sayılır, "faturalanacaklar"a girmez.
  startDate       DateTime @db.Date
  /// Folyo kapanınca fatura taslağı açılır (folyo aktörü).
  autoDraft       Boolean  @default(true)
  footerNote      String?
  bankInfo        String?
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Otelin vergi satırı → GİB vergi kodu (KDV 0015, konaklama vergisi 0059).
model InvoiceTaxCode {
  hotelId   String
  taxId     String   @unique
  code      String
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
  tax   Tax   @relation(fields: [taxId], references: [id], onDelete: Cascade)

  @@id([hotelId, taxId])
}

/// Seri × yıl sırası (kesimde satır kilidi altında artar; boşluk bırakmaz).
model InvoiceSequence {
  hotelId String
  prefix  String
  year    Int
  last    Int

  @@id([hotelId, prefix, year])
}

/// Test ortamının "kayıtlı kullanıcı listesi": burada olan vergi no e-Fatura mükellefi sayılır.
model TestTaxpayer {
  id        String               @id @default(uuid())
  hotelId   String
  taxNumber String
  title     String
  alias     String
  behavior  TestTaxpayerBehavior @default(ACCEPT)
  createdBy String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, taxNumber])
}

/// Mükellef sorgusunun önbelleği (entegratör başına; süresi `TAXPAYER_CHECK_TTL_MS`).
model TaxpayerLookup {
  hotelId    String
  provider   String
  taxNumber  String
  registered Boolean
  title      String?
  aliases    String[] @default([])
  checkedAt  DateTime

  @@id([hotelId, provider, taxNumber])
}

// ═══════════════════════════════════════════════════════════════
// Modül 51: Personel ve bordro
// ═══════════════════════════════════════════════════════════════

enum EmployeeStatus {
  ACTIVE
  TERMINATED
}

/// Ücretin anlaşma türü: brüt ya da net (netten anlaşılan ücret her ay brüte çevrilir).
enum PayBasis {
  GROSS
  NET
}

/// Tüm sigorta kolları ya da emekli çalışan (sosyal güvenlik destek primi).
enum InsuranceType {
  NORMAL
  RETIRED
}

enum EmployeePaymentMethod {
  BANK
  CASH
}

enum PayrollRunKind {
  MONTHLY
  SUPPLEMENTARY
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  PENDING_APPROVAL
  APPROVED
}

enum PayElementKind {
  EARNING
  DEDUCTION
}

enum PayElementExemption {
  NONE
  MEAL
  TRANSPORT
}

enum PayrollItemSource {
  MANUAL
  SERVICE_CHARGE
  TERMINATION
}

enum IncentiveMethod {
  TREASURY_POINTS
  MIN_WAGE_EMPLOYER_SHARE
  FIXED_AMOUNT
}

enum GarnishmentType {
  ICRA
  NAFAKA
}

enum GarnishmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AdvanceStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum NoticeMode {
  NONE
  EMPLOYER_PAYS
  EMPLOYEE_PAYS
}

enum ServiceChargeMethod {
  POINTS
  EQUAL
}

enum ServiceChargeStatus {
  DRAFT
  DISTRIBUTED
}

enum PayrollLineKind {
  EARNING
  DEDUCTION
}

model Department {
  id        String   @id @default(uuid())
  hotelId   String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel     Hotel      @relation(fields: [hotelId], references: [id])
  employees Employee[]

  @@unique([hotelId, code])
}

/// Personel kartı. Kullanıcı hesabından ayrı; isteyen bir hesaba bağlanır. Aynı kişinin aynı otelde tek aktif kaydı
/// olur (kısmi tekil indeks migration'da); yeniden işe giriş yeni kayıttır (kıdem yeniden başlar).
model Employee {
  id                  String                @id @default(uuid())
  hotelId             String
  /// Sicil no (otel içinde tekil): "P-0001".
  code                String
  firstName           String
  lastName            String
  nationality         String                @default("TR")
  nationalId          String
  birthDate           DateTime?             @db.Date
  phone               String?
  email               String?
  address             String?
  departmentId        String
  position            String
  hireDate            DateTime              @db.Date
  terminationDate     DateTime?             @db.Date
  status              EmployeeStatus        @default(ACTIVE)
  payBasis            PayBasis              @default(GROSS)
  /// Aylık ücret (brüt ya da net, `payBasis`).
  salary              Decimal               @default(0) @db.Decimal(14, 2)
  insuranceType       InsuranceType         @default(NORMAL)
  disabilityDegree    Int?
  paymentMethod       EmployeePaymentMethod @default(BANK)
  iban                String?
  besEnrolled         Boolean               @default(false)
  /// Boşsa parametre setindeki oran.
  besRate             Decimal?              @db.Decimal(6, 5)
  besOptOutOn         DateTime?             @db.Date
  serviceChargePoints Decimal               @default(0) @db.Decimal(8, 2)
  userId              String?               @unique
  notes               String?
  createdBy           String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  hotel         Hotel                @relation(fields: [hotelId], references: [id])
  department    Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  ledgerAccount LedgerAccount?
  incentives    EmployeeIncentive[]
  advances      EmployeeAdvance[]
  garnishments  Garnishment[]
  attendances   PayrollAttendance[]
  items         PayrollItem[]
  termination   EmployeeTermination?
  entries       PayrollEntry[]
  openings      PayrollOpening[]

  @@unique([hotelId, code])
  @@index([hotelId, status, lastName, firstName])
  @@index([hotelId, departmentId, status])
  @@index([hotelId, nationalId])
  // Ayın bordrosuna girenler: işe giriş ≤ ay sonu ve (çıkış yok ya da ≥ ay başı).
  @@index([hotelId, hireDate, terminationDate])
  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "Employee_firstName_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "Employee_lastName_trgm_idx", type: Gin)
}

/// Çalışan bazında teşvik (SGK işveren payından düşüm). Teşvikli ayda Hazine indirimi ayrıca uygulanmaz.
model EmployeeIncentive {
  id         String          @id @default(uuid())
  hotelId    String
  employeeId String
  code       String
  label      String
  method     IncentiveMethod
  points     Decimal?        @db.Decimal(5, 2)
  amount     Decimal?        @db.Decimal(14, 2)
  validFrom  DateTime        @db.Date
  validTo    DateTime?       @db.Date
  createdBy  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, validFrom])
  @@index([hotelId, validFrom])
}

/// Maaş avansı: ödendiği gün (kasadan / bankadan) personel carisine borç; bordrolarda taksitle mahsup edilir.
model EmployeeAdvance {
  id                String        @id @default(uuid())
  hotelId           String
  employeeId        String
  amount            Decimal       @db.Decimal(14, 2)
  installments      Int
  installmentAmount Decimal       @db.Decimal(14, 2)
  firstYear         Int
  firstMonth        Int
  paidOn            DateTime      @db.Date
  treasuryAccountId String?
  /// Onaylı bordrolarda mahsup edilen toplam.
  deducted          Decimal       @default(0) @db.Decimal(14, 2)
  status            AdvanceStatus @default(OPEN)
  note              String?
  createdBy         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([hotelId, employeeId, status])
  @@index([hotelId, status])
}

/// İcra ya da nafaka kesintisi. İcra dosyaları bildirim sırasıyla kesilir (aynı anda yalnız ilki); nafaka önce gelir.
model Garnishment {
  id              String            @id @default(uuid())
  hotelId         String
  employeeId      String
  type            GarnishmentType
  fileNumber      String
  authority       String
  creditor        String
  notifiedOn      DateTime          @db.Date
  totalAmount     Decimal?          @db.Decimal(14, 2)
  monthlyAmount   Decimal?          @db.Decimal(14, 2)
  rate            Decimal?          @db.Decimal(6, 5)
  /// Onaylı bordrolarda kesilen toplam.
  deducted        Decimal           @default(0) @db.Decimal(14, 2)
  status          GarnishmentStatus @default(ACTIVE)
  /// Kesintinin aktarılacağı cari (icra dairesi / nafaka alacaklısı).
  ledgerAccountId String?
  note            String?
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([hotelId, employeeId, status, notifiedOn])
}

/// İşyeri ve muhasebe bağları (otel başına bir satır).
model PayrollSettings {
  hotelId            String   @id
  workplaceName      String?
  sgkWorkplaceNo     String?
  taxOffice          String?
  taxNumber          String?
  /// İşyerinin sektörü: Hazine indirimi puanı (imalat dışı / imalat).
  sector             String   @default("GENERAL")
  /// 5510 sayılı Kanun Hazine indirimi uygulanır mı (teşviksiz çalışanlara).
  treasuryDiscount   Boolean  @default(true)
  sgkLedgerAccountId String?
  taxLedgerAccountId String?
  besLedgerAccountId String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Yürürlük tarihli yasal parametre seti. Ay, ayın son günü yürürlükte olan setle hesaplanır.
model PayrollParameterSet {
  id         String    @id @default(uuid())
  hotelId    String
  validFrom  DateTime  @db.Date
  label      String
  values     Json
  sources    Json      @default("[]")
  /// FlexAI kataloğundan geldiyse anahtarı ("2026-01").
  catalogKey String?
  /// Bir yetkili resmî metinle teyit etti mi; teyitsiz setle hesaplanan bordro onaya gidemez.
  verifiedBy String?
  verifiedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, validFrom])
}

/// Ödeme / kesinti kalemi. Sistem kalemleri kanunun davranışıyla gelir ve değişmez; otel kendi kalemini ekler.
model PayElement {
  id        String              @id @default(uuid())
  hotelId   String
  code      String
  name      String
  kind      PayElementKind
  system    Boolean             @default(false)
  sgk       Boolean
  gv        Boolean
  dv        Boolean
  exemption PayElementExemption @default(NONE)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  hotel Hotel         @relation(fields: [hotelId], references: [id])
  items PayrollItem[]

  @@unique([hotelId, code])
}

/// Aylık puantaj: eksik gün (SGK nedeni), fazla çalışma, bayram ve hafta tatili çalışması. Modül 52 gelince
/// puantajdan dolar (source TIMESHEET).
model PayrollAttendance {
  id             String   @id @default(uuid())
  hotelId        String
  employeeId     String
  year           Int
  month          Int
  missingDays    Int      @default(0)
  missingReason  String?
  /// Fiilen çalışılan gün (yemek / yol istisnası); boşsa ücretli gün.
  workedDays     Int?
  overtimeHours  Decimal  @default(0) @db.Decimal(6, 2)
  holidayDays    Decimal  @default(0) @db.Decimal(4, 1)
  weeklyRestDays Decimal  @default(0) @db.Decimal(4, 1)
  source         String   @default("MANUAL")
  note           String?
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
  @@index([hotelId, year, month])
}

/// Bir aya girilen ek ödeme / kesinti. `runId` boşsa ayın aylık bordrosuna, doluysa o fark bordrosuna aittir.
model PayrollItem {
  id         String            @id @default(uuid())
  hotelId    String
  employeeId String
  year       Int
  month      Int
  elementId  String
  amount     Decimal           @db.Decimal(14, 2)
  isNet      Boolean           @default(false)
  source     PayrollItemSource @default(MANUAL)
  sourceId   String?
  runId      String?
  note       String?
  createdBy  String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  element  PayElement @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@index([hotelId, year, month, employeeId])
  @@index([hotelId, source, sourceId])
  @@index([runId])
}

/// İşten çıkış ve hesaplanan hakları (kıdem, ihbar, kullanılmayan izin). Tutarlar çıkış ayının kalemlerine yazılır.
model EmployeeTermination {
  id                String     @id @default(uuid())
  hotelId           String
  employeeId        String     @unique
  terminationDate   DateTime   @db.Date
  reasonCode        String
  severanceEligible Boolean
  noticeMode        NoticeMode
  noticeWeeks       Int
  unusedLeaveDays   Decimal    @default(0) @db.Decimal(5, 1)
  severanceBase     Decimal    @db.Decimal(14, 2)
  severanceCeiling  Decimal    @db.Decimal(14, 2)
  serviceYears      Int
  serviceMonths     Int
  serviceDays       Int
  severanceAmount   Decimal    @default(0) @db.Decimal(14, 2)
  noticeAmount      Decimal    @default(0) @db.Decimal(14, 2)
  leaveAmount       Decimal    @default(0) @db.Decimal(14, 2)
  overrideReason    String?
  createdBy         String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([hotelId, terminationDate])
}

/// Bordro (ay × tür). Aylık bordro ayda bir tanedir (sequence 1); fark bordroları sırayla numaralanır.
model PayrollRun {
  id                        String           @id @default(uuid())
  hotelId                   String
  year                      Int
  month                     Int
  kind                      PayrollRunKind
  sequence                  Int
  /// "B-2026-01" / "B-2026-01-F1"
  number                    String
  status                    PayrollRunStatus @default(DRAFT)
  parameterSetId            String?
  /// Girdisi (puantaj, kalem, kart) hesaplamadan sonra değişti: yeniden hesaplanmadan onaya gidemez.
  stale                     Boolean          @default(false)
  employeeCount             Int              @default(0)
  grossTotal                Decimal          @default(0) @db.Decimal(16, 2)
  netTotal                  Decimal          @default(0) @db.Decimal(16, 2)
  deductionTotal            Decimal          @default(0) @db.Decimal(16, 2)
  payableTotal              Decimal          @default(0) @db.Decimal(16, 2)
  employeeSgkTotal          Decimal          @default(0) @db.Decimal(16, 2)
  employeeUnemploymentTotal Decimal          @default(0) @db.Decimal(16, 2)
  employerSgkTotal          Decimal          @default(0) @db.Decimal(16, 2)
  employerUnemploymentTotal Decimal          @default(0) @db.Decimal(16, 2)
  discountTotal             Decimal          @default(0) @db.Decimal(16, 2)
  gvTotal                   Decimal          @default(0) @db.Decimal(16, 2)
  dvTotal                   Decimal          @default(0) @db.Decimal(16, 2)
  costTotal                 Decimal          @default(0) @db.Decimal(16, 2)
  paidTotal                 Decimal          @default(0) @db.Decimal(16, 2)
  calculatedAt              DateTime?
  calculatedBy              String?
  submittedAt               DateTime?
  submittedBy               String?
  approvalId                String?          @unique
  approvedAt                DateTime?
  approvedBy                String?
  note                      String?
  createdBy                 String
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  hotel    Hotel            @relation(fields: [hotelId], references: [id])
  entries  PayrollEntry[]
  payments PayrollPayment[]

  @@unique([hotelId, year, month, kind, sequence])
  @@unique([hotelId, number])
  @@index([hotelId, year, month])
  @@index([hotelId, status])
}

/// Bir çalışanın bir bordrodaki sonucu (fark bordrosunda tutarlar fark, eksi olabilir) ve hesap izi.
model PayrollEntry {
  id                   String                @id @default(uuid())
  hotelId              String
  runId                String
  employeeId           String
  departmentId         String
  employeeName         String
  payBasis             PayBasis
  insuranceType        InsuranceType
  sgkDays              Int
  workedDays           Int
  missingDays          Int                   @default(0)
  missingReason        String?
  gross                Decimal               @db.Decimal(14, 2)
  sgkSubject           Decimal               @db.Decimal(14, 2)
  pek                  Decimal               @db.Decimal(14, 2)
  employeeSgk          Decimal               @db.Decimal(14, 2)
  employeeUnemployment Decimal               @db.Decimal(14, 2)
  gvBase               Decimal               @db.Decimal(14, 2)
  gvBefore             Decimal               @db.Decimal(16, 2)
  gvComputed           Decimal               @db.Decimal(14, 2)
  minWageGvExemption   Decimal               @db.Decimal(14, 2)
  gvPayable            Decimal               @db.Decimal(14, 2)
  dvComputed           Decimal               @db.Decimal(14, 2)
  minWageDvExemption   Decimal               @db.Decimal(14, 2)
  dvPayable            Decimal               @db.Decimal(14, 2)
  minWageBase          Decimal               @db.Decimal(14, 2)
  minWageBefore        Decimal               @db.Decimal(16, 2)
  net                  Decimal               @db.Decimal(14, 2)
  deductionTotal       Decimal               @db.Decimal(14, 2)
  payable              Decimal               @db.Decimal(14, 2)
  employerSgk          Decimal               @db.Decimal(14, 2)
  employerUnemployment Decimal               @db.Decimal(14, 2)
  treasuryDiscount     Decimal               @db.Decimal(14, 2)
  incentiveDiscount    Decimal               @db.Decimal(14, 2)
  employerCost         Decimal               @db.Decimal(14, 2)
  incentiveCode        String?
  paymentMethod        EmployeePaymentMethod
  iban                 String?
  paymentId            String?
  paidAt               DateTime?
  trace                Json                  @default("{}")
  createdAt            DateTime              @default(now())

  run      PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines    PayrollLine[]

  @@unique([runId, employeeId])
  @@index([hotelId, employeeId])
  @@index([runId, departmentId])
  @@index([runId, paymentId])
}

model PayrollLine {
  id        String          @id @default(uuid())
  hotelId   String
  entryId   String
  kind      PayrollLineKind
  code      String
  label     String
  amount    Decimal         @db.Decimal(14, 2)
  quantity  String?
  isNet     Boolean         @default(false)
  /// Kesintinin kaynağı (avans / icra kaydı) ya da kalem kaydı.
  refId     String?
  sortOrder Int

  entry PayrollEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@index([hotelId, refId])
}

/// Maaş ödemesi (bir bordronun seçili satırları, tek hesaptan tek günde).
model PayrollPayment {
  id                String                @id @default(uuid())
  hotelId           String
  runId             String
  date              DateTime              @db.Date
  method            EmployeePaymentMethod
  treasuryAccountId String
  amount            Decimal               @db.Decimal(16, 2)
  count             Int
  createdBy         String
  createdAt         DateTime              @default(now())

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId])
}

/// Servis payı havuzu (ay başına bir): puan ya da eşit payla dağıtılıp ayın kalemlerine yazılır.
model ServiceChargePool {
  id            String              @id @default(uuid())
  hotelId       String
  year          Int
  month         Int
  amount        Decimal             @db.Decimal(14, 2)
  method        ServiceChargeMethod
  daysWeighted  Boolean             @default(true)
  departmentIds String[]            @default([])
  status        ServiceChargeStatus @default(DRAFT)
  distributedAt DateTime?
  note          String?
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([hotelId, year, month])
}

/// Yıl içinde bu işverende birikmiş matrahlar (sisteme yıl ortasında geçişte devir).
model PayrollOpening {
  id                String   @id @default(uuid())
  hotelId           String
  employeeId        String
  year              Int
  gvCumulative      Decimal  @db.Decimal(16, 2)
  minWageCumulative Decimal  @db.Decimal(16, 2)
  note              String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@index([hotelId, year])
}

model PayrollSequence {
  hotelId String
  kind    String
  last    Int    @default(0)

  @@id([hotelId, kind])
}

/**
 * ══════════════════ Temassız uygulamalar (modül 53) ══════════════════
 */

/// Misafir portalı ayarı (otel başına bir satır; yoksa varsayılanlar).
model GuestPortalSettings {
  hotelId               String   @id
  enabled               Boolean  @default(true)
  /// Girişten kaç gün önce otomatik davet (0: yalnız elle).
  inviteDaysBefore      Int      @default(3)
  /// Online check-in girişten kaç gün önce açılır.
  checkinOpenDays       Int      @default(7)
  /// Belge fotoğrafları çıkıştan (gelmeyen / iptalde giriş gününden) kaç gün sonra silinir (KVKK).
  documentRetentionDays Int      @default(7)
  /// Davet bağlantısının tabanı ("https://hotel.flexai.tr"); boşsa otomatik davet gönderilmez.
  publicBaseUrl         String?
  /// Misafire gösterilen metinler: { tr: { welcome, houseRules, privacyNotice }, en: …, de: …, ru: … }.
  texts                 Json     @default("{}")
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

/// Misafir portalı bağlantısı: rezervasyona bağlı, imzalı (`/misafir/p/<kimlik>.<imza>`). Rezervasyonda tek geçerli
/// bağlantı (kısmi tekil index); yenilemek eskisini öldürür.
model GuestPortalLink {
  id            String    @id @default(uuid())
  hotelId       String
  reservationId String
  /// İmzaya giren rastgele değer: veritabanı sızsa da bağlantı imza anahtarı olmadan üretilemez.
  nonce         String
  createdBy     String
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedBy     String?
  lastUsedAt    DateTime?
  /// Son davetin gönderildiği an (otomatik ya da elle).
  invitedAt     DateTime?

  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([hotelId, reservationId])
}

enum OnlineCheckinStatus {
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

/// Online check-in (rezervasyon başına bir kayıt; misafir düzeltip yeniden gönderir). Kimlik bilgileri girişte
/// personelin penceresini doldurur; belge fotoğrafları ayrı tabloda ve diskte, saklama süresi sonunda silinir.
model OnlineCheckin {
  id                String              @id @default(uuid())
  hotelId           String
  reservationId     String              @unique
  status            OnlineCheckinStatus
  /// Rezervasyonun giriş günü (liste sırası ve süzgeci; rezervasyon tarihi değişince `reservation.updated` ile eşitlenir).
  arrivalDate       DateTime            @db.Date
  /// Personel aramasının metni: onay kodu, rezervasyon sahibinin ve refakatçilerin adları (gönderimde yazılır; trigram indeksli).
  searchText        String
  /// Rezervasyon sahibinin kimliği: { firstName, lastName, idType, idNumber, nationality, birthDate }.
  guest             Json
  /// Refakatçiler: [{ firstName, lastName, isChild, idType, idNumber, nationality, birthDate }].
  companions        Json                @default("[]")
  vehiclePlate      String?
  /// Tahmini varış saati ("SS:DD").
  arrivalTime       String?
  paymentPreference String
  note              String?
  language          String
  /// Onaylar ve anları: { privacyAt, rulesAt, documentPhotosAt, marketing }.
  consents          Json
  /// İmza (PNG) disk anahtarı.
  signatureKey      String
  submittedAt       DateTime
  submitCount       Int                 @default(1)
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectReason      String?
  completedAt       DateTime?
  documentsPurgedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  hotel       Hotel                   @relation(fields: [hotelId], references: [id])
  reservation Reservation             @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  documents   OnlineCheckinDocument[]

  @@index([hotelId, arrivalDate, submittedAt, id])
  @@index([hotelId, status, arrivalDate, submittedAt, id])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "OnlineCheckin_searchText_trgm_idx", type: Gin)
}

/// Belge fotoğrafı (disk: `online-checkin/<otel>/<kimlik>.jpg` + önizleme). Yüklenince gönderime bağlanmamış
/// (`onlineCheckinId` boş) bekler; bağlanmayan 48 saat sonra, bağlanan saklama süresi sonunda silinir.
model OnlineCheckinDocument {
  id              String    @id @default(uuid())
  hotelId         String
  reservationId   String
  onlineCheckinId String?
  /// 0: rezervasyon sahibi, 1…: refakatçi sırası (gönderimde yazılır).
  person          Int?
  contentType     String
  sizeBytes       Int
  thumbBytes      Int
  createdAt       DateTime  @default(now())
  purgedAt        DateTime?

  hotel         Hotel          @relation(fields: [hotelId], references: [id])
  reservation   Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  onlineCheckin OnlineCheckin? @relation(fields: [onlineCheckinId], references: [id], onDelete: Restrict)

  @@index([hotelId, reservationId])
  @@index([onlineCheckinId])
  @@index([createdAt])
}
